#!/usr/bin/env bash
#
# ─────────────────────────────────────────────────────────────────────────────
#
#   ob-sync — Obsidian Git Sync for Termux, Linux & macOS
#
# ─────────────────────────────────────────────────────────────────────────────
#
#   Version   : 9.6.0
#   Author    : Soroush Chegini
#   License   : MIT
#   Repository: https://github.com/CheginiSoroush/obsidian-sync-scripts
#   Platforms : Android (Termux) · Linux · macOS    (Bash 4+ required)
#   Depends on: git, tar, coreutils/findutils (du, sort, cut, tr, wc, ...),
#               find, grep, and ONE hashing tool (sha256sum OR shasum)
#
#   WHAT IS THIS?
#       Keeps an Obsidian vault version-controlled against a Git remote
#       (e.g. GitHub) from the terminal — phone or desktop. Built for the
#       hostile conditions of Android shared storage (no exec bits, flaky
#       mobile networks, sudden process kills) and equally at home on a
#       Linux box or a Mac.
#
#   DESIGN PRINCIPLES
#       · Atomic writes     — no half-finished files, ever
#       · Verified backups  — every archive is checksummed and test-read
#       · Temp hygiene      — every runtime temporary is registered and
#                             swept on ANY exit path, interruption included
#       · PID locking       — concurrent runs are impossible; the lock is
#                             released between menu operations
#       · Self-healing      — interrupted rebases/merges recover automatically
#       · Additive repair   — local files always win over remote state
#       · Fail-closed I/O   — restore audits archive members (tar-slip safe)
#       · One core          — platform differences live behind portability
#                             helpers, never in forks of this script
#       · Graceful failure  — errors report and return; nothing exits silently
#
#   RELEASE NOTES — 9.6.0 (the tool updates itself)
#       · ob-sync now refreshes ITSELF: on an interactive launch the
#         installed file is checked against the latest GitHub release
#         BEFORE anything else runs; a newer release is downloaded,
#         validated (shebang + bash -n + embedded VERSION) and swapped
#         in with one atomic same-filesystem mv, then the run restarts
#         on the new code. Even a kill mid-update leaves either the old
#         or the new tool — never a broken one.
#       · offline is a normal state, not an error: when the network is
#         unreachable the tool says so in two languages (اینترنت
#         خاموشه — network unreachable) and the run continues on the
#         current version. No GitHub API is used, so there is no rate
#         limit to hit — the release asset itself is the source of truth.
#       · a copy inside a git checkout is NEVER overwritten (that would
#         dirty the tree) — it gets an advisory naming the new version;
#         non-writable install locations print the exact manual command.
#       · automation stays silent and offline by design: the check runs
#         only on an interactive TTY (or via the new `update` command);
#         cron jobs and --json documents are never touched. The test
#         suites export OB_NO_SELFUPDATE=1, and section 42 covers the
#         feature hermetically through file:// URLs — zero network.
#
#   RELEASE NOTES — 9.5.2 (vaults on mounted drives are visible now)
#       · discovery probes the standard mountpoints too — /media (also
#         its per-user and VirtualBox sf_ subfolders), /run/media/<user>
#         and /mnt — with a bounded depth, so a vault on a second disk
#         or shared folder (e.g. /media/<user>/shared/Obsidian/<vault>)
#         shows up in the switcher without any configuration.
#       · menu 19 no longer dead-ends with a single vault: it offers to
#         type a full vault path (empty = keep), and the discovery roots
#         can be overridden wholesale with OB_DISCOVER_ROOTS.
#       · typed paths are validated honestly: a nonexistent directory is
#         named and refused, a directory without .obsidian asks for
#         confirmation, a non-git vault warns before the session moves.
#       · docs: every stale version string (READMEs EN/FA/ES, menu mock)
#         synced to 9.5.2.
#
#   RELEASE NOTES — 9.5.1 (the tool survives the user)
#       · new tests/user-error-tests.sh (56 checks) attacks ob-sync the
#         way real users do: hand-edited configs, CRLF endings, quoted
#         values, wrong paths, double launches. Contract: never lose
#         data, never borrow another vault's remote, always fail honest.
#       · config/identity-card values are parsed clean: a \r from a
#         Windows/Android editor no longer corrupts the remote URL (a
#         CR-stuck origin self-heals from the card); quotes and outer
#         padding no longer become part of the value.
#       · a config path pointing at a directory (mkdir typo) is treated
#         as absent instead of spewing "Is a directory" bash noise.
#       · a vault whose .git is gone gets an honest "No git repository
#         found in: …" pointing at repair/init, not a misleading
#         "Repository is not in a safe state".
#
#   RELEASE NOTES — 9.5.0 (the vault carries its own identity card)
#       · <vault>/.ob-sync/config stores the vault's own REMOTE and
#         BRANCH as a normal tracked file: it travels with the vault,
#         so a second device runs init -y + sync without a single
#         remote question.
#       · self-healing origin: every locked operation re-aligns origin
#         with the card — a lost remote heals itself and can never
#         heal toward another vault's repository.
#       · legacy vaults silently gain a card from their own origin on
#         the first locked run; nothing is asked, nothing changes hands.
#
#   RELEASE NOTES — 9.4.2 (the config remote stops crossing vault lines)
#       · every session is bound to its resolved vault: the machine-wide
#         config REMOTE is trusted only for the pinned vault. repair can
#         no longer clone another vault's repository into the picked
#         vault, and quick can no longer push the picked vault's notes
#         into a foreign repo.
#       · the vault's own origin now outranks the config REMOTE in
#         remote_url() — push and repair finally target the same repo.
#       · menu 19 warns when the picked vault has no remote.
#
#   RELEASE NOTES — 9.4.1 (visible credentials & honest git errors)
#       · credential prompts and git errors print verbatim instead of
#         being swallowed by redirects; an HTTPS stall guard stops
#         indefinite hangs; the credential store file is created 0600.
#
#   RELEASE NOTES — 9.4.0 (a menu that follows your vaults)
#       · menu 19) Switch: session vault switcher — the vault picker
#         opens the menu when several vaults are known and can be
#         re-opened at any time; the prompt now reads [0-19]. The
#         choice is session-only: cron and scripts keep the pinned vault.
#       · init bootstraps git's store credential helper for HTTPS
#         remotes (with explicit consent) — the token is typed once.
#
#   RELEASE NOTES — 9.3.0 (repair that tells the truth + menu-init)
#       · menu gains 18) Init: first-time setup is no longer CLI-only —
#         pick a vault (or keep the current one), enter the new remote
#         URL, and ob-sync either links the existing vault to it (git
#         init + additive history alignment) or clones a fresh one.
#       · repair no longer fails silently on hostile shared storage:
#         the install swap captures the OS error and prints it ("mv
#         said: …") instead of swallowing it behind 2>/dev/null. A
#         .git that died as a truncated FILE or stale symlink (both
#         seen on Android FUSE after interrupted I/O) no longer blocks
#         the swap — it is parked in the rollback holder with a
#         warning, exactly like a corrupt directory. And if the final
#         rename is refused by the mount, the install falls back to a
#         copy-based one (mkdir + cp + HEAD verified) before giving
#         up; the rollback and the pre-repair backup still cover every
#         path. The staging-failure path reports the cp error too.
#
#   RELEASE NOTES — 9.2.3 (closure audit: honest failures, no dead waits)
#       · restore rejects extra positional arguments (fail-closed, same
#         contract as backup/verify) — a typo can no longer silently
#         ride along a destructive restore; the interactive pick parses
#         its number in base 10 ("010" no longer selected #8).
#       · listing timeouts are labeled truthfully again: tar_listing_cache
#         collapsed the watchdog's rc 124 into "corrupt", which made
#         9.2.2's extraction_timeout mapping dead code. The human
#         preview, the JSON preview and the apply gate all report
#         extraction_timeout now.
#       · doctor: ONE ls-remote (--symref) answers reachability, empty-
#         repository detection and the default branch — an unreachable
#         remote no longer burns the network watchdog three times
#         (about 3 × OBS_GIT_TIMEOUT of dead waiting).
#       · history: a corrupted object store now fails loudly
#         (history_unreadable, rc 1) in human and JSON mode instead of
#         silently reporting an empty history.
#       · log / log --json no longer create or rotate the activity log
#         before reading it: a fresh machine gets the documented
#         log_file:null / count:0 document (not ob-sync's own "invoked"
#         row), and a >1MiB log answers with its real last-n entries
#         instead of one junk row.
#       · cron install refuses a schedule containing newline, % or
#         backslash (cronie truncates a line at the first unescaped %;
#         a newline would install a rogue second job) and refuses
#         backslashes in the executable/log paths (a backslash before
#         the escaped % would defeat the escaping).
#       · completions: a multi-line command list broke the space-
#         delimited match for "organize" and "menu" — global flags are
#         no longer offered after them (the parser rejects them there).
#
#   RELEASE NOTES — 9.2.2 (line-by-line audit: 15 fixes, 292 tests)
#       · The 120s network watchdog yields while a human is attached to
#         a terminal — git HTTPS credential prompts (a GitHub PAT on
#         Termux) can no longer be killed mid-typing; unattended runs
#         keep the strict watchdog. Failed https fetch/push prints
#         actionable PAT/SSH guidance (cred_hint).
#       · Foreign GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE environment is
#         neutralized at startup; json_escape maps every C0 control
#         byte; temp_register keeps all its arguments; config_set
#         refuses newline values; the PID lock is published atomically
#         (mktemp+mv) with a startup-race guard.
#       · sync/pull adopt an unborn HEAD from a populated remote instead
#         of reporting "up to date" forever; rebase-apply backend
#         conflicts are detected and cleaned; organize's orphan scan
#         falls back to byte-exact matching for non-ASCII names (no
#         more false orphans for Persian filenames); cron install
#         escapes % for cronie and refuses newline paths; log --json
#         null contracts; history --json author attribution.
#
#   RELEASE NOTES — 9.2.1 (preview throughput & a lost scan restored)
#       · organize regression fix: the 9.2.0 refactor that extracted
#         organize_scan() for the JSON document accidentally dropped
#         the empty-notes pass — every audit since 9.2.0 answered
#         "No empty notes" regardless of the vault. The scan is back,
#         byte-for-byte the pre-9.2.0 criteria (markdown files under
#         10 bytes, .git/.obsidian/.trash excluded), feeding both the
#         human report and the empty_notes[] array.
#       · restore previews no longer decompress the same archive six
#         times: the integrity gate, the tar-slip audit and the member
#         statistics now share one cached pair of listings (names +
#         types), so `restore --list` / `--dry-run` / the JSON preview
#         read the stream exactly twice (phone battery says thanks).
#         The listing reads also run under OBS_LOCAL_TIMEOUT now, the
#         same policy `verify` already had.
#       · restore --list no longer claims "Checksum sidecar valid"
#         when the archive has NO sidecar — the stream check is all
#         that ran, and the line now says so.
#       · organize's orphan scan folds its references into an
#         associative array (one grep total) instead of one grep
#         process per attachment; same case-insensitive name match.
#       · dispatch lock-routing fix: `restore -- --list` (a target
#         literally named "--list" after the "--" separator) was
#         misrouted to the lock-free preview and bypassed the PID lock;
#         the routing scan now stops at "--" (same for organize --fix).
#         organize also rejects leftover positional args after "--"
#         instead of silently running a scan.
#       · fsck counting fix: `$(grep -c … || printf '0')` produced a
#         two-line "0\n0" whenever grep matched nothing, tripping a
#         visible "syntax error in expression" on stderr; the counts
#         are now assigned first with a plain fallback.
#       · doctor --json: the default-branch probe leaked a global
#         variable (the human twin declared it local).
#
#   RELEASE NOTES — 9.2.0 (history & organize join the machine surface)
#       · New `history --json [n]`: the vault's commit history becomes a
#         document — commits[{hash,date,author,subject}] with full SHA-1
#         hashes and ISO 8601 strict dates (stable and sortable, unlike
#         the human view's relative "%cr" strings). Read-only, no lock.
#         A fresh repository (no commits yet) is valid empty data
#         (count 0, rc 0); rc 1 + history_unreadable only when the
#         repository itself cannot be read.
#       · New `organize --json` (scan) and `organize --fix --json`
#         (cleanup): the vault audit becomes a document — scan counts,
#         untitled/empty/oversized lists (with exact size_bytes), the
#         orphan list, and in fix mode a moved-files report
#         (moved[{from,to}], skipped[{file,reason}]) so scripted cleanup
#         can verify every file it moved. Scan-only organize is now a
#         pure read and no longer takes the PID lock (same policy as
#         restore --list) — reports work even while a sync holds the
#         lock; organize --fix stays serialized and answers lock
#         contention with a parseable lock_busy document (rc 2).
#       · Both commands fail closed on unknown flags (same contract as
#         log/verify/health) and accept -y as a documented no-op.
#       · `history` newest-commit fix: `git log --pretty=format:` emits
#         no trailing newline, so `while read` treated the final (=
#         newest) commit as an unterminated line and silently dropped it
#         — every release before 9.2.0 showed n-1 commits. The read
#         loops now keep that final line in both human and --json modes.
#
#   RELEASE NOTES — 9.1.0 (scripted restores & log analytics)
#       · New apply-mode `restore --json <target> -y`: a disaster-recovery
#         drill emits ONE stable result document (result, archive{name,
#         path,size_bytes,sidecar,sidecar_ok}, safety_backup,
#         previous_vault, elapsed_seconds, error{code,message}) — a
#         scripted restore can now verify its own outcome instead of
#         scraping terminal text. Requires an explicit target and -y
#         (JSON mode never prompts); every failure point (corrupt
#         archive, checksum mismatch, tar-slip refusal, extraction
#         timeout, swap failure) carries a stable machine code.
#       · New `log --json [n]`: the activity log becomes a document —
#         entries[{timestamp,source,message}] — so automation can tail
#         ob-sync's own history with jq instead of parsing free text.
#         Read-only, no lock. Missing/unreadable log files degrade
#         gracefully (null log_file, rc 0; parseable error rc 1 only
#         when an existing file cannot be read).
#       · Lock-safety fix: `restore --json` in apply mode used to bypass
#         the PID lock (the read-only routing matched the bare --json
#         flag). Destructive restores are serialized again; a contended
#         lock answers with a parseable lock_busy document (rc 2).
#       · Same-second restore fix: consecutive restores aimed mv at the
#         same ".pre-restore-<timestamp>" name — the swap then failed
#         (non-empty target) or silently nested the old vault inside it.
#         The swap now mirrors make_backup's collision suffix loop, and
#         rapid scripted DR drills are deterministic.
#       · OBS_LOG="" now actually disables logging as documented —
#         ${OBS_LOG:-…} treated an empty value as unset and kept writing
#         the default log file.
#
#   RELEASE NOTES — 9.0.0 (every operational command speaks JSON)
#       · New `verify --json`: every stored backup becomes a row in an
#         archives[] array (name, status ok|corrupt, size_bytes, sidecar
#         state) next to total/passed/failed counters — scheduled audits
#         can now alert on the exact corrupt archive instead of scraping
#         terminal text. Read-only, no lock: safe to run mid-sync.
#       · New `health --json`: the deep repository integrity check emits a
#         checks[] row per stage (git, repository, head, object_database,
#         safe_state, remote, identity) plus a statistics block (commits,
#         tracked files, .git size, free space) — monitoring dashboards
#         finally see WHY the repository is unhealthy, not just rc 1.
#       · health false-corruption fix: `git remote remove` can leave a
#         broken null-sha origin/HEAD ref behind (a git symref-deletion
#         quirk); fsck then failed and health misreported a HEALTHY vault
#         as corrupted, recommending a needless full repair. The fsck
#         probe now downgrades that exact case to a precise warning with
#         a surgical fix (git update-ref -d <ref>) — in both human and
#         --json modes — while any real object error still fails hard.
#       · With this release NINE operational commands (status, sync, pull,
#         push, quick, backup, verify, health, doctor — plus the existing
#         restore --list inventory) offer a machine-readable mode with one
#         guarantee: a --json command always emits a parseable document on
#         stdout.

#   RELEASE NOTES — 8.9.0 (machine-readable backups & diagnostics)
#       · New `backup --json`: a manual backup emits ONE stable document
#         (result, backup{name,path,size_bytes,sidecar,sidecar_ok},
#         elapsed_seconds, error{code,message}) — scripted snapshots can
#         now verify their own output instead of scraping terminal text.
#       · New `doctor --json`: every diagnostic (platform, tools, storage,
#         vault, backup dir, filesystem topology, remote reachability,
#         default branch, watchdogs, free space) becomes a row in a
#         machine-readable checks[] array — dashboards and setup scripts
#         parse health instead of guessing from exit codes.
#       · Lock-contention contract fix: `sync|pull|push|quick|backup
#         --json` while another instance holds the lock used to leave
#         stdout EMPTY (rc 2). Every JSON mode now answers with a
#         parseable {"result":"error","error":{"code":"lock_busy"}}
#         document — the guarantee "a JSON command always emits a
#         document" now covers the whole pipeline, environment and lock
#         included.
#       · backup/doctor flags are validated (unknown flags fail closed);
#         `backup -y` stays a documented no-op. `doctor --json` is fully
#         read-only (it no longer creates the backup directory).

#   RELEASE NOTES — 8.8.0 (one JSON contract for every operation)
#       · `pull --json`, `push --json` and `quick --json` join
#         `sync --json`: all four data operations now emit the SAME
#         stable document shape (result, branch, remote, pulled/pushed/
#         committed/conflict counts, backup, elapsed, error{code,message})
#         — one parser covers every automation hook, cron wrapper and CI
#         job. Failures come back as {"result": "error", "error": {code,
#         message}} with rc 1 and the exit-code contract unchanged.
#       · quick reports its verified backup as the operation's backup
#         (backup_skipped=false) instead of hiding it behind the internal
#         pre-sync skip — what scripts see now matches what actually
#         happened on disk.
#       · Shared op_env_guard/op_emit_json internals: the guards moved
#         from dispatch into the command wrappers (sync's 8.7.0 pattern),
#         so a broken environment (missing git/vault) still answers with
#         a parseable document in all four commands.
#
#   RELEASE NOTES — 8.7.0 (machine-readable sync & storage advice)
#       · New `sync --json`: the full sync emits ONE stable JSON document
#         (result, branch, remote, pulled/pushed/committed/conflict counts,
#         backup name, elapsed seconds) and keeps the exit code contract —
#         failures come back as {"result": "error", "error": {code,
#         message}} with rc 1, so cron wrappers and CI can branch on data
#         instead of scraping terminal output.
#       · Progress banners are suppressed (and logged) in every JSON mode:
#         SILENT_UI now covers section/step/success too, so even a failing
#         sync or restore emits pure JSON on stdout while human-readable
#         errors still reach stderr.
#       · doctor inspects storage topology: when the backup directory
#         shares a filesystem with the vault it now warns that one disk
#         failure could destroy both, with the OBS_BACKUP_DIR fix.
#
#   RELEASE NOTES — 8.6.0 (machine-readable everything)
#       · status --json grew three sections: watchdogs (network/local
#         timeouts), cron (daemon availability, scheduled state, the
#         installed job line, log path) and config (file path, presence,
#         vault resolution source) — one document now answers every
#         dashboard question.
#       · New `restore --list --json`: the same verified preview pipeline
#         (stream check, sidecar checksum, tar-slip audit) emitting JSON —
#         backup inventories (name, size, timestamp, mtime, sidecar state)
#         and per-archive previews (members, files, dirs, notes, top-level
#         layout). Failures come back as {"error": ...} objects with rc 1.
#       · zsh completion (completions/_ob-sync) alongside the bash one.
#       · UI suppression (SILENT_UI) extended to restore --json, so vault
#         auto-detection can never pollute the document (regression-tested).
#
#   RELEASE NOTES — 8.5.0 (scheduled syncs & config editing)
#       · New `cron` command: `cron install <schedule> [HH:MM]` writes
#         an idempotent, marker-managed block into the user crontab
#         (presets 15min/30min/hourly/daily or any 5-field expression),
#         pinning the absolute ob-sync path and PATH so cron shells
#         behave exactly like terminals. `cron status`, `cron show`
#         and `cron uninstall -y` round it out; Termux gets a
#         cronie/termux-services hint when the daemon is missing.
#       · New `edit-conf` command: opens the per-machine config in
#         $EDITOR (a commented starter template is created on first
#         use); refuses to launch an editor without a terminal.
#       · Local watchdog: tar archiving/extraction, hashing and git
#         fsck now run under OBS_LOCAL_TIMEOUT (default 600s, 0 = off)
#         so a hung FUSE/NFS mount can no longer freeze a backup,
#         restore or verification forever — and a watchdog trip is
#         reported as such instead of being mislabeled as corruption.
#       · Interactive menu grew Cron (16) and EditConf (17) entries.
#       · README now ships a real terminal capture of the TUI
#         (docs/menu.svg) and a "Scheduled Syncs" automation guide.
#
#   RELEASE NOTES — 8.4.0 (safe restore previews & automation hooks)
#       · CRITICAL fix: `restore <target> -y` in scripts silently did
#         NOTHING and still exited 0 — the -y flag was never parsed, the
#         confirmation read hit EOF on a non-terminal and the cancel path
#         returned success. A scripted restore now actually restores, and
#         a non-interactive restore WITHOUT consent fails closed (rc 1).
#       · `restore --list [target]` previews a backup (checksum, tar-slip
#         audit, member counts, top-level layout) without touching disk;
#         with no target it lists available backups.
#       · `restore --dry-run [target]` rehearses the entire restore
#         pipeline and prints the exact execution plan — zero changes.
#       · `status --json` emits machine-readable status for scripting,
#         cron dashboards and automation (JSON-escaped, stable shape).
#       · Interactive menu grew Diff / Config / Remote entries (13-15).
#       · Bash completion for all commands and flags (completions/).
#       · GitHub Release automation: tag-push workflow that verifies the
#         tag matches VERSION, runs the test suite and publishes the
#         extracted CHANGELOG section as release notes.
#
#   RELEASE NOTES — 8.3.0 (insight commands & in-repo test suite)
#       · New read-only commands: `diff` (pending changes with human
#         labels + diff stat), `history [n]` (recent vault commits with
#         relative dates) and `config` (effective settings and where
#         each value came from — the "why is it syncing THAT vault" tool).
#       · `sync` reports its elapsed time in the final summary.
#       · The repository now ships its own functional test suite
#         (tests/run-tests.sh) wired into CI alongside ShellCheck.
#
#   RELEASE NOTES — 8.2.0 (first-run correctness & bring-your-own remote)
#       · Fresh-repository fix: an unborn HEAD (no commits yet) is a safe
#         state — the very first `ob-sync sync` on a brand-new remote now
#         succeeds instead of demanding an impossible repair.
#       · Bring-your-own remote: the personal default URL is gone. `init`
#         asks for the remote (or accepts OBS_REMOTE), and REMOTE/BRANCH/
#         VAULT persist in the per-machine config for cron shells.
#       · New `remote` command: show or set the URL at any time.
#       · doctor: an empty (but reachable) remote is no longer misreported
#         as unreachable; missing origin is auto-restored when known.
#
#   RELEASE NOTES — 8.0.0 (platform unification)
#       · Single platform-aware core (bin/ob-sync) replaces the separate
#         desktop/mobile forks — one source of truth, zero drift.
#       · Runtime platform detection (Termux / Linux / macOS) drives
#         defaults, doctor checks and first-time setup.
#       · BSD/macOS portability: shasum fallback for sha256sum, portable
#         size helpers, no GNU-only flags (du --exclude, stat -c, xargs -r).
#       · Canonical command name: ob-sync (per-platform names retired).
#
#   TABLE OF CONTENTS
#        1. Guard & strict mode      9. Backup engine
#        2. Configuration           10. Git helpers
#        3. Colors                  11. Repair engine (two-phase)
#        4. Logging                 12. Commands
#        5. UI helpers              13. Interactive menu
#        6. Portability helpers     14. Help & version
#        7. Temp file registry      15. Dispatcher & entry point
#        8. Locking
#
# ─────────────────────────────────────────────────────────────────────────────

# Require bash 4+ (case-modifier expansion, null-delimited reads, etc.).
if (( BASH_VERSINFO[0] < 4 )); then
    echo "ob-sync: bash 4.0 or newer is required (found: ${BASH_VERSION:-unknown})" >&2
    [[ -n "${TERMUX_VERSION:-}" ]] || echo "  On macOS: brew install bash" >&2
    exit 1
fi

# Strict mode. `-e` is deliberately omitted: every failure path is handled
# explicitly so the interactive menu survives errors and the user always
# gets a clean message instead of a silent mid-operation abort.
set -uo pipefail

# Environment hardening: some shells, prompt hooks and CI wrappers export
# GIT_DIR / GIT_WORK_TREE — those silently redirect EVERY `git -C "$VAULT"`
# call at a foreign repository, so the safety checks would police one repo
# while git mutates another. ob-sync always addresses the vault explicitly;
# these variables are never wanted inside a run.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_COMMON_DIR GIT_ALTERNATE_OBJECT_DIRECTORIES 2>/dev/null || :

# ═════════════════════════════════════════════════════════════════════════════
#  2. CONFIGURATION (every value can be overridden via environment)
# ═════════════════════════════════════════════════════════════════════════════

readonly VERSION="9.6.0"

# ── Platform detection ──────────────────────────────────────────────────────
# Termux exports TERMUX_VERSION in every session; desktop shells never do.
# All platform-dependent defaults, checks and hints branch off this flag —
# there is exactly ONE core script and exactly ONE place it branches.
IS_TERMUX=0
[[ -n "${TERMUX_VERSION:-}" ]] && IS_TERMUX=1

# Default vault location per platform: Android shared storage vs. the
# desktop Documents folder. Generic on purpose — this is a public tool.
if (( IS_TERMUX )); then
    DEFAULT_VAULT="$HOME/storage/shared/Documents/Obsidian"
else
    DEFAULT_VAULT="$HOME/Documents/Obsidian"
fi

# Vault and git settings.
VAULT="${OBS_VAULT:-}"          # empty -> resolved at startup (see resolve_vault)
CONFIG_FILE="${OBS_CONFIG:-$HOME/.config/ob-sync/config}"
# REMOTE: environment wins; config file and 'origin' are consulted later
# (see load_config_overrides / remote_url) once the filesystem is known.
# Empty by default — `ob-sync init` prompts and persists the user's own URL.
REMOTE="${OBS_REMOTE:-}"
BRANCH="${OBS_BRANCH:-main}"

# Backup settings.
BACKUP_DIR="${OBS_BACKUP_DIR:-$HOME/obsidian-backups}"
KEEP_BACKUPS="${OBS_KEEP_BACKUPS:-10}"

# Logging (set OBS_LOG="" to disable). Deliberately `${OBS_LOG-…}` — an
# EMPTY value must disable logging as documented; `${OBS_LOG:-…}` would
# silently fall back to the default and keep writing the log.
LOG_FILE="${OBS_LOG-$HOME/ob-sync.log}"

# Network hardening: maximum runtime in seconds for any remote git
# operation. Set OBS_GIT_TIMEOUT=0 to disable the watchdog entirely.
GIT_TIMEOUT="${OBS_GIT_TIMEOUT:-120}"

# Local hardening: maximum runtime in seconds for slow LOCAL operations
# (tar archiving/extraction, hashing, git fsck). These rarely fail — but
# a vault or backup directory stranded on a dead FUSE/NFS mount can hang
# them forever. Set OBS_LOCAL_TIMEOUT=0 to disable.
LOCAL_TIMEOUT="${OBS_LOCAL_TIMEOUT:-600}"

# Network stall guard: abort an HTTPS transfer that has moved less than
# NET_LOW_SPEED bytes/s for NET_LOW_TIME consecutive seconds. A dead
# mobile connection used to hang an interactive run forever (TTY mode
# keeps no overall watchdog because credential prompts must be able to
# block). Set OBS_NET_LOW_SPEED=0 to disable.
NET_LOW_SPEED="${OBS_NET_LOW_SPEED:-512}"
NET_LOW_TIME="${OBS_NET_LOW_TIME:-60}"

# Behaviour switches.
SKIP_BACKUP="${OBS_SKIP_BACKUP:-0}"
ATTACH_DIR="${OBS_ATTACH_DIR:-Attachments}"

# Internal state (mutated by flags, the lock manager and temp registry).
LOCK_DIR="${TMPDIR:-/tmp}/obs-sync.lock"
STATE_FILE="$BACKUP_DIR/.last-sync"
ASSUME_YES=0
SILENT_UI=0
STEP_NUM=0
LOCK_ACQUIRED=0
TEMP_PATHS=()

# Sanitize numeric settings so arithmetic never explodes on bad input.
[[ "$KEEP_BACKUPS" =~ ^[0-9]+$ ]] || KEEP_BACKUPS=10
[[ "$GIT_TIMEOUT"  =~ ^[0-9]+$ ]] || GIT_TIMEOUT=120
[[ "$LOCAL_TIMEOUT" =~ ^[0-9]+$ ]] || LOCAL_TIMEOUT=600
[[ "$NET_LOW_SPEED" =~ ^[0-9]+$ ]] || NET_LOW_SPEED=512
[[ "$NET_LOW_TIME"  =~ ^[0-9]+$ ]] || NET_LOW_TIME=60

# Optional tooling detection (graceful fallbacks for minimal systems).
HAS_TIMEOUT=0; command -v timeout >/dev/null 2>&1 && HAS_TIMEOUT=1
HAS_PGREP=0;   command -v pgrep   >/dev/null 2>&1 && HAS_PGREP=1


# ── Vault resolution ─────────────────────────────────────────────────────
# A vault path exported in ~/.bashrc never reaches cron jobs or non-login
# shells — that trick silently syncs the WRONG vault at 3 a.m. Resolution
# therefore follows a strict precedence, and the persistent config file is
# the product-grade answer for "it must run everywhere, for everyone":
#   1. OBS_VAULT environment  — explicit override (highest precedence)
#   2. config file            — per-machine, written by `ob-sync init`
#   3. auto-detection         — the unique directory holding .obsidian/
#   4. interactive pick       — several candidates, interactive shells only
#   5. platform default       — last resort; doctor reports the source
VAULT_SOURCE="unresolved"

##
# Normalize a raw value read from a KEY=VALUE line. Hand-edited files are
# a fact of life: Windows/Android editors leave CRLF endings behind, users
# copy values wrapped in quotes out of tutorials, and stray outer spaces
# sneak in. One layer of matched wrapping quotes, trailing CRs and outer
# whitespace are stripped — what survives is the value ob-sync actually
# uses (config_set never writes any of these, so nothing legitimate is
# lost). Field-reported 9.5.0: a CRLF-edited identity card corrupted
# 'origin' with an invisible CR and every fetch died on a phantom URL.
##
conf_value_clean() {
    local val="$1"
    val=${val%$'\r'}
    # trim outer whitespace (the standard non-greedy trim idiom)
    val=${val#"${val%%[![:space:]]*}"}
    val=${val%"${val##*[![:space:]]}"}
    if [[ ${#val} -ge 2 ]]; then
        local q=${val:0:1}
        if [[ ( "$q" == '"' || "$q" == "'" ) && "${val: -1}" == "$q" ]]; then
            val=${val:1:${#val}-2}
        fi
    fi
    printf '%s\n' "$val"
}

##
# Read a KEY=VALUE pair from the config file.
# The file must be a REGULAR file — a directory (a mkdir typo) or a FIFO
# would otherwise fail noisily or block on open (read error spam, 9.5.0).
# @param $1 key
# @stdout value when present; @return 1 when file or key is absent
##
config_get() {
    [[ -r "$CONFIG_FILE" && -f "$CONFIG_FILE" ]] || return 1
    local key="$1" line
    while IFS= read -r line; do
        case "$line" in
            ''|'#'*) continue ;;
            "$key="*) conf_value_clean "${line#"$key="}"; return 0 ;;
        esac
    done < "$CONFIG_FILE"
    return 1
}

##
# Persist a KEY=VALUE pair, creating the config directory on first use.
# Replaces an existing key in place; publishes atomically via rename.
##
config_set() {
    local key="$1" value="$2" tmp
    # The config format is strictly one KEY=VALUE per line — a value
    # carrying a newline would inject phantom keys (and truncate later
    # reads). Refuse instead of writing a corrupt file.
    if [[ "$value" == *$'\n'* || "$value" == *$'\r'* ]]; then
        error "config: refusing to store a newline inside '$key'"
        return 1
    fi
    if [[ "$CONFIG_FILE" == */* ]]; then
        mkdir -p "${CONFIG_FILE%/*}" || return 1
    fi
    tmp=$(mktemp) || return 1
    temp_register "$tmp"
    {
        if [[ -r "$CONFIG_FILE" ]]; then
            grep -v "^${key}=" "$CONFIG_FILE" || :
        fi
        printf '%s\n' "$key=$value"
    } > "$tmp"
    mv -f "$tmp" "$CONFIG_FILE"
}

##
# May the machine-wide config REMOTE/BRANCH be consulted for the CURRENT
# session vault?
#
# The config file stores ONE vault's remote (written by `ob-sync init` /
# `ob-sync remote` together with the pinned VAULT). Since 9.4.0 a session
# can also run against a DIFFERENT vault (startup picker, menu 19,
# OBS_VAULT) — letting the config REMOTE leak into such a session pointed
# sync/quick/repair/init at ANOTHER vault's repository: repair swapped in
# a foreign .git, quick pushed foreign notes into it, and the picked
# vault's notes landed in someone else's history. Field-reported 9.4.1.
#
# Trusted only when the session vault IS the pinned vault, or when nothing
# is pinned (single-vault machine — the stored remote necessarily belongs
# to the only vault there is).
# @return 0 trusted, 1 not trusted (config REMOTE/BRANCH must be ignored)
##
config_remote_trusted() {
    local pinned
    pinned=$(config_get VAULT) || :
    [[ -z "$pinned" || "$pinned" == "$VAULT" ]]
}

##
# Apply config-file fallbacks for settings the user did not export.
# Environment always wins; the config file only fills the gaps — and only
# for the vault the config was written FOR (config_remote_trusted): a
# session running another vault must keep REMOTE/BRANCH empty so that
# remote_url()/ensure_origin() resolve that vault's OWN origin or refuse
# with an actionable error, never reach for a foreign repository.
# Runs in setup() (normal commands) and cmd_doctor (which skips setup),
# so cron jobs and non-login shells resolve REMOTE/BRANCH exactly like
# terminals.
##
load_config_overrides() {
    if [[ -z "$REMOTE" ]] && config_remote_trusted; then
        REMOTE=$(config_get REMOTE) || :
    fi
    if [[ -z "${OBS_BRANCH:-}" ]] && config_remote_trusted; then
        local cfg_branch
        cfg_branch=$(config_get BRANCH) || :
        [[ -n "$cfg_branch" ]] && BRANCH="$cfg_branch"
    fi
    return 0
}

##
# Probe common roots for Obsidian vaults (directories containing .obsidian/).
# Shallow on $HOME (Android shared storage keeps deep scans expensive), but
# since 9.5.2 the standard mountpoints are probed too: a vault on a second
# disk or a shared folder (/media/<user>/shared/Obsidian/obsidian) used to
# be invisible. OB_DISCOVER_ROOTS (colon-separated) overrides every default
# root — for sandboxes, tests and exotic layouts.
##
discover_vaults() {
    local -a roots=()
    local root d depth mu="${USER:-$(id -un 2>/dev/null)}"
    local override=0

    if [[ -n "${OB_DISCOVER_ROOTS:-}" ]]; then
        override=1
        while IFS= read -r root; do
            [[ -n "$root" ]] && roots+=("$root")
        done < <(printf '%s\n' "$OB_DISCOVER_ROOTS" | tr ':' '\n')
    elif (( IS_TERMUX )); then
        roots=("$HOME/storage/shared/Documents" "$HOME/storage/shared/Obsidian" "$HOME/storage/shared")
    else
        roots=("$HOME/Documents" "$HOME/Obsidian" "$HOME/vaults")
        # Depth stays bounded so a huge network share cannot stall the
        # picker. One /media scan covers /media/<user>/… and the
        # VirtualBox-style /media/sf_… shares alike.
        [[ -n "$mu" && -d "/run/media/$mu" ]] && roots+=("/run/media/$mu")
        [[ -d "/media" ]] && roots+=("/media")
        [[ -d "/mnt" ]] && roots+=("/mnt")
    fi
    for root in "${roots[@]}"; do
        [[ -d "$root" ]] || continue
        case "$root" in
            /media|/media/*|/mnt|/mnt/*|/run/media/*) depth=5 ;;
            *)
                # explicitly named roots are scanned deeper: the operator
                # pointed ob-sync at them on purpose (tests, sandboxes,
                # nested layouts like …/Obsidian/<vault>/…)
                if (( override )); then depth=5; else depth=2; fi ;;
        esac
        while IFS= read -r -d '' d; do
            printf '%s\n' "${d%/.obsidian}"
        done < <(find "$root" -maxdepth "$depth" -type d -name .obsidian -print0 2>/dev/null)
    done | sort -u
}

##
# Resolve the vault into $VAULT and record the source in $VAULT_SOURCE.
# Never prompts unless several candidates exist AND stdin is a TTY.
# @return 0 on success, 1 when resolution cannot complete
##
resolve_vault() {
    local -a candidates=()
    local cfg c i reply=""

    # 1 — explicit environment override: trust the operator, even if the
    #     directory does not exist yet (a clone may be about to create it).
    if [[ -n "$VAULT" ]]; then
        VAULT_SOURCE="environment"
        [[ -d "$VAULT" ]] || warn "OBS_VAULT does not exist (yet): $VAULT"
        bind_session_remote
        return 0
    fi

    # 2 — persistent per-machine configuration.
    if cfg=$(config_get VAULT) && [[ -n "$cfg" ]]; then
        if [[ -d "$cfg" ]]; then
            VAULT="$cfg"
            VAULT_SOURCE="config file"
            bind_session_remote
            return 0
        fi
        warn "Configured vault no longer exists: $cfg"
    fi

    # 3/4 — auto-detection across the common roots.
    while IFS= read -r c; do
        [[ -n "$c" ]] && candidates+=("$c")
    done < <(discover_vaults)

    if (( ${#candidates[@]} == 1 )); then
        VAULT="${candidates[0]}"
        VAULT_SOURCE="auto-detected"
        info "Auto-detected vault: $VAULT"
        bind_session_remote
        return 0
    fi

    if (( ${#candidates[@]} > 1 )); then
        if [[ -t 0 ]]; then
            warn "Multiple Obsidian vaults found — pick one:"
            i=1
            for c in "${candidates[@]}"; do
                printf '    %s%d)%s %s\n' "$C_CYAN" "$i" "$C_RESET" "$c"
                i=$((i + 1))
            done
            printf '\n'
            read -r -p "  Select vault [1]: " reply || :
            reply="${reply:-1}"
            if [[ "$reply" =~ ^[0-9]+$ ]] && (( reply >= 1 && reply <= ${#candidates[@]} )); then
                VAULT="${candidates[reply - 1]}"
                VAULT_SOURCE="selected"
                bind_session_remote
                return 0
            fi
            error "Invalid selection"
            return 1
        fi
        error "Multiple vaults found — pin one via ob-sync init or OBS_VAULT"
        return 1
    fi

    # 5 — platform default.
    VAULT="$DEFAULT_VAULT"
    VAULT_SOURCE="default"
    bind_session_remote
    return 0
}

##
# Bind the session's remote and branch to the RESOLVED vault. Called at
# every successful end of resolve_vault() (and by the menu-19 vault
# switch), so $REMOTE/$BRANCH always describe THIS vault — never a value
# left over from another one.
#
# Why this exists: the config file is machine-wide and stores one vault's
# remote. Before 9.4.2 a session running a different vault (startup
# picker, menu 19, OBS_VAULT) inherited that stored remote — repair
# cloned it, quick pushed into it, and the picked vault's notes landed in
# ANOTHER vault's repository (field-reported 9.4.1). The binding order:
#   OBS_REMOTE env  >  the vault's own origin  >  the vault's own
#   .ob-sync/config (9.5.0)  >  config file (only when the session vault
#   is the config-pinned vault, see config_remote_trusted).
# Silent by design: runs inside cron and --json paths.
##
bind_session_remote() {
    if [[ -z "${OBS_REMOTE:-}" ]]; then
        REMOTE=$(g remote get-url origin 2>/dev/null) || REMOTE=""
        if [[ -z "$REMOTE" ]]; then
            # The vault's own identity card — it belongs to THIS vault and
            # can never describe another one (unlike the machine config).
            REMOTE=$(vault_conf_get REMOTE) || REMOTE=""
        fi
        if [[ -z "$REMOTE" ]] && config_remote_trusted; then
            REMOTE=$(config_get REMOTE) || :
        fi
    fi
    if [[ -z "${OBS_BRANCH:-}" ]]; then
        local b
        b=$(g branch --show-current 2>/dev/null) || b=""
        if [[ -n "$b" ]]; then
            BRANCH="$b"
        elif config_remote_trusted; then
            b=$(config_get BRANCH) || :
            [[ -n "$b" ]] && BRANCH="$b"
        fi
    fi
    return 0
}

# ═════════════════════════════════════════════════════════════════════════════
#  2b. VAULT IDENTITY — <vault>/.ob-sync/config
# ═════════════════════════════════════════════════════════════════════════════
#
# The machine-wide config file (~/.config/ob-sync/config) describes THIS
# DEVICE: which vault is pinned, where backups live. The remote, however,
# belongs to the VAULT — so since 9.5.0 it also lives inside the vault in
# .ob-sync/config and travels with every push and clone. A vault cloned
# on a new device already knows where it belongs; a vault whose .git lost
# its origin restores it from its OWN file — never from another vault's
# machine-config entry (the 9.4.2 class of cross-vault leaks becomes
# structurally impossible on this path).
#
# Contents: REMOTE + BRANCH, same KEY=VALUE format as the machine config.
# NEVER credentials — those belong in git's credential helper.
#
# Lifecycle:
#   · init / remote <url>     — write the file, kept in lockstep with
#                               the vault's 'origin'
#   · first LOCKED run        — a legacy vault without the file gets it
#                               written from its own origin (migration)
#   · every LOCKED run        — origin is re-aligned with the file when
#                               they disagree: the file traveled with the
#                               vault, so it expresses the vault's intent
#   · both missing            — nothing is invented; sync/quick/repair
#                               refuse honestly (9.4.2 behavior) and
#                               `init` asks for the URL, then writes it
#
# Writes happen ONLY under the lock (ALLOW_VAULT_CONF=1, set by with_lock
# and the menu switcher) — read-only commands never mutate the vault.

ALLOW_VAULT_CONF=0

vault_conf_path() {
    printf '%s/.ob-sync/config' "$VAULT"
}

##
# Read a KEY=VALUE pair from the vault-local identity file (same parser
# rules as config_get). Pure read — safe in any command.
# @return 1 when the file or key is absent
##
vault_conf_get() {
    local f
    f=$(vault_conf_path)
    [[ -r "$f" && -f "$f" ]] || return 1
    local key="$1" line
    while IFS= read -r line; do
        case "$line" in
            ''|'#'*) continue ;;
            "$key="*) conf_value_clean "${line#"$key="}"; return 0 ;;
        esac
    done < "$f"
    return 1
}

##
# Write REMOTE/BRANCH into <vault>/.ob-sync/config. Idempotent (identical
# content is never rewritten, so the vault never shows phantom changes)
# and best-effort (a read-only vault must never break a sync).
##
vault_conf_write() {
    [[ "$ALLOW_VAULT_CONF" == 1 ]] || return 0
    [[ -d "$VAULT/.git" && -n "$REMOTE" ]] || return 0
    local cur cur_branch f tmp
    f=$(vault_conf_path)
    cur=$(vault_conf_get REMOTE)        || cur=""
    cur_branch=$(vault_conf_get BRANCH) || cur_branch=""
    [[ "$cur" == "$REMOTE" && "$cur_branch" == "$BRANCH" ]] && return 0
    if ! mkdir -p "$VAULT/.ob-sync" 2>/dev/null; then
        (( SILENT_UI )) || warn "Cannot create $VAULT/.ob-sync — vault identity not saved"
        return 0
    fi
    tmp=$(mktemp "$VAULT/.ob-sync/config.XXXXXX") || return 0
    {
        printf '# ob-sync vault identity — committed with the vault.\n'
        printf '# Every clone of this repository already knows where it belongs.\n'
        printf '# Device-specific settings (pinned vault path, backups) live in\n'
        printf '# %s and must NEVER be written here.\n' "$CONFIG_FILE"
        printf '# Credentials never belong in this file.\n'
        printf 'REMOTE=%s\n' "$REMOTE"
        printf 'BRANCH=%s\n' "$BRANCH"
    } > "$tmp" && mv -f "$tmp" "$f" || {
        rm -f "$tmp"
        (( SILENT_UI )) || warn "Cannot write $f — vault identity not saved"
        return 0
    }
    (( SILENT_UI )) || success "Vault identity saved: .ob-sync/config (travels with the vault)"
    return 0
}

##
# Re-align the session and the vault's 'origin' with the vault-local
# identity file. Called by with_lock (under the lock) and by the menu
# vault switch — never by read-only commands.
##
vault_conf_reconcile() {
    (( ALLOW_VAULT_CONF )) || return 0
    [[ -n "$VAULT" && -d "$VAULT/.git" ]] || return 0
    command -v git >/dev/null 2>&1 || return 0
    # An explicit OBS_REMOTE is an operator decision for THIS run — the
    # vault file must never silently rewire it.
    [[ -n "${OBS_REMOTE:-}" ]] && return 0

    local v_remote origin
    v_remote=$(vault_conf_get REMOTE) || v_remote=""
    origin=$(g remote get-url origin 2>/dev/null) || origin=""

    if [[ -n "$v_remote" ]]; then
        if [[ -z "$origin" ]]; then
            # Bootstrap: the vault's own file restores its own remote.
            if g remote add origin "$v_remote" >/dev/null 2>&1; then
                success "Origin restored from the vault's own .ob-sync/config: $v_remote"
            fi
        elif [[ "$origin" != "$v_remote" ]]; then
            # The file traveled with the vault (pulled after a
            # `remote set-url` on another device) — it expresses the
            # vault's intent and wins over a stale local origin.
            if g remote set-url origin "$v_remote" >/dev/null 2>&1; then
                info "Vault identity points to $v_remote — origin updated to match"
            fi
        fi
        REMOTE="$v_remote"
    elif [[ -n "$origin" ]]; then
        REMOTE="$origin"
    fi
    vault_conf_write
    return 0
}



# ═════════════════════════════════════════════════════════════════════════════
#  3. COLORS
# ═════════════════════════════════════════════════════════════════════════════

##
# Initialize the color palette. Disabled automatically when output is
# piped, when NO_COLOR (https://no-color.org) is set, or on dumb terminals.
##
init_colors() {
    if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-}" != "dumb" ]]; then
        C_RESET=$'\033[0m';  C_BOLD=$'\033[1m';   C_DIM=$'\033[2m'
        C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_BLUE=$'\033[34m'
        C_MAGENTA=$'\033[35m'; C_CYAN=$'\033[36m'
        C_BRIGHT_RED=$'\033[91m';      C_BRIGHT_GREEN=$'\033[92m'
        C_BRIGHT_YELLOW=$'\033[93m';   C_BRIGHT_BLUE=$'\033[94m'
        C_BRIGHT_MAGENTA=$'\033[95m';  C_BRIGHT_CYAN=$'\033[96m'
        C_BRIGHT_WHITE=$'\033[97m'
    else
        C_RESET='' C_BOLD='' C_DIM='' C_GREEN='' C_YELLOW='' C_BLUE=''
        C_MAGENTA='' C_CYAN='' C_BRIGHT_RED='' C_BRIGHT_GREEN=''
        C_BRIGHT_YELLOW='' C_BRIGHT_BLUE='' C_BRIGHT_MAGENTA=''
        C_BRIGHT_CYAN='' C_BRIGHT_WHITE=''
    fi
}


# ═════════════════════════════════════════════════════════════════════════════
#  4. LOGGING
# ═════════════════════════════════════════════════════════════════════════════

##
# Append a timestamped entry to the log file (if logging is enabled).
# Best-effort by design: logging failures never break the operation.
##
log() {
    [[ -n "${LOG_FILE:-}" ]] || return 0
    printf '[%s] [%-14s] %s\n' \
        "$(date '+%F %T')" "${FUNCNAME[1]:-main}" "$*" \
        >> "$LOG_FILE" 2>/dev/null || :
    return 0
}

##
# Prepare the log file and rotate it once it exceeds 1 MiB.
# File size via `wc -c` — portable across GNU and BSD userland.
##
init_log() {
    [[ -n "$LOG_FILE" ]] || return 0
    if ! touch "$LOG_FILE" 2>/dev/null; then
        LOG_FILE=""
        return 0
    fi
    local size
    size=$(wc -c < "$LOG_FILE" 2>/dev/null | tr -d ' ') || size=0
    (( size > 1048576 )) && mv -f "$LOG_FILE" "$LOG_FILE.1" 2>/dev/null
    return 0
}


# ═════════════════════════════════════════════════════════════════════════════
#  5. UI HELPERS
# ═════════════════════════════════════════════════════════════════════════════

##
# Horizontal rule. @param $1 character (default '-')  @param $2 width
##
hr() {
    local char="${1:--}"
    local width="${2:-56}"
    printf '%s' "$C_BLUE"
    printf '  %*s\n' "$width" '' | tr ' ' "$char"
    printf '%s' "$C_RESET"
}

##
# Print a section banner. Also resets the per-section step counter.
##
section() {
    STEP_NUM=0
    (( SILENT_UI )) && { log "SECTION: $1"; return 0; }
    echo
    printf '  %s%s%s\n' "$C_BRIGHT_BLUE$C_BOLD" "$1" "$C_RESET"
    hr - 56
}

##
# Print an auto-numbered step line within the current section.
##
step() {
    STEP_NUM=$((STEP_NUM + 1))
    (( SILENT_UI )) && { log "STEP: $1"; return 0; }
    printf '  %s[%d]%s %s\n' "$C_BRIGHT_BLUE" "$STEP_NUM" "$C_RESET" "$1"
}

success() { (( SILENT_UI )) && { log "OK: $1"; return 0; }; printf '  %s[ OK ]%s %s\n' "$C_BRIGHT_GREEN"  "$C_RESET" "$1"; }
error()   { printf '  %s[FAIL]%s %s\n' "$C_BRIGHT_RED"    "$C_RESET" "$1" >&2; log "ERROR: $1"; }
#
# Machine-readable mode (SILENT_UI): status/sync/restore --json own stdout
# exclusively. info/warn stay quiet there (vault auto-detection and friends
# would otherwise pollute the JSON document), and section/step/success are
# demoted to the log file as well — a failing `sync --json` must still emit
# parseable JSON even though the sync body is full of progress UI. error()
# deliberately keeps writing to stderr: stdout stays pure and humans/scripts
# capturing stderr still see the reason.
#
warn()    { (( SILENT_UI )) && { log "WARN: $1"; return 0; }; printf '  %s[WARN]%s %s\n' "$C_BRIGHT_YELLOW" "$C_RESET" "$1"; }
info()    { (( SILENT_UI )) && { log "INFO: $1"; return 0; }; printf '  %s[INFO]%s %s\n' "$C_BRIGHT_CYAN"   "$C_RESET" "$1"; }

##
# Aligned key/value line. @param $1 key  @param $2 value  @param $3 key color
##
kv() {
    # Machine-readable modes own stdout exclusively — key/value lines
    # are human UI and get demoted to the log file (same as section/step).
    (( SILENT_UI )) && { log "KV: $1 = $2"; return 0; }
    printf '  %s%-18s%s %s%s%s\n' \
        "${3:-$C_CYAN}" "$1:" "$C_RESET" "$C_BOLD" "$2" "$C_RESET"
}

##
# Escape a string for embedding in JSON output (status --json). Handles
# the two characters JSON mandates (backslash, quote) plus the control
# characters that realistically occur in git subject lines and paths.
##
json_escape() {
    local s="$1" i c rep
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\t'/\\t}
    s=${s//$'\n'/\\n}
    s=${s//$'\r'/\\r}
    # Remaining C0 control bytes (and DEL) are illegal raw inside JSON
    # strings — filenames on ext4 may legally contain them, and a single
    # raw byte makes the whole --json document unparseable. Map each to
    # \u00XX. Fast path: the scan is skipped when the string is clean
    # (the overwhelmingly common case).
    if [[ $s == *[$'\x01'-$'\x08'$'\x0b'$'\x0c'$'\x0e'-$'\x1f'$'\x7f']* ]]; then
        for ((i = 1; i <= 31; i++)); do
            case $i in 9 | 10 | 13) continue ;; esac
            printf -v c '%b' "$(printf '\\%03o' "$i")"
            printf -v rep '\\u%04x' "$i"
            s=${s//"$c"/$rep}
        done
        s=${s//$'\x7f'/\\u007f}
    fi
    printf '%s' "$s"
}

##
# Remove listed paths, safely skipping empty/unset entries.
##
purge() {
    local p
    for p in "$@"; do
        [[ -n "$p" ]] && rm -rf -- "$p" 2>/dev/null
    done
    return 0
}


# ═════════════════════════════════════════════════════════════════════════════
#  6. PORTABILITY HELPERS (Termux · Linux · macOS)
# ═════════════════════════════════════════════════════════════════════════════

# This script must behave identically on Termux, Linux distros and macOS.
# The BSD userland on macOS lacks several GNU conveniences the core would
# otherwise reach for:
#
#   sha256sum     → macOS ships shasum(1) instead
#   stat -c '%s'  → BSD stat uses -f and different specifiers
#   du --exclude  → not a BSD option
#   xargs -r      → GNU-only no-run-if-empty flag
#
# Every one of those is routed through the helpers below, so the rest of
# the script stays platform-agnostic. Adding a new GNU-ism directly in
# the core is a portability bug — add a helper here instead.

##
# Print the SHA-256 hex digest of a file, or nothing when no hashing tool
# exists on this system.
##
sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        run_local_timeout sha256sum "$1" 2>/dev/null | cut -d' ' -f1
    elif command -v shasum >/dev/null 2>&1; then
        run_local_timeout shasum -a 256 "$1" 2>/dev/null | cut -d' ' -f1
    fi
    return 0
}

##
# Write a .sha256 sidecar next to an archive (best-effort).
##
write_sidecar() {
    local archive="$1"
    local sum
    sum=$(sha256_of "$archive")
    [[ -n "$sum" ]] \
        && printf '%s  %s\n' "$sum" "${archive##*/}" > "${archive}.sha256" 2>/dev/null
    return 0
}

##
# Verify an archive against its .sha256 sidecar, if one exists.
# @return 0 when verified or no sidecar is present, 1 on mismatch
##
verify_sidecar() {
    local archive="$1"
    [[ -f "${archive}.sha256" ]] || return 0

    local dir=${archive%/*} name=${archive##*/}

    if command -v sha256sum >/dev/null 2>&1; then
        (cd "$dir" && run_local_timeout sha256sum -c "$name.sha256") >/dev/null 2>&1
    elif command -v shasum >/dev/null 2>&1; then
        (cd "$dir" && run_local_timeout shasum -a 256 -c "$name.sha256") >/dev/null 2>&1
    else
        # No hashing tool: cannot verify, but that is not a mismatch.
        log "no SHA-256 tool available — sidecar check skipped"
        return 0
    fi
}

##
# Human-readable size of the vault contents, excluding .git.
# Portable across GNU and BSD: per-file POSIX `du -k` summed in awk —
# `du --exclude` does not exist on macOS.
##
vault_size() {
    local out
    out=$(cd "$VAULT" 2>/dev/null || exit 0
          find . -name .git -prune -o -type f -exec du -k {} + 2>/dev/null \
          | awk '{ s += $1 }
                  END {
                      if (s < 1024)    { printf "%dK",  s;       exit }
                      if (s < 1048576) { printf "%.1fM", s/1024;  exit }
                      printf "%.1fG", s/1048576
                  }')
    printf '%s' "${out:-unknown}"
}

##
# Platform-appropriate package-manager hint, used by doctor and every
# dependency failure so the user always gets an actionable command.
##
install_hint() {
    if (( IS_TERMUX )); then
        printf '%s' 'pkg install git coreutils findutils grep'
    elif [[ "${OSTYPE:-}" == darwin* ]]; then
        printf '%s' 'brew install bash git coreutils findutils grep'
    else
        printf '%s' 'install git & coreutils via apt / dnf / pacman'
    fi
}


# ═════════════════════════════════════════════════════════════════════════════
#  7. TEMP FILE REGISTRY
# ═════════════════════════════════════════════════════════════════════════════

##
# Register a temporary path for removal by the EXIT handler. Every mktemp
# result in this script goes through here, so an interruption (SIGINT,
# SIGTERM, a failed step) can never leak temporaries behind.
#
# Registered paths may legitimately disappear before exit (e.g. a .part
# file renamed into its final archive) — removal then silently no-ops.
#
# Deliberate exception: execute_repair's rollback holder (.git-old-*) is
# NOT registered. It contains the user's original .git, so it must survive
# an interruption; the next run's clean_repair_artifacts removes it, and
# the pre-repair full backup is the ultimate safety net.
##
temp_register() {
    local p
    for p in "$@"; do
        TEMP_PATHS+=("$p")
    done
    return 0
}

##
# Sweep every registered temporary. Invoked from the EXIT handler only.
##
cleanup_temp() {
    local p
    for p in "${TEMP_PATHS[@]:-}"; do
        [[ -n "$p" ]] && rm -rf -- "$p" 2>/dev/null
    done
    TEMP_PATHS=()
    return 0
}


# ═════════════════════════════════════════════════════════════════════════════
#  8. LOCKING
# ═════════════════════════════════════════════════════════════════════════════

##
# Acquire an exclusive lock via mkdir (atomic on POSIX filesystems).
# A stale lock whose owner process is dead is detected via PID and reclaimed.
# On failure LOCK_BUSY_MSG carries a human-readable reason so JSON modes
# (with_lock) can answer with a parseable error document.
# @return 0 on success, 2 when the lock is unavailable
##
LOCK_BUSY_MSG=""

acquire_lock() {
    if [[ -d "$LOCK_DIR" ]]; then
        local pid=""
        pid=$(cat "$LOCK_DIR/pid" 2>/dev/null) || :

        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            error "Another instance is running (PID: $pid)"
            LOCK_BUSY_MSG="Another instance is running (PID: $pid)"
            return 2
        fi

        # A pid-less lock dir that appeared seconds ago is a live acquirer
        # still publishing its pid — bulldozing it would let two mutating
        # instances run concurrently. Only an OLD pid-less dir is stale.
        if [[ -z "$pid" ]]; then
            local now mtime age
            now=$(date +%s)
            mtime=$(stat -c %Y "$LOCK_DIR" 2>/dev/null) \
                || mtime=$(stat -f %m "$LOCK_DIR" 2>/dev/null) \
                || mtime="$now"
            age=$(( now - mtime ))
            if (( age < 5 )); then
                error "Another instance is starting up — retry in a moment"
                LOCK_BUSY_MSG="Another instance is starting up"
                return 2
            fi
        fi

        warn "Removing stale lock (previous PID: ${pid:-unknown})"
        rm -rf -- "$LOCK_DIR"
    fi

    # A plain mkdir is atomic: exactly one caller can win. Deliberately
    # no `-p` — it must fail if we lost the race.
    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        error "Failed to acquire lock: $LOCK_DIR"
        LOCK_BUSY_MSG="Failed to acquire lock: $LOCK_DIR"
        return 2
    fi

    # Publish the pid atomically: readers either see no pid file (an
    # acquirer that is still starting) or a complete one — never a torn
    # write that could clobber the next acquirer's ownership.
    local pidtmp
    if pidtmp=$(mktemp "${LOCK_DIR}/pid.XXXXXXXX" 2>/dev/null); then
        printf '%s\n' "$$" > "$pidtmp"
        mv -f "$pidtmp" "$LOCK_DIR/pid"
    else
        printf '%s\n' "$$" > "$LOCK_DIR/pid"
    fi
    LOCK_ACQUIRED=1
    return 0
}

##
# Release the lock, but only if this instance currently holds it.
##
release_lock() {
    if (( LOCK_ACQUIRED )); then
        rm -rf -- "$LOCK_DIR" 2>/dev/null
        LOCK_ACQUIRED=0
    fi
    return 0
}

##
# EXIT handler: release the lock (if held) and sweep registered temporaries.
# Installed once, globally, in main(); both branches are no-ops unless
# this instance actually owns something.
##
on_exit() {
    release_lock
    cleanup_temp
    return 0
}

##
# Run a mutating command while holding the lock, releasing it afterwards.
# This is what allows the interactive menu to run operation after
# operation without tripping over its own lock.
#
# JSON contract: when SILENT_UI is set (a --json command) and the lock
# cannot be acquired, the command wrapper never runs — so with_lock
# answers with a parseable error document instead of leaving stdout
# empty. Exit code stays 2 ("another instance running") in both modes.
##
with_lock() {
    local fn="$1"

    if ! acquire_lock; then
        if (( SILENT_UI )); then
            case "$fn" in
                cmd_backup)
                    SYNC_ERR_CODE="lock_busy"
                    SYNC_ERR_MSG="${LOCK_BUSY_MSG:-another instance holds the lock}"
                    backup_emit_json 2 ;;
                cmd_restore)
                    # Apply-mode --json: the DR drill answers with its own
                    # result document (list/dry-run never reach the lock).
                    restore_reset_state
                    RESTORE_ERR_CODE="lock_busy"
                    RESTORE_ERR_MSG="${LOCK_BUSY_MSG:-another instance holds the lock}"
                    restore_emit_apply 2 ;;
                cmd_organize)
                    # Only organize --fix reaches the lock (scan-only runs
                    # are routed around it): the document always reports
                    # the destructive mode it was denied.
                    organize_reset_state
                    ORG_FIX=1
                    ORG_ERR_CODE="lock_busy"
                    ORG_ERR_MSG="${LOCK_BUSY_MSG:-another instance holds the lock}"
                    organize_emit_json 2 ;;
                *)
                    # The four data operations share one document shape.
                    SYNC_T0=$SECONDS
                    sync_reset_results
                    SYNC_ERR_CODE="lock_busy"
                    SYNC_ERR_MSG="${LOCK_BUSY_MSG:-another instance holds the lock}"
                    op_emit_json "${fn#cmd_}" 2 ;;
            esac
        fi
        return 2
    fi

    # The vault's own identity card is authoritative for THIS vault:
    # re-align 'origin' with <vault>/.ob-sync/config before any data
    # operation (writes are serialized by the very lock we hold).
    ALLOW_VAULT_CONF=1
    vault_conf_reconcile

    "$@"   # fn + its args, exactly as dispatch forwarded them
    local rc=$?
    release_lock
    return "$rc"
}


# ═════════════════════════════════════════════════════════════════════════════
#  9. BACKUP ENGINE
# ═════════════════════════════════════════════════════════════════════════════

##
# Modification time of a file as a fixed-width sortable string
# ("SECONDS.NANOSECONDS", zero-padded). GNU stat (Linux/Termux) offers
# nanosecond precision; BSD/macOS stat only whole seconds — padded with
# zeros, which still orders archives created in different seconds. On
# exotic stat implementations both probes fail and an all-zero key is
# returned, degrading gracefully to the old timestamp+path ordering.
##
mtime_key_of() {
    local v int frac
    v=$(stat -c '%.9Y' "$1" 2>/dev/null)
    [[ "$v" =~ ^[0-9]+\.[0-9]{9}$ ]] || {
        v=$(stat -f '%m' "$1" 2>/dev/null)
        [[ "$v" =~ ^[0-9]+$ ]] || v=0
        v="$v.000000000"
    }
    int=${v%%.*}
    frac=${v#*.}
    printf '%010d.%s' "${int:-0}" "$frac"
}

##
# Filesystem identifier (the df device column) for a path, via POSIX
# `df -P` — identical output on GNU and BSD, no stat dialects involved.
# Used by doctor to detect a backup directory that would die together
# with the vault. Prints nothing when df cannot stat the path.
##
fs_id_of() {
    df -P "$1" 2>/dev/null | awk 'NR==2 {print $1}'
}

##
# Exact file size in bytes, portable across GNU and BSD stat. Returns 0
# when the file is unreadable or stat is exotic — callers treat that as
# "unknown" rather than failing the whole (JSON) document.
##
file_size_of() {
    local v
    v=$(stat -c '%s' "$1" 2>/dev/null) && [[ "$v" =~ ^[0-9]+$ ]] && { printf '%s' "$v"; return 0; }
    v=$(stat -f '%z' "$1" 2>/dev/null) && [[ "$v" =~ ^[0-9]+$ ]] && { printf '%s' "$v"; return 0; }
    printf '0'
    return 0
}

##
# List backup archives newest-first, ordered by the timestamp embedded in
# each filename (YYYYMMDD-HHMMSS).
#
# A plain name sort is NOT chronological here: filenames are prefixed with
# their origin ("quick-", "pre-sync-", "pre-repair-", ...), so lexicographic
# order groups by prefix first and would rank every "quick-*" above every
# "pre-repair-*" regardless of age — sacrificing the newest safety backups
# during pruning and mis-selecting "restore latest".
#
# Embedded timestamps have one-second resolution and same-second archives
# are COMMON in real use (quick → sync back-to-back, or a backup fired
# right after a sync). The path was previously the only tie-breaker, which
# let an older "pre-sync-*" outrank a newer "manual-*" created in the same
# second — so the full-precision mtime now breaks ties (the path remains
# as the last resort).
#
# Entries without a parseable timestamp sort as the oldest. Paths containing
# tab characters are not supported (pathological on every target platform).
#
# @stdout  archive paths, null-delimited, newest first
##
list_backups_desc() {
    local f ts
    while IFS= read -r -d '' f; do
        ts="00000000-000000"
        if [[ "${f##*/}" =~ ([0-9]{8})-([0-9]{6}) ]]; then
            ts="${BASH_REMATCH[1]}-${BASH_REMATCH[2]}"
        fi
        # Timestamp key first, full-precision mtime to break same-second
        # ties, path as the last resort — all sorted descending.
        printf '%s\t%s\t%s\0' "$ts" "$(mtime_key_of "$f")" "$f"
    done < <(find "$BACKUP_DIR" -maxdepth 1 -name '*.tar.gz' -type f -print0 2>/dev/null) \
        | sort -z -r \
        | while IFS=$'\t' read -r -d '' _ _ f; do
            printf '%s\0' "$f"
        done
}

##
# Create a verified, atomically-published full vault backup.
#
# Pipeline: archive → verify → atomic rename → sidecar checksum → sanity check
#
# tar's stderr is captured, never discarded. On Android shared storage tar
# may legitimately exit 1 with warnings (e.g. "file changed as we read it"
# while the Obsidian app writes workspace.json mid-archive). Those are
# tolerated — Phase 2 re-reads the entire stream as the real integrity
# gate. Exit codes >= 2 are fatal: the captured message is shown verbatim,
# because a bare "Backup creation failed" is not diagnosable on a phone.
#
# @param $1  filename prefix (e.g. "pre-sync")
# @stdout    absolute path of the finished archive
# @return    0 on success, 1 on failure
##
make_backup() {
    local prefix="${1:-backup}"
    local timestamp path tmp errs n=0 rc=0

    mkdir -p "$BACKUP_DIR" \
        || { error "Cannot create backup directory: $BACKUP_DIR"; return 1; }

    timestamp=$(date '+%Y%m%d-%H%M%S')
    path="$BACKUP_DIR/${prefix}-${timestamp}.tar.gz"

    # Guard against same-second filename collisions (e.g. quick -> sync).
    while [[ -e "$path" ]]; do
        n=$((n + 1))
        path="$BACKUP_DIR/${prefix}-${timestamp}-${n}.tar.gz"
    done
    tmp="${path}.part"
    temp_register "$tmp"

    # Phase 1 — archive the vault (including .git) into a temp file, so a
    # crash can never leave behind a half-written "valid-looking" archive.
    errs="${tmp}.errs"
    temp_register "$errs"
    run_local_timeout tar -czf "$tmp" -C "$VAULT" . 2>"$errs" || rc=$?

    if (( rc == 124 )); then
        rm -f -- "$tmp" "$errs"
        error "Backup timed out after ${LOCAL_TIMEOUT}s — is the vault or backup target on a hung filesystem?"
        warn "Tune with OBS_LOCAL_TIMEOUT (0 disables the local watchdog)"
        return 1
    fi
    if (( rc >= 2 )); then
        error "Backup creation failed — tar exit $rc:"
        sed 's/^/      /' "$errs" >&2
        rm -f -- "$tmp" "$errs"
        return 1
    fi
    if (( rc == 1 )); then
        warn "tar finished with warnings — the archive will still be verified:" >&2
        head -n 5 "$errs" | sed 's/^/      /' >&2
    fi
    rm -f -- "$errs"

    # Phase 2 — verify the archive stream is fully readable. This is the
    # real gate for warning-tolerated archives from Phase 1.
    local vrc=0
    run_local_timeout tar -tzf "$tmp" >/dev/null 2>&1 || vrc=$?
    if (( vrc == 124 )); then
        rm -f -- "$tmp"
        error "Backup verification timed out after ${LOCAL_TIMEOUT}s (OBS_LOCAL_TIMEOUT)"
        return 1
    fi
    if (( vrc != 0 )); then
        rm -f -- "$tmp"
        error "Backup verification failed (corrupt archive)"
        return 1
    fi

    # Phase 3 — atomic publish: rename is atomic on the same filesystem.
    if ! mv -f "$tmp" "$path"; then
        rm -f -- "$tmp"
        error "Failed to finalize backup"
        return 1
    fi

    # Phase 4 — sidecar checksum so `ob-sync verify` can audit it later.
    write_sidecar "$path"

    # Phase 5 — final sanity check.
    if [[ ! -s "$path" ]]; then
        rm -f -- "$path" "${path}.sha256"
        error "Backup file is empty"
        return 1
    fi

    log "Backup created: ${path##*/} (tar rc=$rc)"
    printf '%s\n' "$path"
    return 0
}

##
# Delete the oldest backups beyond the retention limit (sidecars included),
# ordered chronologically via list_backups_desc — never by raw filename.
#
# Stale "*.part" temporaries from interrupted backups are swept here as
# well: backups only ever run under the lock, so no live .part file can
# exist at this point.
##
prune_backups() {
    (( KEEP_BACKUPS > 0 )) || return 0

    find "$BACKUP_DIR" -maxdepth 1 -name '*.part' -type f \
        -exec rm -f -- {} + 2>/dev/null

    local -a archives=()
    local f
    while IFS= read -r -d '' f; do
        archives+=("$f")
    done < <(list_backups_desc)

    local total=${#archives[@]}
    (( total > KEEP_BACKUPS )) || return 0

    local removed=0 i archive
    for (( i = KEEP_BACKUPS; i < total; i++ )); do
        archive="${archives[i]}"
        rm -f -- "$archive" "${archive}.sha256" 2>/dev/null \
            && removed=$((removed + 1))
    done

    (( removed > 0 )) || return 0
    log "Pruned $removed backup(s)"
    info "Pruned $removed old backup(s) — retaining $KEEP_BACKUPS"
    return 0
}

#
# Archive listing cache (performance, 9.2.1).
#
# Preview flows used to decompress the SAME archive up to six times —
# the integrity gate, the two tar-slip audit passes, the member
# statistics and the top-level layout each ran their own tar. The
# cache holds the two listings every consumer needs — plain names
# (tar -tzf) and verbose lines (tar -tvzf, whose first character is the
# member type) — decompressed exactly once per archive, under the
# local watchdog (the same policy verify's stream check already had).
# Files are registered temporaries: swept on every exit path,
# interruption included. Keyed by archive path so the interactive
# menu, which can preview several archives in one process, never
# reuses a stale listing (ob-sync's own archives are write-once).
#
# @param $1  archive path
# @return    0 cache ready (built or reused), 1 the stream is unreadable
##
TAR_CACHE_FOR=""
TAR_CACHE_NAMES=""
TAR_CACHE_TYPES=""

tar_listing_cache() {
    local archive="$1"
    if [[ "$TAR_CACHE_FOR" == "$archive" && -n "$TAR_CACHE_NAMES" \
          && -f "$TAR_CACHE_NAMES" && -f "$TAR_CACHE_TYPES" ]]; then
        return 0
    fi

    local names types
    names=$(mktemp) || return 1
    types=$(mktemp) || { rm -f -- "$names"; return 1; }
    temp_register "$names" "$types"

    # Propagate the watchdog's 124 so callers can tell "slow/huge"
    # apart from "corrupt" (pre-9.2.3 both collapsed to 1, which made
    # the extraction_timeout contracts in the restore paths dead code).
    local rc=0
    run_local_timeout tar -tzf "$archive" > "$names" 2>/dev/null || rc=$?
    if (( rc == 124 )); then
        rm -f -- "$names" "$types"
        TAR_CACHE_FOR="" TAR_CACHE_NAMES="" TAR_CACHE_TYPES=""
        return 124
    elif (( rc != 0 )); then
        rm -f -- "$names" "$types"
        TAR_CACHE_FOR="" TAR_CACHE_NAMES="" TAR_CACHE_TYPES=""
        return 1
    fi
    run_local_timeout tar -tvzf "$archive" > "$types" 2>/dev/null || rc=$?
    if (( rc == 124 )); then
        rm -f -- "$names" "$types"
        TAR_CACHE_FOR="" TAR_CACHE_NAMES="" TAR_CACHE_TYPES=""
        return 124
    elif (( rc != 0 )); then
        rm -f -- "$names" "$types"
        TAR_CACHE_FOR="" TAR_CACHE_NAMES="" TAR_CACHE_TYPES=""
        return 1
    fi

    TAR_CACHE_FOR="$archive"
    TAR_CACHE_NAMES="$names"
    TAR_CACHE_TYPES="$types"
    return 0
}

##
# Audit an archive for members that are unsafe to extract, blocking the
# classic tar-slip vectors:
#   · absolute paths            (e.g. /data/...)
#   · parent traversal          (any ".." path component)
#   · special members           (symlinks, hardlinks, devices, fifos)
#
# Our own backups never contain such members (the default vault lives on
# Android shared storage, which cannot even hold symlinks), so any hit
# means a foreign or tampered archive and the restore is refused.
#
# The check is fail-closed by construction: listing lines are checked
# conservatively, and anything ambiguous is rejected rather than trusted.
#
# @param $1  archive path
# @return    0 safe, 1 unsafe (reason reported)
##
check_archive_safe() {
    local archive="$1"
    local entry line count=0

    # Pass 1 — every entry name must be relative and free of ".."
    # components. Prepending/trailing slashes normalize edge cases so a
    # single case pattern catches "..", "../x", "a/../b" and "a/..".
    # Listings come from the shared cache (9.2.1) — the audit used to
    # re-decompress the stream twice on its own.
    tar_listing_cache "$archive" || return 1

    while IFS= read -r entry; do
        [[ -z "$entry" ]] && continue
        (( count++ ))
        if [[ "$entry" == /* ]]; then
            error "Archive contains an absolute path: $entry"
            return 1
        fi
        case "/$entry/" in
            */../*)
                error "Archive contains a path traversal: $entry"
                return 1
                ;;
        esac
    done < "$TAR_CACHE_NAMES"

    if (( count == 0 )); then
        error "Archive is empty"
        return 1
    fi

    # Pass 2 — member types. In `tar -tv` output the first character of
    # each line is the member type: '-' regular, 'd' directory, anything
    # else (l/h/p/c/b) is refused.
    while IFS= read -r line; do
        case "$line" in
            -*|d*) ;;
            *)
                error "Archive contains a special member (type '${line:0:1}') — refused"
                return 1
                ;;
        esac
    done < "$TAR_CACHE_TYPES"

    return 0
}


# ═════════════════════════════════════════════════════════════════════════════
#  10. GIT HELPERS
# ═════════════════════════════════════════════════════════════════════════════

##
# Run git inside the vault (local, non-network operations).
##
g() {
    git -c "safe.directory=$VAULT" -C "$VAULT" "$@"
}

##
# Execute a command under a watchdog so a wedged target — a dead network
# connection or a hung FUSE/NFS mount — can never hang the whole
# operation. A timeout of 0 disables the watchdog for that class.
##
guarded_run() {
    local t="$1"; shift
    if (( HAS_TIMEOUT && t > 0 )); then
        timeout "$t" "$@"
    else
        "$@"
    fi
}

##
# Network operations (remote git calls): OBS_GIT_TIMEOUT, default 120s.
##
run_with_timeout() {
    guarded_run "$GIT_TIMEOUT" "$@"
}

##
# Local-but-slow operations (tar archives, hashing, git fsck):
# OBS_LOCAL_TIMEOUT, default 600s.
##
run_local_timeout() {
    guarded_run "$LOCAL_TIMEOUT" "$@"
}

##
# Run a network git operation inside the vault, wrapped in the watchdog.
# Unattended runs (cron, scripts, --json pipelines) keep the strict
# watchdog — but when a human is attached to a terminal, git may
# legitimately block on HTTPS credential prompts (a GitHub PAT on
# Termux takes a while to type): killing a live prompt mid-typing reads
# as "the tool hangs and then exits". The watchdog exists for the
# unattended case, so it yields whenever stdin is a terminal.
##
net() {
    local -a stall=()
    if (( NET_LOW_SPEED > 0 && NET_LOW_TIME > 0 )); then
        stall=(-c "http.lowSpeedLimit=$NET_LOW_SPEED" -c "http.lowSpeedTime=$NET_LOW_TIME")
    fi
    if [[ -t 0 ]]; then
        g "${stall[@]}" "$@"
    else
        run_with_timeout git -c "safe.directory=$VAULT" -C "$VAULT" "${stall[@]}" "$@"
    fi
}

##
# Network wrapper that keeps the UI clean WITHOUT hiding diagnostics.
#
# Interactive (stderr is a TTY): git's stderr streams straight through,
# so a credential prompt is VISIBLE and answerable — a swallowed prompt
# used to look exactly like a hang (the #1 Termux field report for
# 9.4.0). Machine mode (--json, cron): stderr is captured and surfaced
# as "git said:" on failure only, so the JSON document on stdout stays
# byte-clean (warn() is SILENT_UI-aware and demotes itself to the log).
##
net_quiet() {
    if [[ -t 2 ]]; then
        net "$@"
        return $?
    fi
    local errlog rc line
    errlog=$(mktemp) || { net "$@"; return $?; }
    temp_register "$errlog"
    # Capture the REAL exit status. `rc=$?` after a body-less-else `if`
    # would read the IF STATEMENT's status — and an `if` whose condition
    # fails with no else clause returns 0 (bash gotcha), which silently
    # turned failed pushes into successes in the 9.4.1 development cycle.
    rc=0
    net "$@" 2>"$errlog" || rc=$?
    if [[ -s "$errlog" ]]; then
        warn "git said:"
        while IFS= read -r line; do warn "  $line"; done < <(sed -n '1,6p' "$errlog")
    fi
    return "$rc"
}

##
# Actionable guidance after a failed remote operation against an HTTPS
# remote: GitHub (like most forges) rejects account passwords — a
# Personal Access Token is required, or the remote switches to SSH.
##
cred_hint() {
    local url
    url=$(g remote get-url origin 2>/dev/null) || return 0
    [[ "$url" == https://* ]] || return 0
    warn "HTTPS remote: GitHub needs a Personal Access Token as the password, not your account password"
    warn "On mobile, SSH is easier:  ob-sync remote git@github.com:<user>/<repo>.git"
}

##
# HTTPS remotes need somewhere to cache the GitHub Personal Access Token.
# Termux ships git WITHOUT a configured credential helper, so every sync
# re-prompts for username/password even though the same token was typed
# minutes earlier (the #1 Termux field report). Offer the built-in
# `store` helper once, during init, with explicit consent. SSH and other
# non-HTTPS remotes return early; non-interactive runs (cron, scripts,
# tests) stay completely silent — no output, no config writes.
##
ensure_credential_helper() {
    local url helper reply
    url=$(g remote get-url origin 2>/dev/null) || url="${REMOTE:-}"
    [[ "$url" == https://* ]] || return 0
    helper=$(g config --get-all credential.helper 2>/dev/null | tail -n 1) || :
    [[ -n "$helper" ]] && return 0
    (( ASSUME_YES )) || [[ -t 0 ]] || return 0
    if (( ! ASSUME_YES )); then
        printf '\n'
        warn "HTTPS remote with no credential helper — git will ask for a username and password on EVERY sync"
        warn "GitHub accepts only a Personal Access Token as the password, never the account password"
        read -r -p "  Remember credentials after the next successful login? [Y/n]: " reply || :
        if [[ "$reply" =~ ^[Nn]$ ]]; then
            info "Skipped — enable later with: git config --global credential.helper store"
            return 0
        fi
    fi
    if git config --global credential.helper store 2>/dev/null; then
        touch "$HOME/.git-credentials" 2>/dev/null || :
        chmod 600 "$HOME/.git-credentials" 2>/dev/null || :
        success "Credentials will be remembered from the next successful login (~/.git-credentials, 0600)"
        warn "The store helper keeps credentials in PLAIN TEXT — protect your device and home directory"
    else
        warn "Could not enable credential storage — run: git config --global credential.helper store"
    fi
    return 0
}

##
# Resolve the remote URL. Precedence: OBS_REMOTE environment > the vault's
# own 'origin' > the vault's own .ob-sync/config (9.5.0) > config file
# (only when config_remote_trusted).
#
# Since 9.4.2 the vault's own origin outranks the config file: origin is
# what `git push` actually targets, and the config REMOTE is machine-wide
# — it belongs to whichever vault was last init-ed, so trusting it for a
# session that runs a different vault cloned/pushed the WRONG repository
# (field-reported 9.4.1). Where origin and config disagree, origin is the
# per-vault truth. Empty when nothing is configured anywhere — callers
# must handle that with an actionable message.
# @stdout  the URL (empty output when unset)
##
remote_url() {
    if [[ -z "$REMOTE" ]]; then
        REMOTE=$(g remote get-url origin 2>/dev/null) || REMOTE=""
    fi
    if [[ -z "$REMOTE" ]]; then
        REMOTE=$(vault_conf_get REMOTE) || REMOTE=""
    fi
    if [[ -z "$REMOTE" ]] && config_remote_trusted; then
        REMOTE=$(config_get REMOTE) || :
    fi
    if [[ -n "$REMOTE" ]]; then
        printf '%s\n' "$REMOTE"
    fi
    return 0
}

##
# Ensure a remote named 'origin' is configured. When the URL is known
# (environment, the vault's own .ob-sync/config, or the config file FOR
# THIS VAULT) a missing 'origin' is repaired on the spot; otherwise a
# clear, actionable message replaces git's cryptic "'origin' does not
# appear to be a git repository" later in the flow.
#
# The config fallback only fires when config_remote_trusted: restoring
# ANOTHER vault's repository as origin here is exactly how a session
# switched to a remote-less vault ended up pushing into a foreign repo
# (field-reported 9.4.1). Untrusted sessions get an honest error instead.
##
ensure_origin() {
    if g remote get-url origin >/dev/null 2>&1; then
        return 0
    fi
    if [[ -z "$REMOTE" ]]; then
        REMOTE=$(vault_conf_get REMOTE) || REMOTE=""
    fi
    if [[ -z "$REMOTE" ]] && config_remote_trusted; then
        REMOTE=$(config_get REMOTE) || :
    fi
    if [[ -n "$REMOTE" ]]; then
        if g remote add origin "$REMOTE" >/dev/null 2>&1; then
            success "Remote 'origin' restored: $REMOTE"
            vault_conf_write
            return 0
        fi
        error "Failed to add remote 'origin'"
        return 1
    fi
    error "This vault has no remote configured: $VAULT"
    warn "Fix: ob-sync remote <url>  (or re-run: ob-sync init)"
    return 1
}

##
# True when the repository is in a clean, operable state: valid HEAD (or a
# legitimate unborn branch — a fresh repository with no commits yet),
# no in-progress rebase/merge/cherry-pick/revert, no stale index lock.
#
# The unborn case matters: after `ob-sync init` adopts a vault against an
# empty remote, HEAD points at a branch that has no commits. Treating that
# as "unsafe" made the very first sync of a brand-new setup impossible.
##
check_repo_safe() {
    [[ -d "$VAULT/.git" ]]                            || return 1
    if ! g rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
        # Unborn branch: HEAD must still be a well-formed symbolic ref.
        g symbolic-ref --quiet HEAD >/dev/null 2>&1 || return 1
    fi
    [[ ! -d "$VAULT/.git/rebase-merge" ]]             || return 1
    [[ ! -d "$VAULT/.git/rebase-apply" ]]             || return 1
    [[ ! -f "$VAULT/.git/MERGE_HEAD" ]]               || return 1
    [[ ! -f "$VAULT/.git/CHERRY_PICK_HEAD" ]]         || return 1
    [[ ! -f "$VAULT/.git/REVERT_HEAD" ]]              || return 1
    [[ ! -f "$VAULT/.git/index.lock" ]]               || return 1
    return 0
}

FSCK_DETAIL=""

##
# Integrity probe for the object database (used by `health`, human and
# --json modes share this one implementation).
#
#   rc 0  — intact
#   rc 2  — STALE REMOTE-TRACKING REF only: `git remote remove` can leave
#           refs/remotes/origin/HEAD behind as a broken null-sha ref (a git
#           deletion quirk for symrefs). fsck then exits non-zero with
#           "invalid sha1 pointer" although the object database itself is
#           perfectly intact — misreporting that as corruption would push
#           every user who ever re-pointed a remote into a needless full
#           `repair`. Every fsck error line must name a refs/remotes/*
#           invalid pointer for this downgrade; anything else is real.
#   rc 1  — object database corruption (or the watchdog tripped)
#
# Populates FSCK_DETAIL with the offending ref names for rc 2 (empty
# otherwise) so both report modes can offer a surgical fix.
##
fsck_object_db() {
    FSCK_DETAIL=""
    local out rc total broken refs
    if out=$(run_local_timeout git -c "safe.directory=$VAULT" -C "$VAULT" \
                fsck --connectivity-only --no-progress 2>&1); then
        return 0
    fi
    rc=$?
    # grep -c prints its (possibly zero) count to stdout AND exits 1 on
    # zero matches — `$(grep -c … || printf '0')` therefore captured a
    # two-line "0\n0" whenever fsck failed without matching lines, and
    # the arithmetic below then tripped a visible "syntax error in
    # expression" on stderr (9.2.1). Assign first, fall back on failure.
    total=$(grep -c '^error:' <<< "$out" 2>/dev/null) || total=0
    broken=$(grep -c '^error: refs/remotes/.*invalid sha1 pointer' <<< "$out" 2>/dev/null) || broken=0
    if (( total > 0 && broken == total )); then
        refs=$(grep -oE 'refs/remotes/[^:]+' <<< "$out" | sort -u | tr '\n' ' ')
        FSCK_DETAIL="${refs% }"
        return 2
    fi
    return 1
}

##
# Recover from interrupted git operations (killed syncs, dead processes).
# index.lock is only removed when no live git process is using the vault.
##
clear_stuck_state() {
    if [[ -d "$VAULT/.git/rebase-merge" || -d "$VAULT/.git/rebase-apply" ]]; then
        warn "Aborting unfinished rebase"
        g rebase --abort >/dev/null 2>&1 || :
    fi
    if [[ -f "$VAULT/.git/MERGE_HEAD" ]]; then
        warn "Aborting unfinished merge"
        g merge --abort >/dev/null 2>&1 || :
    fi
    if [[ -f "$VAULT/.git/CHERRY_PICK_HEAD" ]]; then
        warn "Aborting unfinished cherry-pick"
        g cherry-pick --abort >/dev/null 2>&1 || :
    fi
    if [[ -f "$VAULT/.git/REVERT_HEAD" ]]; then
        warn "Aborting unfinished revert"
        g revert --abort >/dev/null 2>&1 || :
    fi
    if [[ -f "$VAULT/.git/index.lock" ]]; then
        # Only safe to remove when no live git process owns the vault.
        if (( HAS_PGREP )) && pgrep -f "git.*$VAULT" >/dev/null 2>&1; then
            error "A live git process holds index.lock — try again shortly"
            return 1
        fi
        warn "Removing stale index.lock"
        rm -f -- "$VAULT/.git/index.lock"
    fi
    return 0
}

##
# Delete staging directories left behind by an interrupted repair.
# Safe at any time: a live repair holds the lock, so no valid staging
# directory can exist while this is executing. All historical naming
# patterns are cleaned (".git-original-*" comes from older versions).
##
clean_repair_artifacts() {
    local leftover
    for leftover in "$VAULT"/.git-staged-* "$VAULT"/.git-old-* "$VAULT"/.git-original-*; do
        if [[ -e "$leftover" ]]; then
            warn "Removing leftover repair artifact: ${leftover##*/}"
            rm -rf -- "$leftover"
        fi
    done
    return 0
}

##
# Ensure the repository is operable, attempting automatic recovery once.
##
ensure_safe() {
    clean_repair_artifacts
    if [[ ! -d "$VAULT/.git" ]]; then
        # A vault with no .git is not an "unsafe repository" — there is no
        # repository here at all. Diagnose it honestly (the generic
        # not-in-a-safe-state message misled users into thinking their
        # data was the problem) and point at the two real roads back:
        # repair rebuilds metadata from the vault's own remote — possible
        # precisely because the identity card carries it — init starts
        # from scratch.
        error "No git repository found in: $VAULT"
        error "Run: ob-sync repair  (rebuilds metadata from the vault's remote)"
        error "      — or: ob-sync init  (start a fresh repository)"
        return 1
    fi
    check_repo_safe && return 0

    warn "Repository is not in a safe state"
    clear_stuck_state || return 1

    if check_repo_safe; then
        success "Repository recovered automatically"
        return 0
    fi

    error "Repository still unsafe — run: ob-sync repair"
    return 1
}

##
# Settings that make git behave on Android shared storage
# (no exec-bit support, unicode filenames, linear history).
##
configure_repo() {
    g config core.fileMode  false
    g config core.quotePath false
    g config pull.rebase    true
    g config fetch.prune    true
    return 0
}

##
# Guarantee a committable identity exists (repo-local fallback).
##
ensure_identity() {
    local changed=0
    [[ -n "$(g config user.email 2>/dev/null)" ]] \
        || { g config user.email "obsidian@localhost"; changed=1; }
    [[ -n "$(g config user.name 2>/dev/null)" ]] \
        || { g config user.name  "Obsidian Sync";     changed=1; }
    (( changed )) && info "Applied fallback git identity (repo-local)"
    return 0
}

##
# Stage and commit all pending working-tree changes.
# @param $1  conventional-commit label (e.g. "chore(sync)")
##
COMMITTED_COUNT=0   # files committed by the last commit_changes call
commit_changes() {
    local label="${1:-chore(sync)}"
    local status count

    COMMITTED_COUNT=0

    if ! status=$(g status --porcelain 2>/dev/null); then
        error "Failed to read repository status"
        return 1
    fi

    if [[ -z "$status" ]]; then
        info "No local changes to commit"
        return 0
    fi

    count=$(printf '%s\n' "$status" | wc -l | tr -d ' ')

    ensure_identity
    g add -A 2>/dev/null || { error "Failed to stage changes"; return 1; }
    g commit -q -m "$label: auto-save $count file(s) [$(date '+%F %H:%M')]" 2>/dev/null \
        || { error "Commit failed"; return 1; }

    COMMITTED_COUNT=$count
    success "Committed $count changed file(s)"
    return 0
}

##
# True when the tracked branch is known on the remote (after a fetch).
##
remote_branch_exists() {
    g rev-parse --verify --quiet "refs/remotes/origin/$BRANCH" >/dev/null 2>&1
}

##
# Rebase onto origin/<branch>. On conflict, report the culprits and abort
# cleanly so the local state is left exactly as it was.
#
# REBASE_CONFLICT / REBASE_CONFLICT_FILES let machine-mode callers (sync
# --json) distinguish a genuine conflict from any other rebase failure.
##
REBASE_CONFLICT=0
REBASE_CONFLICT_FILES=0
rebase_onto_remote() {
    REBASE_CONFLICT=0
    REBASE_CONFLICT_FILES=0

    if g rebase "origin/$BRANCH" >/dev/null 2>&1; then
        return 0
    fi

    if [[ -d "$VAULT/.git/rebase-merge" || -d "$VAULT/.git/rebase-apply" ]]; then
        REBASE_CONFLICT=1
        error "Merge conflict detected — aborting rebase"
        local -a conflicted=()
        local file
        # Null-delimited: filenames containing newlines are listed safely.
        while IFS= read -r -d '' file; do
            conflicted+=("$file")
        done < <(g diff --name-only --diff-filter=U -z 2>/dev/null)

        if (( ${#conflicted[@]} )); then
            REBASE_CONFLICT_FILES=${#conflicted[@]}
            warn "Conflicting file(s):"
            for file in "${conflicted[@]}"; do
                if (( SILENT_UI )); then
                    log "CONFLICT: $file"
                else
                    printf '      %s%s%s\n' "$C_YELLOW" "$file" "$C_RESET"
                fi
            done
        fi
        g rebase --abort >/dev/null 2>&1
        warn "Local commits are safe. Resolve the conflict on another device, then retry."
    else
        error "Rebase failed"
    fi
    return 1
}


# ═════════════════════════════════════════════════════════════════════════════
#  11. REPAIR ENGINE (two-phase, atomic)
# ═════════════════════════════════════════════════════════════════════════════

##
# Phase 1 — clone a fresh copy of the remote and verify it.
# Completely non-destructive: nothing in the vault is touched.
# NOTE: emits ONLY the candidate path on stdout; all diagnostics go to
# stderr, because the caller captures stdout.
# @stdout  path to the candidate directory
##
prepare_repair() {
    local candidate url
    url=$(remote_url)
    if [[ -z "$url" ]]; then
        error "No remote repository configured"
        warn "Fix: ob-sync remote <url>  (or re-run: ob-sync init)"
        return 1
    fi
    candidate=$(mktemp -d "${BACKUP_DIR}/repair-XXXXXX") || return 1
    temp_register "$candidate"

    log "Cloning fresh copy for repair"
    if ! run_with_timeout git clone --quiet --single-branch --branch "$BRANCH" \
            "$url" "$candidate/repo" 2>/dev/null; then
        rm -rf -- "$candidate"
        error "Clone failed (network, credentials, empty remote, or wrong branch '$BRANCH')"
        return 1
    fi

    if ! run_local_timeout git -C "$candidate/repo" fsck --connectivity-only >/dev/null 2>&1; then
        rm -rf -- "$candidate"
        error "Clone verification failed"
        return 1
    fi

    printf '%s\n' "$candidate"
    return 0
}

##
# Phase 2 — swap the vault's .git for the verified candidate, then restore
# any file that exists remotely but is missing locally.
#
# Ordering is critical and deliberate:
#   swap .git  →  restore files  →  delete candidate
# The candidate is the data source for the restore step, so it must
# survive until the restore loop has finished consuming it. (Deleting it
# first turned the restore into dead code in earlier versions.)
#
# Additive only: existing local files always win and are never overwritten.
#
# @param $1  candidate directory returned by prepare_repair
##
execute_repair() {
    local candidate="$1"
    local staged="" old_holder=""

    # Safety net: a verified backup of the current (possibly broken) state.
    local backup_path
    backup_path=$(make_backup "pre-repair") || { purge "$candidate"; return 1; }
    prune_backups
    success "Safety backup: ${backup_path##*/}"

    # Stage the fresh .git INSIDE the vault so the final install is a
    # same-filesystem rename (atomic on shared storage).
    staged=$(mktemp -d "$VAULT/.git-staged-XXXXXX") || {
        purge "$candidate"
        error "Failed to create staging area"
        return 1
    }
    temp_register "$staged"

    local stage_err=""
    if ! stage_err=$(cp -a "$candidate/repo/.git/." "$staged/" 2>&1); then
        # Fallback for filesystems that refuse permission preservation
        # (some FUSE mounts used by Android shared storage behave this way).
        if ! cp -R "$candidate/repo/.git/." "$staged/" 2>/dev/null; then
            purge "$candidate" "$staged"
            error "Failed to stage git metadata"
            [[ -n "$stage_err" ]] && warn "cp -a said: $stage_err"
            return 1
        fi
    fi

    # Classify the current .git so the install step can never be blocked
    # by a non-directory target. A .git that is neither a healthy
    # directory nor absent (a truncated plain file or a stale symlink —
    # both seen when shared-storage I/O dies mid-write) is corrupt by
    # definition and is parked in the rollback holder like any other.
    local old_kind=""
    if [[ -d "$VAULT/.git" ]]; then
        old_kind="dir"
    elif [[ -e "$VAULT/.git" || -L "$VAULT/.git" ]]; then
        old_kind="other"
    fi

    # Preserve the original .git so every failure path can roll back.
    # NOTE: deliberately NOT registered with temp_register — it holds the
    # user's original history and must survive an interruption. The next
    # run's clean_repair_artifacts sweeps it, and the pre-repair backup
    # above is the ultimate safety net.
    if [[ -n "$old_kind" ]]; then
        old_holder=$(mktemp -d "$VAULT/.git-old-XXXXXX") || {
            purge "$candidate" "$staged"
            error "Failed to create rollback area"
            return 1
        }
        local keep_err=""
        if ! keep_err=$(mv "$VAULT/.git" "$old_holder/git" 2>&1); then
            purge "$candidate" "$staged" "$old_holder"
            error "Failed to preserve original .git"
            [[ -n "$keep_err" ]] && warn "mv said: $keep_err"
            return 1
        fi
        [[ "$old_kind" == "other" ]] && \
            warn "Corrupt .git (not a directory) preserved in the rollback area"
    fi

    # Atomic swap. On failure, fall back to a copy-based install (some
    # shared-storage mounts refuse to rename a directory into a freshly
    # vacated name); if even that fails, roll the original .git back.
    local install_err=""
    if ! install_err=$(mv "$staged" "$VAULT/.git" 2>&1); then
        if mkdir "$VAULT/.git" 2>/dev/null \
                && cp -R "$staged/." "$VAULT/.git/" 2>/dev/null \
                && [[ -f "$VAULT/.git/HEAD" ]]; then
            info "rename unavailable on this filesystem — installed via copy"
        else
            local back_err=""
            [[ -n "$old_holder" ]] && back_err=$(mv "$old_holder/git" "$VAULT/.git" 2>&1)
            purge "$candidate" "$staged" "$old_holder"
            error "Failed to install repaired .git"
            [[ -n "$install_err" ]] && warn "mv said: $install_err"
            [[ -n "$back_err" ]] && warn "rollback said: $back_err"
            return 1
        fi
    fi
    success "Git metadata replaced atomically"

    configure_repo

    # Restore remote files that are missing locally (never overwrite).
    # find outputs ABSOLUTE paths rooted at "$candidate/repo", so the
    # prefix strip below is exact; -print0 keeps newline-safe filenames.
    # Only regular files are considered — Android shared storage cannot
    # hold symlinks anyway.
    if [[ -d "$candidate/repo" ]]; then
        local restored=0 rel file
        while IFS= read -r -d '' file; do
            rel=${file#"$candidate/repo/"}
            if [[ ! -e "$VAULT/$rel" ]]; then
                mkdir -p "$VAULT/$(dirname "$rel")"
                cp "$file" "$VAULT/$rel" 2>/dev/null && restored=$((restored + 1))
            fi
        done < <(find "$candidate/repo" -name .git -prune -o -type f -print0 2>/dev/null)

        (( restored > 0 )) && success "Restored $restored missing file(s) from remote"
    fi

    # Cleanup only AFTER the restore loop has consumed the candidate.
    purge "$candidate" "$old_holder"
    log "Repair executed"
    return 0
}


# ═════════════════════════════════════════════════════════════════════════════
#  12. COMMANDS
# ═════════════════════════════════════════════════════════════════════════════

# Result accumulators for the data operations (sync/pull/push/quick in
# --json mode; reset in each *_run pipeline).
SYNC_T0=0
SYNC_PULLED=0
SYNC_PUSHED=0
SYNC_BACKUP=""
SYNC_BACKUP_SKIPPED=0
SYNC_ERR_CODE=""
SYNC_ERR_MSG=""

##
# Record the machine-readable failure code and fail. The human message was
# already printed (to stderr) by the failing stage; the code gives scripts
# something stable to branch on, the message a one-line summary.
##
sync_fail() {
    SYNC_ERR_CODE="$1"
    SYNC_ERR_MSG="$2"
    return 1
}

##
# Reset the operation result accumulators before every run.
##
sync_reset_results() {
    SYNC_PULLED=0
    SYNC_PUSHED=0
    SYNC_BACKUP=""
    SYNC_BACKUP_SKIPPED=0
    SYNC_ERR_CODE=""
    SYNC_ERR_MSG=""
}

##
# Shared environment guard for the data operations (sync/pull/push/quick).
# The guards live in the command wrappers rather than dispatch() so that
# --json mode can answer with a parseable error document even on a broken
# environment — machine consumers must never be left with an empty stdout
# and only a stderr hint. Human-mode messages are unchanged.
#
#   usage:  op_env_guard "$json" || { (( json )) && op_emit_json <op> 1; return 1; }
##
op_env_guard() {
    local json="$1"
    if ! command -v git >/dev/null 2>&1; then
        error "git is not installed"
        warn "Install it with: $(install_hint)"
        (( json )) && { SYNC_ERR_CODE="git_missing"; SYNC_ERR_MSG="git is not installed"; }
        return 1
    fi
    if [[ ! -d "$VAULT" ]]; then
        error "Vault not found: $VAULT"
        warn "Initialize with: ob-sync init"
        (( json )) && { SYNC_ERR_CODE="vault_missing"; SYNC_ERR_MSG="Vault not found: $VAULT"; }
        return 1
    fi
    return 0
}

##
# Emit the machine-readable operation result. Called only from cmd_* in
# --json mode: SILENT_UI (set in main()) guarantees this document is the
# ONLY thing on stdout, whatever happened inside the pipeline.
#
# ONE stable shape for all four data operations (see README
# "Machine-Readable Operations"):
#   { version, command, result: "ok"|"error", branch, remote|null,
#     pulled, pushed, committed_files, conflicts, backup|null,
#     backup_skipped, elapsed_seconds, error: {code, message}|null }
# `pull` always reports pushed=0, `push` always pulled=0 — consumers parse
# a single document shape regardless of the operation.
##
op_emit_json() {
    local op="$1" rc="$2"
    local branch remote_url
    branch=$(g symbolic-ref --short HEAD 2>/dev/null) || branch="$BRANCH"
    remote_url=$(g remote get-url origin 2>/dev/null) || remote_url=""

    local j_backup="null" j_error="null" j_result='"ok"' j_skipped="false"
    [[ -n "$SYNC_BACKUP" ]] && j_backup="\"$(json_escape "${SYNC_BACKUP##*/}")\""
    (( SYNC_BACKUP_SKIPPED )) && j_skipped="true"
    if (( rc != 0 )); then
        j_result='"error"'
        j_error="{ \"code\": \"$(json_escape "${SYNC_ERR_CODE:-unknown}")\", \"message\": \"$(json_escape "${SYNC_ERR_MSG:-operation failed}")\" }"
    fi

    printf '{\n'
    printf '  "version": "%s",\n' "$VERSION"
    printf '  "command": "%s",\n' "$op"
    printf '  "result": %s,\n' "$j_result"
    printf '  "branch": "%s",\n' "$(json_escape "$branch")"
    if [[ -n "$remote_url" ]]; then
        printf '  "remote": "%s",\n' "$(json_escape "$remote_url")"
    else
        printf '  "remote": null,\n'
    fi
    printf '  "pulled": %s,\n' "$SYNC_PULLED"
    printf '  "pushed": %s,\n' "$SYNC_PUSHED"
    printf '  "committed_files": %s,\n' "${COMMITTED_COUNT:-0}"
    printf '  "conflicts": %s,\n' "${REBASE_CONFLICT_FILES:-0}"
    printf '  "backup": %s,\n' "$j_backup"
    printf '  "backup_skipped": %s,\n' "$j_skipped"
    printf '  "elapsed_seconds": %s,\n' "$(( SECONDS - SYNC_T0 ))"
    printf '  "error": %s\n' "$j_error"
    printf '}\n'
    return 0
}

##
# Entry point for `ob-sync sync [--json]`. The whole pipeline lives in
# sync_run() so the JSON wrapper can capture its outcome; the exit code
# contract is identical in both modes (0 = synced, 1 = failed).
##
# shellcheck disable=SC2120  # args arrive via with_lock's dynamic "$@" call
cmd_sync() {
    SYNC_T0=$SECONDS
    local json=0
    while (( $# )); do
        case "$1" in
            --json)     json=1 ;;
            # -y is a no-op here (sync never prompts) but accepted so that
            # `ob-sync sync -y` muscle memory and existing scripts keep
            # working — the pre-8.7.0 parser silently ignored all args.
            -y|--yes)   : ;;
            *)  error "Unknown option for sync: $1"
                warn "Usage: ob-sync sync [--json] [-y]"
                return 1 ;;
        esac
        shift
    done

    # Environment guards (both modes) — shared with pull/push/quick, see
    # op_env_guard: --json must answer with a parseable document even on a
    # broken environment.
    if ! op_env_guard "$json"; then
        (( json )) && op_emit_json sync 1
        return 1
    fi

    if (( ! json )); then
        sync_run
        return $?
    fi

    # Machine mode. sync_run's progress UI is suppressed (SILENT_UI was set
    # in main()); the document below is the only stdout output and errors
    # still reach stderr for humans tailing cron logs.
    sync_run
    local rc=$?
    op_emit_json sync "$rc"
    return "$rc"
}

sync_run() {
    sync_reset_results
    section "Full Synchronization"
    local backup_path="" counts behind=0 ahead=0

    step "Checking repository state"
    ensure_safe || { sync_fail repository_unsafe "Repository is in an unsafe state — run: ob-sync repair"; return 1; }
    ensure_origin || { sync_fail no_remote "Remote 'origin' is not configured"; return 1; }
    success "Repository is in a safe state"

    if [[ "$SKIP_BACKUP" == "1" ]]; then
        SYNC_BACKUP_SKIPPED=1
        info "Pre-sync backup skipped (OBS_SKIP_BACKUP=1)"
    else
        step "Creating pre-sync backup"
        backup_path=$(make_backup "pre-sync") || { sync_fail backup_failed "Pre-sync backup failed"; return 1; }
        prune_backups
        SYNC_BACKUP="$backup_path"
        success "Backup: ${backup_path##*/}"
    fi

    step "Committing local changes"
    commit_changes "chore(sync)" || { sync_fail commit_failed "Could not commit local changes"; return 1; }

    step "Fetching remote state"
    if ! net_quiet fetch --quiet origin; then
        error "Fetch failed — check network connection and credentials"
        cred_hint
        sync_fail fetch_failed "git fetch failed (network or credentials)"
        return 1
    fi

    if remote_branch_exists; then
        if ! g rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
            # Unborn HEAD with a populated remote (a vault re-initialized
            # before its first commit): rev-list against HEAD cannot
            # work, and masking it to 0 reported "up to date" forever
            # while the remote content never arrived. Adopt init's
            # materialization path instead.
            behind=$(g rev-list --count "origin/$BRANCH" 2>/dev/null) || behind=0
            [[ "$behind" =~ ^[0-9]+$ ]] || behind=0
            if (( behind > 0 )); then
                step "Aligning with origin/$BRANCH ($behind remote commit(s) — no local commits yet)"
                if ! g reset --mixed "origin/$BRANCH" >/dev/null 2>&1; then
                    sync_fail rebase_failed "Could not align with origin/$BRANCH"
                    return 1
                fi
                g ls-files --deleted -z 2>/dev/null \
                    | xargs -0 git -C "$VAULT" checkout -- 2>/dev/null || :
                SYNC_PULLED=$behind
                success "Integrated $behind remote commit(s)"
            else
                info "Remote has no new commits"
            fi
        elif counts=$(g rev-list --left-right --count "origin/$BRANCH...HEAD" 2>/dev/null); then
            read -r behind ahead <<< "$counts"
            if (( behind > 0 )); then
                step "Rebasing onto origin/$BRANCH ($behind remote commit(s))"
                rebase_onto_remote || {
                    if (( REBASE_CONFLICT )); then
                        sync_fail conflict "Merge conflict — local commits are preserved"
                    else
                        sync_fail rebase_failed "Rebase onto origin/$BRANCH failed"
                    fi
                    return 1
                }
                SYNC_PULLED=$behind
                success "Integrated $behind remote commit(s)"
            else
                info "Remote has no new commits"
            fi
        fi
    else
        info "Remote branch '$BRANCH' not found — the next push will create it"
    fi

    step "Pushing to origin/$BRANCH"
    if remote_branch_exists; then
        ahead=$(g rev-list --count "origin/$BRANCH..HEAD" 2>/dev/null) || ahead=0
    else
        ahead=$(g rev-list --count HEAD 2>/dev/null) || ahead=0
    fi

    if (( ahead == 0 )); then
        info "Nothing to push — already up to date"
    else
        local -a push_args=(origin "$BRANCH")
        remote_branch_exists || push_args=(-u origin "$BRANCH")

        if net_quiet push --quiet "${push_args[@]}"; then
            SYNC_PUSHED=$ahead
            success "Pushed $ahead commit(s)"
        else
            error "Push failed — local commits are preserved"
            warn "Check network/credentials, then retry with: ob-sync push"
            cred_hint
            sync_fail push_failed "git push failed (network or credentials)"
            return 1
        fi
    fi

    # Lightweight housekeeping (a no-op unless the repository has grown).
    g gc --auto --quiet >/dev/null 2>&1 || :

    mkdir -p "$BACKUP_DIR" 2>/dev/null || :
    date '+%F %T' > "$STATE_FILE" 2>/dev/null || :

    log "Sync OK — pulled=$SYNC_PULLED pushed=$SYNC_PUSHED"
    # The blank separator is cosmetic only — machine mode must not print
    # even whitespace ahead of the JSON document.
    (( SILENT_UI )) || echo
    success "Sync complete — $SYNC_PULLED commit(s) in, $SYNC_PUSHED commit(s) out ($((SECONDS - SYNC_T0))s)"
    return 0
}

##
# Entry points for `pull|push|quick [--json]`. Identical wrapper pattern to
# cmd_sync: flags first, then the shared environment guard, then the pure
# pipeline in *_run(). The exit-code contract is identical in both modes.
##

# shellcheck disable=SC2120  # args arrive via with_lock's dynamic "$@" call
cmd_pull() {
    SYNC_T0=$SECONDS
    local json=0
    while (( $# )); do
        case "$1" in
            --json)   json=1 ;;
            -y|--yes) : ;;
            *)  error "Unknown option for pull: $1"
                warn "Usage: ob-sync pull [--json] [-y]"
                return 1 ;;
        esac
        shift
    done

    if ! op_env_guard "$json"; then
        (( json )) && op_emit_json pull 1
        return 1
    fi

    if (( ! json )); then
        pull_run
        return $?
    fi
    pull_run
    local rc=$?
    op_emit_json pull "$rc"
    return "$rc"
}

pull_run() {
    sync_reset_results
    section "Pull"
    local behind

    step "Checking repository state"
    ensure_safe || { sync_fail repository_unsafe "Repository is in an unsafe state — run: ob-sync repair"; return 1; }
    ensure_origin || { sync_fail no_remote "Remote 'origin' is not configured"; return 1; }

    step "Committing local changes"
    commit_changes "chore(pull)" || { sync_fail commit_failed "Could not commit local changes"; return 1; }

    step "Fetching remote state"
    net_quiet fetch --quiet origin || { error "Fetch failed"; cred_hint; sync_fail fetch_failed "git fetch failed (network or credentials)"; return 1; }

    if ! remote_branch_exists; then
        info "Remote branch '$BRANCH' not found — nothing to pull"
        return 0
    fi

    if ! g rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
        # Unborn HEAD with a populated remote: adopt init's
        # materialization path instead of reporting "Already up to date"
        # forever while the remote files never arrive.
        behind=$(g rev-list --count "origin/$BRANCH" 2>/dev/null) || behind=0
        [[ "$behind" =~ ^[0-9]+$ ]] || behind=0
        if (( behind == 0 )); then
            success "Already up to date"
            return 0
        fi
        step "Aligning with origin/$BRANCH ($behind remote commit(s) — no local commits yet)"
        if g reset --mixed "origin/$BRANCH" >/dev/null 2>&1; then
            g ls-files --deleted -z 2>/dev/null \
                | xargs -0 git -C "$VAULT" checkout -- 2>/dev/null || :
            SYNC_PULLED=$behind
            success "Integrated $behind remote commit(s)"
            return 0
        fi
        sync_fail rebase_failed "Could not align with origin/$BRANCH"
        return 1
    fi

    behind=$(g rev-list --count "HEAD..origin/$BRANCH" 2>/dev/null) || behind=0
    if (( behind == 0 )); then
        success "Already up to date"
        return 0
    fi

    step "Rebasing onto origin/$BRANCH ($behind remote commit(s))"
    rebase_onto_remote || {
        if (( REBASE_CONFLICT )); then
            sync_fail conflict "Merge conflict — local commits are preserved"
        else
            sync_fail rebase_failed "Rebase onto origin/$BRANCH failed"
        fi
        return 1
    }
    SYNC_PULLED=$behind
    success "Integrated $behind remote commit(s)"
    return 0
}

# shellcheck disable=SC2120  # args arrive via with_lock's dynamic "$@" call
cmd_push() {
    SYNC_T0=$SECONDS
    local json=0
    while (( $# )); do
        case "$1" in
            --json)   json=1 ;;
            -y|--yes) : ;;
            *)  error "Unknown option for push: $1"
                warn "Usage: ob-sync push [--json] [-y]"
                return 1 ;;
        esac
        shift
    done

    if ! op_env_guard "$json"; then
        (( json )) && op_emit_json push 1
        return 1
    fi

    if (( ! json )); then
        push_run
        return $?
    fi
    push_run
    local rc=$?
    op_emit_json push "$rc"
    return "$rc"
}

push_run() {
    sync_reset_results
    section "Push"
    local ahead

    step "Checking repository state"
    ensure_safe || { sync_fail repository_unsafe "Repository is in an unsafe state — run: ob-sync repair"; return 1; }
    ensure_origin || { sync_fail no_remote "Remote 'origin' is not configured"; return 1; }

    step "Committing local changes"
    commit_changes "chore(push)" || { sync_fail commit_failed "Could not commit local changes"; return 1; }

    step "Pushing to origin/$BRANCH"
    if remote_branch_exists; then
        ahead=$(g rev-list --count "origin/$BRANCH..HEAD" 2>/dev/null) || ahead=0
    else
        ahead=$(g rev-list --count HEAD 2>/dev/null) || ahead=0
    fi

    if (( ahead == 0 )); then
        info "Nothing to push — already up to date"
        return 0
    fi

    local -a push_args=(origin "$BRANCH")
    remote_branch_exists || push_args=(-u origin "$BRANCH")

    if net_quiet push --quiet "${push_args[@]}"; then
        SYNC_PUSHED=$ahead
        success "Pushed $ahead commit(s)"
        return 0
    fi

    error "Push failed — check network connection and credentials"
    cred_hint
    sync_fail push_failed "git push failed (network or credentials)"
    return 1
}

##
# One-shot daily routine: a single verified backup followed by a full
# sync. The sync reuses the backup (its own pre-sync backup is skipped).
##

# shellcheck disable=SC2120  # args arrive via with_lock's dynamic "$@" call
cmd_quick() {
    SYNC_T0=$SECONDS
    local json=0
    while (( $# )); do
        case "$1" in
            --json)   json=1 ;;
            -y|--yes) : ;;
            *)  error "Unknown option for quick: $1"
                warn "Usage: ob-sync quick [--json] [-y]"
                return 1 ;;
        esac
        shift
    done

    if ! op_env_guard "$json"; then
        (( json )) && op_emit_json quick 1
        return 1
    fi

    if (( ! json )); then
        quick_run
        return $?
    fi
    quick_run
    local rc=$?
    op_emit_json quick "$rc"
    return "$rc"
}

quick_run() {
    sync_reset_results
    section "Quick Mode"
    info "One verified backup, then a full sync"

    local path
    path=$(make_backup "quick") || { sync_fail backup_failed "Backup failed"; return 1; }
    prune_backups
    success "Backup: ${path##*/}"

    local prev_skip=$SKIP_BACKUP
    SKIP_BACKUP=1
    sync_run
    local rc=$?
    SKIP_BACKUP=$prev_skip

    # quick's own verified backup already covers the pre-sync slot: surface
    # it as THE backup of this operation so scripts see backup=<name> and
    # backup_skipped=false — the pre-sync backup was skipped by design, not
    # lost (sync_run's reset wiped the accumulator).
    SYNC_BACKUP="$path"
    SYNC_BACKUP_SKIPPED=0
    return "$rc"
}

##
# Entry point for `ob-sync backup [--json]`. The vault guard lives HERE
# (not in dispatch) so --json answers with a parseable error document
# even on a broken environment. Human mode is unchanged; -y is a no-op
# kept for muscle memory (backup never prompts), unknown flags fail
# closed.
##
# shellcheck disable=SC2120  # args arrive via with_lock's dynamic "$@" call
cmd_backup() {
    SYNC_T0=$SECONDS
    local json=0
    while (( $# )); do
        case "$1" in
            --json)   json=1 ;;
            -y|--yes) : ;;
            *)  error "Unknown option for backup: $1"
                warn "Usage: ob-sync backup [--json] [-y]"
                return 1 ;;
        esac
        shift
    done

    if [[ ! -d "$VAULT" ]]; then
        error "Vault not found: $VAULT"
        warn "Initialize with: ob-sync init"
        if (( json )); then
            SYNC_ERR_CODE="vault_missing"
            SYNC_ERR_MSG="Vault not found: $VAULT"
            backup_emit_json 1
        fi
        return 1
    fi

    if (( ! json )); then
        backup_run
        return $?
    fi
    backup_run
    local rc=$?
    backup_emit_json "$rc"
    return "$rc"
}

backup_run() {
    section "Backup"

    step "Creating verified backup"
    local path
    path=$(make_backup "manual") || return 1
    prune_backups

    BACKUP_RESULT="$path"
    success "Backup created and verified"
    kv "File" "${path##*/}"
    kv "Size" "$(du -h "$path" 2>/dev/null | cut -f1)"
    kv "Scope" "Full vault (including .git)"
    kv "Location" "$BACKUP_DIR"
    return 0
}

BACKUP_RESULT=""

##
# Emit the machine-readable backup result. Called only from cmd_backup /
# with_lock in --json mode: SILENT_UI (set in main()) guarantees this
# document is the ONLY thing on stdout.
#
# Shape (stable — see README "Machine-Readable Backups & Diagnostics"):
#   { version, command: "backup", result: "ok"|"error",
#     backup: { name, path, size_bytes, sidecar, sidecar_ok }|null,
#     elapsed_seconds, error: {code, message}|null }
# Exit codes match human mode: 0 ok, 1 failed, 2 lock busy.
##
backup_emit_json() {
    local rc="$1"
    local j_result='"ok"' j_backup="null" j_error="null"

    if (( rc == 0 )) && [[ -n "$BACKUP_RESULT" && -f "$BACKUP_RESULT" ]]; then
        local sc="false" sc_ok="null"
        if [[ -f "${BACKUP_RESULT}.sha256" ]]; then
            sc="true"
            if verify_sidecar "$BACKUP_RESULT"; then sc_ok="true"; else sc_ok="false"; fi
        fi
        j_backup=$(printf '{ "name": "%s", "path": "%s", "size_bytes": %s, "sidecar": %s, "sidecar_ok": %s }' \
            "$(json_escape "${BACKUP_RESULT##*/}")" \
            "$(json_escape "$BACKUP_RESULT")" \
            "$(file_size_of "$BACKUP_RESULT")" "$sc" "$sc_ok")
    else
        j_result='"error"'
        j_error=$(printf '{ "code": "%s", "message": "%s" }' \
            "$(json_escape "${SYNC_ERR_CODE:-backup_failed}")" \
            "$(json_escape "${SYNC_ERR_MSG:-backup failed}")")
    fi

    printf '{\n'
    printf '  "version": "%s",\n' "$VERSION"
    printf '  "command": "backup",\n'
    printf '  "result": %s,\n' "$j_result"
    printf '  "backup": %s,\n' "$j_backup"
    printf '  "elapsed_seconds": %s,\n' "$(( SECONDS - SYNC_T0 ))"
    printf '  "error": %s\n' "$j_error"
    printf '}\n'
    return 0
}

VERIFY_ROWS=()          # tab-separated: status, name, size_bytes, sidecar, sidecar_ok
VERIFY_TOTAL=0
VERIFY_PASSED=0
VERIFY_FAILED=0

# Rows for `log --json`: field-separated with the ASCII unit separator
# (0x1f) instead of a tab — log messages are free-form user-visible text
# and may legitimately contain tabs, which would corrupt a tab-separated
# accumulator. Control characters never occur in printf'd log lines.
LOG_ROWS=()
LOG_COUNT=0
LOG_REQUESTED=20

##
# Entry point for `ob-sync verify [--json]`. The scan lives in verify_run()
# (human output, byte-identical to the pre-9.0.0 command); --json mode
# collects one row per archive and emits the machine-readable document.
# Read-only in both modes — verify never takes the lock, so a scheduled
# audit can safely run while a sync is in progress.
#
#   usage:  cmd_verify [--json] [-y]      (-y accepted as a no-op)
##
cmd_verify() {
    SYNC_T0=$SECONDS
    local json=0
    while (( $# )); do
        case "$1" in
            --json)     json=1 ;;
            # -y is a no-op here (verify never prompts) but accepted so that
            # `ob-sync verify -y` keeps working like `sync -y` muscle memory.
            -y|--yes)   : ;;
            *)  error "Unknown option for verify: $1"
                warn "Usage: ob-sync verify [--json] [-y]"
                return 1 ;;
        esac
        shift
    done

    if (( ! json )); then
        verify_run
        return $?
    fi

    verify_run
    local rc=$?
    verify_emit_json "$rc"
    return "$rc"
}

verify_run() {
    section "Backup Verification"

    local -a archives=()
    local a
    while IFS= read -r -d '' a; do
        archives+=("$a")
    done < <(find "$BACKUP_DIR" -maxdepth 1 -name '*.tar.gz' -type f -print0 2>/dev/null \
                | sort -z)

    if (( ${#archives[@]} == 0 )); then
        info "No backups found in: $BACKUP_DIR"
        return 0
    fi

    local archive name ok
    VERIFY_TOTAL=${#archives[@]}
    VERIFY_PASSED=0
    VERIFY_FAILED=0

    for archive in "${archives[@]}"; do
        name=${archive##*/}
        ok=1

        # Sidecar state (JSON reports it per archive; human output only
        # fails the archive on a MISMATCH — a missing sidecar still passes,
        # exactly as the pre-9.0.0 behavior).
        local sidecar="false" sidecar_ok="null"
        if [[ -f "${archive}.sha256" ]]; then
            sidecar="true"
            if verify_sidecar "$archive"; then
                sidecar_ok="true"
            else
                sidecar_ok="false"
                ok=0
            fi
        fi

        # Full stream read — catches truncated archives.
        run_local_timeout tar -tzf "$archive" >/dev/null 2>&1 || ok=0

        local status="ok"
        if (( ok )); then
            VERIFY_PASSED=$((VERIFY_PASSED + 1))
            (( SILENT_UI )) || printf '  %s[ OK ]%s %s\n' "$C_BRIGHT_GREEN" "$C_RESET" "$name"
        else
            status="corrupt"
            VERIFY_FAILED=$((VERIFY_FAILED + 1))
            (( SILENT_UI )) || printf '  %s[FAIL]%s %s\n' "$C_BRIGHT_RED" "$C_RESET" "$name"
        fi

        VERIFY_ROWS+=("$(printf '%s\t%s\t%s\t%s\t%s' \
            "$status" "$name" "$(file_size_of "$archive")" "$sidecar" "$sidecar_ok")")
    done

    # Cosmetic separator before the summary — suppressed in machine mode
    # so the JSON document stays byte-pure on stdout.
    (( SILENT_UI )) || echo
    if (( VERIFY_FAILED == 0 )); then
        success "All $VERIFY_TOTAL backup(s) passed verification"
        return 0
    fi

    error "$VERIFY_FAILED of $VERIFY_TOTAL backup(s) failed verification"
    return 1
}

##
# Emit the machine-readable verification report. Called only from
# cmd_verify in --json mode: SILENT_UI (set in main()) guarantees this
# document is the ONLY thing on stdout.
#
# Shape (stable — see README "Machine-Readable Backups & Diagnostics"):
#   { version, command: "verify", result: "ok"|"error", backup_dir,
#     total, passed, failed,
#     archives: [ { name, status: "ok"|"corrupt", size_bytes,
#                   sidecar: true|false, sidecar_ok: true|false|null } ],
#     elapsed_seconds, error: {code, message}|null }
# sidecar_ok is null when the archive has no .sha256 sidecar (which is
# NOT a failure — mirrors the human contract), true/false after a real
# checksum comparison. Exit codes match human mode: 0 all verified (or
# nothing to verify), 1 at least one corrupt archive.
##
verify_emit_json() {
    local rc="$1"
    local j_result='"ok"' j_error="null"
    if (( rc != 0 )); then
        j_result='"error"'
        j_error=$(printf '{ "code": "verification_failed", "message": "%s of %s backup(s) failed verification" }' \
            "$VERIFY_FAILED" "$VERIFY_TOTAL")
    fi

    printf '{\n'
    printf '  "version": "%s",\n' "$VERSION"
    printf '  "command": "verify",\n'
    printf '  "result": %s,\n' "$j_result"
    printf '  "backup_dir": "%s",\n' "$(json_escape "$BACKUP_DIR")"
    printf '  "total": %s,\n' "$VERIFY_TOTAL"
    printf '  "passed": %s,\n' "$VERIFY_PASSED"
    printf '  "failed": %s,\n' "$VERIFY_FAILED"
    printf '  "archives": [\n'
    local i=0 sep row status name size sidecar sidecar_ok
    for row in "${VERIFY_ROWS[@]}"; do
        IFS=$'\t' read -r status name size sidecar sidecar_ok <<< "$row"
        if (( i == ${#VERIFY_ROWS[@]} - 1 )); then sep=""; else sep=","; fi
        printf '    { "name": "%s", "status": "%s", "size_bytes": %s, "sidecar": %s, "sidecar_ok": %s }%s\n' \
            "$(json_escape "$name")" "$status" "$size" "$sidecar" "$sidecar_ok" "$sep"
        i=$((i + 1))
    done
    printf '  ],\n'
    printf '  "elapsed_seconds": %s,\n' "$(( SECONDS - SYNC_T0 ))"
    printf '  "error": %s\n' "$j_error"
    printf '}\n'
    return 0
}

##
# Parse restore's per-command flags and the positional target. Kept
# separate so the mode logic in cmd_restore stays readable.
#
#   ob-sync restore [--list [--json] | --dry-run | --json <target> -y]
#
# --json is a rendering mode for BOTH read-only flows (with --list:
# inventory / per-archive preview) and the destructive apply flow
# (result document for scripted DR drills). Unknown flags are hard
# errors — restore is destructive by default.
##
RESTORE_MODE="apply"          # apply | list | dry-run
RESTORE_TARGET=""
RESTORE_PICK_RESULT=""
RESTORE_JSON=0                # 1 = emit machine-readable JSON

# Apply-mode result-document state (reset per invocation — the menu can
# dispatch restore twice in one process). RESTORE_SC/RESTORE_SC_OK
# mirror the archive's sidecar state at the moment the flow last touched
# it: "null" means a sidecar exists but was never checked (or none
# exists), so the document never claims a verification it did not run.
RESTORE_T0=0
RESTORE_ERR_CODE=""
RESTORE_ERR_MSG=""
RESTORE_ARCHIVE=""
RESTORE_SAFETY=""
RESTORE_PREVIOUS=""
RESTORE_SC="false"
RESTORE_SC_OK="null"

restore_reset_state() {
    RESTORE_T0=$SECONDS
    RESTORE_ERR_CODE=""
    RESTORE_ERR_MSG=""
    RESTORE_ARCHIVE=""
    RESTORE_SAFETY=""
    RESTORE_PREVIOUS=""
    RESTORE_SC="false"
    RESTORE_SC_OK="null"
}

restore_parse_args() {
    RESTORE_MODE="apply"
    RESTORE_TARGET=""
    RESTORE_JSON=0
    restore_reset_state
    local -a pos=()
    while (( $# > 0 )); do
        case "$1" in
            -y|--yes)   ASSUME_YES=1; shift ;;
            --list)     RESTORE_MODE="list"; shift ;;
            --dry-run)  RESTORE_MODE="dry-run"; shift ;;
            --json)     RESTORE_JSON=1; shift ;;
            --)         shift; pos+=("$@"); break ;;
            -*)         error "Unknown restore option: $1"
                        warn "Valid options: --list, --dry-run, --json, -y"
                        return 1 ;;
            *)          pos+=("$1"); shift ;;
        esac
    done
    if (( ${#pos[@]} > 1 )); then
        # Fail-closed like backup/verify: a stray extra argument used to
        # be silently ignored while the FIRST positional still drove a
        # destructive restore.
        error "Unexpected extra argument: ${pos[1]}"
        warn "Usage: ob-sync restore [options] [target]"
        return 1
    fi
    RESTORE_TARGET="${pos[0]:-}"
    if (( RESTORE_JSON )) && [[ "$RESTORE_MODE" == "dry-run" ]]; then
        # A machine-readable rehearsal already exists: the --list preview
        # runs the exact verification pipeline of a dry-run.
        error "--json is not available with --dry-run"
        warn "Machine-readable preview: ob-sync restore --list --json <target>"
        return 1
    fi
    return 0
}

##
# Render the numbered backup table (shared by the interactive pick and
# `restore --list` without a target).
##
restore_list_backups() {
    echo "  Available backups (newest first):"
    local a i=1
    for a in "$@"; do
        printf '    %s%2d)%s %s %s(%s)%s\n' \
            "$C_CYAN" "$i" "$C_RESET" "${a##*/}" \
            "$C_DIM" "$(du -h "$a" 2>/dev/null | cut -f1)" "$C_RESET"
        i=$((i + 1))
    done
}

##
# Interactive backup selection. Sets RESTORE_PICK_RESULT on success.
##
restore_pick_backup() {
    local -a archives=("$@")
    restore_list_backups "${archives[@]}"
    echo
    local choice=""
    read -r -p "  Select backup [1]: " choice || :
    choice=${choice:-1}
    if [[ "$choice" =~ ^[0-9]+$ ]]; then
        # Base-10 force: a zero-padded pick ("010") would otherwise be
        # parsed as octal in the arithmetic context and select #8.
        local pick=$((10#$choice))
        if (( pick >= 1 && pick <= ${#archives[@]} )); then
            RESTORE_PICK_RESULT=${archives[pick - 1]}
            return 0
        fi
    fi
    error "Invalid selection: $choice"
    return 1
}

##
# Read-only archive inspection shared by --list and --dry-run. Verifies
# the stream and the checksum sidecar, audits every member, then renders
# a contents summary. Nothing is ever extracted.
##
restore_preview() {
    local archive="$1"

    step "Verifying archive integrity"
    # One decompression of each listing (see tar_listing_cache) serves
    # the integrity gate, the member audit and the statistics below —
    # the pre-9.2.1 preview re-read the same stream six times.
    local prc=0
    tar_listing_cache "$archive" || prc=$?
    if (( prc == 124 )); then
        error "Listing timed out after ${LOCAL_TIMEOUT}s (OBS_LOCAL_TIMEOUT) — archive too large or disk too slow"
        return 1
    elif (( prc != 0 )); then
        error "Archive is unreadable or corrupt"
        return 1
    fi
    if [[ -f "${archive}.sha256" ]]; then
        if verify_sidecar "$archive"; then
            success "Checksum sidecar valid (sha256)"
        else
            error "Checksum mismatch — archive may be corrupted"
            return 1
        fi
    else
        # No sidecar to verify against: the stream check above is the
        # only integrity signal that ran (9.2.1 — the line used to
        # claim a checksum verification that never happened).
        info "No checksum sidecar — stream integrity verified only"
    fi

    step "Auditing archive members"
    check_archive_safe "$archive" || return 1

    # Member statistics: counts from the plain listing, file/dir split
    # from the verbose type flag (first character of every -tv line).
    local members=0 notes=0 files=0 dirs=0 entry line
    while IFS= read -r entry; do
        [[ -z "$entry" ]] && continue
        members=$((members + 1))
        [[ "${entry##*/}" == *.md ]] && notes=$((notes + 1))
    done < "$TAR_CACHE_NAMES"
    while IFS= read -r line; do
        case "$line" in
            -*) files=$((files + 1)) ;;
            d*) dirs=$((dirs + 1)) ;;
        esac
    done < "$TAR_CACHE_TYPES"
    success "All members audited — nothing suspicious"

    echo
    kv "Archive" "${archive##*/}"
    kv "Location" "$(dirname "$archive")"
    kv "Size" "$(du -h "$archive" 2>/dev/null | cut -f1) (compressed)"
    kv "Members" "$files file(s), $dirs directories"
    kv "Notes" "$notes markdown note(s)"
    kv "Full listing" "tar -tzf '${archive##*/}'"

    # Top-level layout — the 10-second sanity check before a full restore.
    local top
    top=$(sed 's|^\./||' "$TAR_CACHE_NAMES" | cut -d/ -f1 | sort -u | head -n 12)
    if [[ -n "$top" ]]; then
        echo
        printf '  %s%s%s\n' "$C_BOLD" "Top level" "$C_RESET"
        local t
        while IFS= read -r t; do
            [[ -n "$t" ]] && printf '    %s\n' "$t"
        done <<< "$top"
    fi
    return 0
}

##
# Machine-readable backup inventory: `restore --list --json` without a
# target. Emits the backup directory as a JSON document (newest first,
# same ordering as list_backups_desc). sidecar_ok is null when no
# checksum sidecar exists — otherwise it is the real verify result.
# Always exits 0: an empty inventory (count 0) is valid data, not an
# error, for a monitoring consumer.
##
restore_json_inventory() {
    local -a archives=()
    local a
    while IFS= read -r -d '' a; do
        archives+=("$a")
    done < <(list_backups_desc)

    printf '{\n'
    printf '  "directory": "%s",\n' "$(json_escape "$BACKUP_DIR")"
    printf '  "count": %d,\n' "${#archives[@]}"
    printf '  "backups": [\n'
    local i=0 sep name ts mkey mtime sc sc_ok m
    for a in "${archives[@]}"; do
        name="${a##*/}"
        ts="null"
        if [[ "$name" =~ ([0-9]{8}-[0-9]{6}) ]]; then
            ts="\"${BASH_REMATCH[1]}\""
        fi
        # mtime_key_of is zero-padded and nanosecond-precise; collapse it
        # to plain epoch seconds (null when the platform could not stat).
        mtime="null"
        mkey=$(mtime_key_of "$a")
        if [[ "$mkey" =~ ^[0-9]+\. ]]; then
            m=$((10#${mkey%%.*}))
            (( m > 0 )) && mtime="$m"
        fi
        sc="false"
        sc_ok="null"
        if [[ -f "${a}.sha256" ]]; then
            sc="true"
            if verify_sidecar "$a"; then sc_ok="true"; else sc_ok="false"; fi
        fi
        if (( i == ${#archives[@]} - 1 )); then sep=""; else sep=","; fi
        printf '    { "name": "%s", "path": "%s", "size_bytes": %s, "timestamp": %s, "mtime": %s, "sidecar": %s, "sidecar_ok": %s }%s\n' \
            "$(json_escape "$name")" \
            "$(json_escape "$a")" \
            "$(file_size_of "$a")" \
            "$ts" "$mtime" "$sc" "$sc_ok" "$sep"
        i=$((i + 1))
    done
    printf '  ]\n'
    printf '}\n'
    return 0
}

##
# Machine-readable archive preview: `restore --list --json <target>`.
# Runs the exact verification pipeline of restore_preview — stream read,
# sidecar checksum, tar-slip member audit — but renders JSON instead of
# tables. Verification failures emit a {"error": ...} document (rc 1),
# so a consumer can always parse stdout.
##
restore_json_preview() {
    local archive="$1"
    local j_err=""

    # tar_listing_cache decompresses each listing ONCE (the pre-9.2.1
    # preview re-read the stream six times) and doubles as the
    # integrity gate for the error document below.
    local prc=0
    tar_listing_cache "$archive" || prc=$?
    if (( prc == 124 )); then
        j_err="listing timed out after ${LOCAL_TIMEOUT}s (OBS_LOCAL_TIMEOUT)"
    elif (( prc != 0 )); then
        j_err="archive is unreadable or corrupt"
    elif ! verify_sidecar "$archive"; then
        j_err="checksum mismatch — archive may be corrupted"
    elif ! check_archive_safe "$archive"; then
        j_err="archive members failed the safety audit (tar-slip guard)"
    fi
    if [[ -n "$j_err" ]]; then
        printf '{ "error": "%s", "archive": "%s" }\n' \
            "$(json_escape "$j_err")" "$(json_escape "${archive##*/}")"
        return 1
    fi

    # Member statistics — same counting rules as restore_preview: the
    # plain listing gives totals/notes, the verbose type flag splits
    # files from directories.
    local members=0 notes=0 files=0 dirs=0 entry line
    while IFS= read -r entry; do
        [[ -z "$entry" ]] && continue
        members=$((members + 1))
        [[ "${entry##*/}" == *.md ]] && notes=$((notes + 1))
    done < "$TAR_CACHE_NAMES"
    while IFS= read -r line; do
        case "$line" in
            -*) files=$((files + 1)) ;;
            d*) dirs=$((dirs + 1)) ;;
        esac
    done < "$TAR_CACHE_TYPES"

    local sc="false" sc_ok="null"
    if [[ -f "${archive}.sha256" ]]; then
        sc="true"
        if verify_sidecar "$archive"; then sc_ok="true"; else sc_ok="false"; fi
    fi

    local -a top=()
    local t
    while IFS= read -r t; do
        [[ -n "$t" ]] && top+=("$t")
    done < <(sed 's|^\./||' "$TAR_CACHE_NAMES" | cut -d/ -f1 | sort -u | head -n 12)

    printf '{\n'
    printf '  "archive": { "name": "%s", "path": "%s", "size_bytes": %s, "sidecar": %s, "sidecar_ok": %s },\n' \
        "$(json_escape "${archive##*/}")" \
        "$(json_escape "$archive")" \
        "$(file_size_of "$archive")" "$sc" "$sc_ok"
    printf '  "members": %d,\n' "$members"
    printf '  "files": %d,\n' "$files"
    printf '  "directories": %d,\n' "$dirs"
    printf '  "notes": %d,\n' "$notes"
    printf '  "top_level": [\n'
    local i sep
    for ((i = 0; i < ${#top[@]}; i++)); do
        if (( i == ${#top[@]} - 1 )); then sep=""; else sep=","; fi
        printf '    "%s"%s\n' "$(json_escape "${top[i]}")" "$sep"
    done
    printf '  ]\n'
    printf '}\n'
    return 0
}

##
# Render the resolved archive as an embedded JSON object from the
# apply-flow state (RESTORE_ARCHIVE + RESTORE_SC/RESTORE_SC_OK).
##
restore_archive_json() {
    printf '{ "name": "%s", "path": "%s", "size_bytes": %s, "sidecar": %s, "sidecar_ok": %s }' \
        "$(json_escape "${RESTORE_ARCHIVE##*/}")" \
        "$(json_escape "$RESTORE_ARCHIVE")" \
        "$(file_size_of "$RESTORE_ARCHIVE")" \
        "$RESTORE_SC" "$RESTORE_SC_OK"
}

##
# Emit the apply-mode result document. Called only from the apply flow
# and the with_lock lock-busy branch in --json mode: SILENT_UI (set in
# main()) guarantees this document is the ONLY thing on stdout.
#
# Shape (stable — see README "Machine-Readable Backups"):
#   { version, command: "restore", mode: "apply", result: "ok"|"error",
#     target: string|null, vault,
#     archive: { name, path, size_bytes, sidecar, sidecar_ok }|null,
#     safety_backup: string|null, previous_vault: string|null,
#     elapsed_seconds, error: {code,message}|null }
# Exit code mirrors the human contract: 0 restored, 1 any failure,
# 2 lock contention.
##
restore_emit_apply() {
    local rc="$1"
    local j_result='"error"' j_error="null" j_archive="null"
    local j_safety="null" j_prev="null" j_target="null"
    if (( rc == 0 )); then j_result='"ok"'; fi
    [[ -n "${RESTORE_ERR_CODE:-}" ]] && \
        j_error="{ \"code\": \"$(json_escape "$RESTORE_ERR_CODE")\", \"message\": \"$(json_escape "${RESTORE_ERR_MSG:-restore failed}")\" }"
    [[ -n "${RESTORE_ARCHIVE:-}" ]] && j_archive=$(restore_archive_json)
    [[ -n "${RESTORE_SAFETY:-}" ]] && j_safety="\"$(json_escape "$RESTORE_SAFETY")\""
    [[ -n "${RESTORE_PREVIOUS:-}" ]] && j_prev="\"$(json_escape "$RESTORE_PREVIOUS")\""
    [[ -n "${RESTORE_TARGET:-}" ]] && j_target="\"$(json_escape "$RESTORE_TARGET")\""

    printf '{\n'
    printf '  "version": "%s",\n' "$VERSION"
    printf '  "command": "restore",\n'
    printf '  "mode": "apply",\n'
    printf '  "result": %s,\n' "$j_result"
    printf '  "target": %s,\n' "$j_target"
    printf '  "vault": "%s",\n' "$(json_escape "$VAULT")"
    printf '  "archive": %s,\n' "$j_archive"
    printf '  "safety_backup": %s,\n' "$j_safety"
    printf '  "previous_vault": %s,\n' "$j_prev"
    printf '  "elapsed_seconds": %d,\n' "$(( SECONDS - RESTORE_T0 ))"
    printf '  "error": %s\n' "$j_error"
    printf '}\n'
    return 0
}

##
# Fail the apply flow with a stable machine code. Human mode keeps the
# exact error line the pre-9.1.0 command printed (error "$2"); JSON mode
# additionally answers with the parseable failure document.
##
restore_fail() {
    local code="$1" msg="$2"
    RESTORE_ERR_CODE="$code"
    RESTORE_ERR_MSG="$msg"
    error "$msg"
    if (( RESTORE_JSON )); then
        restore_emit_apply 1
    fi
    return 1
}

##
# Same contract as restore_fail, for the failure points where the
# specific error line was ALREADY printed by a helper (e.g. the
# tar-slip audit names the offending member) — human output must not
# grow a second, generic FAIL line.
##
restore_fail_quiet() {
    RESTORE_ERR_CODE="$1"
    RESTORE_ERR_MSG="$2"
    if (( RESTORE_JSON )); then
        restore_emit_apply 1
    fi
    return 1
}

cmd_restore() {
    restore_parse_args "$@" || return 1

    # JSON mode must own stdout exclusively — no section banners, no
    # info lines (SILENT_UI in main() already suppresses info/warn).
    if (( ! RESTORE_JSON )); then
        if [[ "$RESTORE_MODE" == "apply" ]]; then
            section "Restore Vault"
        else
            section "Backup Preview"
            [[ "$RESTORE_MODE" == "dry-run" ]] && \
                info "Dry-run mode — nothing will be modified"
        fi
    fi

    # Newest first, by embedded timestamp — NOT by raw filename order
    # (prefixes would otherwise shadow chronology; see list_backups_desc).
    local -a archives=()
    local a
    while IFS= read -r -d '' a; do
        archives+=("$a")
    done < <(list_backups_desc)

    if (( ${#archives[@]} == 0 )); then
        if (( RESTORE_JSON )); then
            if [[ "$RESTORE_MODE" == "apply" ]]; then
                # Scripted DR drill against an empty backup directory:
                # parseable failure, same message the human command prints.
                restore_fail "no_backups" "No backups found in: $BACKUP_DIR"
                return 1
            fi
            # No target: an empty inventory is valid data (count 0, rc 0).
            # With a target there is nothing to preview — fail parseably.
            if [[ -z "$RESTORE_TARGET" ]]; then
                restore_json_inventory
                return $?
            fi
            printf '{ "error": "no backups found", "directory": "%s" }\n' \
                "$(json_escape "$BACKUP_DIR")"
            return 1
        fi
        error "No backups found in: $BACKUP_DIR"
        return 1
    fi

    # Resolve the target: interactive pick, 'latest', a name, or a full path.
    local archive=""

    if [[ -z "$RESTORE_TARGET" ]]; then
        # JSON apply mode is fail-closed: no implicit "latest" guess — a
        # scripted restore must name exactly what it wants replaced.
        if (( RESTORE_JSON )); then
            if [[ "$RESTORE_MODE" == "apply" ]]; then
                restore_fail "target_required" "restore --json (apply mode) requires a target: 'latest', an archive name, or a path"
                return 1
            fi
            restore_json_inventory
            return $?
        fi
        # `--list` without a target and without a terminal: a plain
        # inventory of the backup directory is the most useful answer.
        if [[ "$RESTORE_MODE" == "list" && ! -t 0 ]]; then
            restore_list_backups "${archives[@]}"
            return 0
        fi
        # A destructive restore must never run unattended: without an
        # explicit target or explicit consent, refuse instead of guessing.
        if (( ! ASSUME_YES )); then
            if [[ ! -t 0 ]]; then
                error "Non-interactive session — specify a target: ob-sync restore latest | <file>"
                return 1
            fi
            restore_pick_backup "${archives[@]}" || return 1
            archive=$RESTORE_PICK_RESULT
        else
            archive=${archives[0]}
            info "No backup specified — using the latest"
        fi
    elif [[ "$RESTORE_TARGET" == "latest" ]]; then
        archive=${archives[0]}
    elif [[ -f "$RESTORE_TARGET" ]]; then
        archive=$RESTORE_TARGET
    elif [[ -f "$BACKUP_DIR/$RESTORE_TARGET" ]]; then
        archive="$BACKUP_DIR/$RESTORE_TARGET"
    else
        if (( RESTORE_JSON )); then
            if [[ "$RESTORE_MODE" == "apply" ]]; then
                restore_fail "backup_not_found" "Backup not found: $RESTORE_TARGET"
                return 1
            fi
            printf '{ "error": "backup not found", "target": "%s" }\n' \
                "$(json_escape "$RESTORE_TARGET")"
            return 1
        fi
        error "Backup not found: $RESTORE_TARGET"
        return 1
    fi

    # The apply-mode document reports exactly which archive the run
    # resolved, even when a later stage (consent, checksum, extraction)
    # fails — an operator can tell WHAT was about to be restored.
    RESTORE_ARCHIVE="$archive"
    if [[ -f "${archive}.sha256" ]]; then
        RESTORE_SC="true"   # sidecar_ok stays null until actually verified
    fi

    # ---- Preview modes (read-only): show, then stop ---------------------
    if (( RESTORE_JSON )) && [[ "$RESTORE_MODE" != "apply" ]]; then
        restore_json_preview "$archive"
        return $?
    fi
    if [[ "$RESTORE_MODE" != "apply" ]]; then
        restore_preview "$archive" || return 1

        if [[ "$RESTORE_MODE" == "dry-run" ]]; then
            echo
            info "Execution plan (NOT executed):"
            local n=1
            if [[ -d "$VAULT" ]]; then
                printf '    %s%d.%s create a verified safety backup of the current vault\n' \
                    "$C_BOLD" "$n" "$C_RESET"
                n=$((n + 1))
            fi
            printf '    %s%d.%s extract %s into a staging directory\n' \
                "$C_BOLD" "$n" "$C_RESET" "${archive##*/}"
            n=$((n + 1))
            printf '    %s%d.%s re-scan the extracted files for symlinks (tar-slip defence)\n' \
                "$C_BOLD" "$n" "$C_RESET"
            n=$((n + 1))
            printf '    %s%d.%s atomically swap the staging directory into %s\n' \
                "$C_BOLD" "$n" "$C_RESET" "$VAULT"
            n=$((n + 1))
            printf '    %s%d.%s keep the previous vault next to it (.pre-restore-<timestamp>)\n' \
                "$C_BOLD" "$n" "$C_RESET"
            echo
            success "Dry-run complete — the vault was not modified"
        else
            success "Preview complete — run without --list to restore"
        fi
        return 0
    fi

    # ---- Apply mode ------------------------------------------------------
    # JSON mode cannot prompt: consent must arrive via -y (before or
    # after the command). Fail closed BEFORE any verification work — a
    # scripted restore without consent gets its refusal in one round trip.
    if (( RESTORE_JSON )) && (( ! ASSUME_YES )); then
        restore_fail "consent_required" "restore --json requires -y — JSON mode cannot prompt for consent"
        return 1
    fi

    step "Verifying archive integrity"
    # Build the listing cache here (one -tzf + one -tvf read): the gate
    # keeps its rc contract and check_archive_safe reuses both listings
    # below (the pre-9.2.1 apply flow decompressed the stream three
    # times before extraction).
    local lrc=0
    tar_listing_cache "$archive" || lrc=$?
    if (( lrc == 124 )); then
        # The watchdog killed the listing pass — the archive is not
        # proven corrupt, it is just slow/huge. Report the real cause.
        restore_fail "extraction_timeout" "Listing timed out after ${LOCAL_TIMEOUT}s (OBS_LOCAL_TIMEOUT)"
        return 1
    elif (( lrc != 0 )); then
        restore_fail "archive_corrupt" "Archive is unreadable or corrupt"
        return 1
    fi
    if [[ -f "${archive}.sha256" ]]; then
        if verify_sidecar "$archive"; then
            RESTORE_SC_OK="true"
        else
            RESTORE_SC_OK="false"
            restore_fail "checksum_mismatch" "Checksum mismatch — archive may be corrupted"
            return 1
        fi
    fi
    success "Archive verified: ${archive##*/}"

    # Tar-slip protection: audit every member BEFORE anything is written
    # to disk. Foreign or tampered archives are refused here.
    step "Auditing archive members"
    if ! check_archive_safe "$archive"; then
        # check_archive_safe already printed the offending member —
        # human output must stay unchanged, JSON still gets the code.
        restore_fail_quiet "unsafe_archive" "Archive members failed the safety audit (tar-slip guard)"
        return 1
    fi
    success "All members are safe to extract"

    warn "This will REPLACE the current vault contents"
    if (( ! ASSUME_YES )); then
        if [[ ! -t 0 ]]; then
            # Fail closed: a scripted restore without consent must never
            # report success while the vault was left untouched.
            error "Refusing to restore non-interactively without consent"
            warn "Re-run with -y to proceed, or use --dry-run to preview"
            return 1
        fi
        local answer=""
        read -r -p "  Continue? [y/N]: " answer || :
        [[ "$answer" =~ ^[Yy]$ ]] || { info "Cancelled"; return 1; }
    fi

    if [[ -d "$VAULT" ]]; then
        step "Creating safety backup of the current vault"
        local safety
        safety=$(make_backup "pre-restore") || {
            # make_backup printed the specific reason (disk full, timeout…).
            restore_fail_quiet "safety_backup_failed" "Could not create a safety backup of the current vault"
            return 1
        }
        prune_backups
        RESTORE_SAFETY="${safety##*/}"
        success "Safety backup: $RESTORE_SAFETY"
    fi

    step "Extracting archive"
    local parent staging
    parent=$(dirname "$VAULT")
    mkdir -p "$parent" 2>/dev/null || :
    staging=$(mktemp -d "$parent/.obsidian-restore-XXXXXX") || {
        restore_fail "staging_failed" "Failed to create staging area in: $parent"
        return 1
    }
    temp_register "$staging"

    local xrc=0
    run_local_timeout tar -xzf "$archive" -C "$staging" 2>/dev/null || xrc=$?
    if (( xrc == 124 )); then
        rm -rf -- "$staging"
        restore_fail "extraction_timeout" "Extraction timed out after ${LOCAL_TIMEOUT}s (OBS_LOCAL_TIMEOUT)"
        return 1
    fi
    if (( xrc != 0 )); then
        rm -rf -- "$staging"
        restore_fail "extraction_failed" "Extraction failed"
        return 1
    fi

    # Defence in depth: even though check_archive_safe refuses symlinks,
    # scan the result too, in case a listing trick evaded line-based
    # parsing (e.g. a filename containing a newline).
    if [[ -n "$(find "$staging" -type l -print -quit 2>/dev/null)" ]]; then
        rm -rf -- "$staging"
        restore_fail "symlink_detected" "A symlink materialized during extraction — restore refused"
        return 1
    fi

    step "Swapping vault into place"
    local old=""
    if [[ -d "$VAULT" ]]; then
        # Collision guard (9.1.0): two restores in the same second used to
        # aim at the same .pre-restore-<ts> name — mv then failed (target
        # dir non-empty) or silently nested the old vault inside it. The
        # guard mirrors make_backup's same-second suffix loop.
        local base_ts n=0
        base_ts=$(date '+%Y%m%d-%H%M%S')
        old="${VAULT}.pre-restore-${base_ts}"
        while [[ -e "$old" ]]; do
            n=$((n + 1))
            old="${VAULT}.pre-restore-${base_ts}-${n}"
        done
        mv "$VAULT" "$old" 2>/dev/null || {
            rm -rf -- "$staging"
            restore_fail "swap_failed" "Failed to move the current vault aside"
            return 1
        }
    fi

    if mv "$staging" "$VAULT" 2>/dev/null; then
        success "Vault restored from: ${archive##*/}"
    else
        RESTORE_ERR_CODE="swap_failed"
        RESTORE_ERR_MSG="Failed to install restored vault"
        error "Failed to install restored vault"
        if (( RESTORE_JSON )); then restore_emit_apply 1; fi
        [[ -n "$old" ]] && mv "$old" "$VAULT" 2>/dev/null
        rm -rf -- "$staging"
        return 1
    fi

    RESTORE_PREVIOUS="$old"
    if [[ -n "$old" ]]; then
        info "Previous vault preserved at: $old"
        info "Delete it manually after verifying the restore"
    fi

    log "Vault restored from: ${archive##*/}"
    if (( RESTORE_JSON )); then restore_emit_apply 0; fi
    return 0
}

cmd_repair() {
    section "Repository Repair"

    warn "This rebuilds the git metadata from the remote"
    info "Vault files are never modified or deleted"
    info "A verified backup is created before anything changes"
    echo

    if (( ! ASSUME_YES )) && [[ "${1:-}" != "-y" ]]; then
        # A destructive repair must never run unattended: without a
        # terminal to confirm on, default to cancelling.
        if [[ ! -t 0 ]]; then
            info "Non-interactive session — rerun with: ob-sync repair -y"
            return 0
        fi
        local answer=""
        read -r -p "  Continue? [y/N]: " answer || :
        [[ "$answer" =~ ^[Yy]$ ]] || { info "Cancelled"; return 0; }
    fi

    # Remove artifacts from any previously interrupted repair attempt.
    rm -rf -- "$BACKUP_DIR"/repair-* 2>/dev/null
    clean_repair_artifacts

    step "Preparing a verified clone (non-destructive)"
    local candidate
    if ! candidate=$(prepare_repair); then
        return 1
    fi
    success "Candidate repository is ready"

    step "Executing atomic metadata swap"
    execute_repair "$candidate" || return 1

    step "Validating repaired repository"
    if check_repo_safe; then
        configure_repo
        ensure_identity
        success "Repository verified and configured"
        info "Commits: $(g rev-list --count HEAD 2>/dev/null || printf '?')"
        info "Pending differences will be committed on the next sync"
        log "Repair completed"
        return 0
    fi

    error "Post-repair validation failed — inspect: $VAULT/.git"
    return 1
}

##
# Pure information command: never hard-fails. Each section degrades
# gracefully — the vault and backup overviews render even without git
# installed and even without a vault present.
##
cmd_status() {
    if (( $# > 0 )); then
        case "$1" in
            --json) cmd_status_json; return 0 ;;
            *)      error "Unknown status option: $1"
                    warn "Usage: ob-sync status [--json]"
                    return 1 ;;
        esac
    fi

    section "Vault Status"

    local has_git=0
    command -v git >/dev/null 2>&1 && has_git=1

    # ---- Vault section: no git required --------------------------------
    echo "  ${C_BOLD}${C_CYAN}Vault${C_RESET}"
    if [[ -d "$VAULT" ]]; then
        kv "Path" "$VAULT"
        kv "Notes" "$(find "$VAULT" -name '*.md' -not -path '*/.git/*' 2>/dev/null | wc -l | tr -d ' ')"
        kv "Size" "$(vault_size)"
    else
        kv "Path" "$VAULT"
        kv "Status" "missing ${C_DIM}(run: ob-sync init)${C_RESET}"
    fi

    # ---- Git section: degrades gracefully -------------------------------
    echo
    echo "  ${C_BOLD}${C_CYAN}Git${C_RESET}"
    if (( has_git )) && [[ -d "$VAULT/.git" ]]; then
        kv "Branch" "$(g branch --show-current 2>/dev/null || printf 'unknown')"
        kv "Remote" "$(g remote get-url origin 2>/dev/null || printf 'not configured')"
        if [[ -r "$VAULT/.ob-sync/config" ]]; then
            kv "Identity" ".ob-sync/config ${C_DIM}(travels with the vault)${C_RESET}"
        else
            kv "Identity" "none ${C_DIM}(written on the next sync)${C_RESET}"
        fi
        kv "Changes" "$(g status --porcelain 2>/dev/null | wc -l | tr -d ' ') file(s)"
        kv "Last commit" "$(g log -1 --format='%h %s (%cr)' 2>/dev/null || printf 'none')"

        local counts behind=0 ahead=0
        if remote_branch_exists; then
            if counts=$(g rev-list --left-right --count "origin/$BRANCH...HEAD" 2>/dev/null); then
                read -r behind ahead <<< "$counts"
                kv "Behind remote" "$behind commit(s) ${C_DIM}(as of last fetch)${C_RESET}"
                kv "Ahead of remote" "$ahead commit(s)"
            fi
        fi
    elif [[ -d "$VAULT/.git" ]]; then
        kv "Repository" "present ${C_DIM}(git not installed — see doctor)${C_RESET}"
    elif (( has_git )); then
        kv "Repository" "not initialized ${C_DIM}(run: ob-sync init)${C_RESET}"
    else
        kv "Repository" "unknown ${C_DIM}(install git to inspect)${C_RESET}"
    fi

    # ---- Backups section: no git required -------------------------------
    echo
    echo "  ${C_BOLD}${C_CYAN}Backups${C_RESET}"
    kv "Total" "$(find "$BACKUP_DIR" -maxdepth 1 -name '*.tar.gz' -type f 2>/dev/null | wc -l | tr -d ' ') (retention: $KEEP_BACKUPS)"
    kv "Location" "$BACKUP_DIR"

    if [[ -f "$STATE_FILE" ]]; then
        echo
        kv "Last sync" "$(cat "$STATE_FILE" 2>/dev/null || printf 'unknown')" "$C_MAGENTA"
    fi
    return 0
}

##
# Machine-readable twin of cmd_status (ob-sync status --json). Stable
# field shape for scripts and dashboards:
#   · all strings are JSON-escaped; booleans/numbers are bare
#   · git.remote / git.last_commit are null when unknown
#   · vault.size_bytes counts file contents only (.git excluded)
#   · ahead/behind reflect the last fetch — no network call is made
# Emits nothing but the JSON document on stdout.
##
cmd_status_json() {
    local has_git=0 repo=0 exists=0
    command -v git >/dev/null 2>&1 && has_git=1
    [[ -d "$VAULT/.git" ]] && repo=1
    [[ -d "$VAULT" ]] && exists=1

    # Vault metrics (same excludes as vault_size: .git out).
    # size_bytes = exact content bytes (cat | wc -c), portable across
    # GNU and BSD — du would report allocated blocks, not content size.
    local notes=0 size_bytes=0
    if (( exists )); then
        notes=$(find "$VAULT" -name '*.md' -not -path '*/.git/*' 2>/dev/null | wc -l | tr -d ' ')
        size_bytes=$(cd "$VAULT" 2>/dev/null \
                     && find . -name .git -prune -o -type f -exec cat {} + 2>/dev/null \
                     | wc -c | tr -d ' ')
        [[ "$notes" =~ ^[0-9]+$ ]] || notes=0
        [[ "$size_bytes" =~ ^[0-9]+$ ]] || size_bytes=0
    fi

    local branch="" remote="" changes=0 ahead=0 behind=0
    local last_hash="" last_subject="" last_date=""
    if (( repo )); then
        # symbolic-ref also answers on an unborn branch, where
        # --show-current prints nothing.
        branch=$(g symbolic-ref --short HEAD 2>/dev/null) || branch="$BRANCH"
        remote=$(g remote get-url origin 2>/dev/null) || remote=""
        changes=$(g status --porcelain 2>/dev/null | wc -l | tr -d ' ')
        [[ "$changes" =~ ^[0-9]+$ ]] || changes=0
        if g rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
            last_hash=$(g log -1 --format='%h' 2>/dev/null)
            last_subject=$(g log -1 --format='%s' 2>/dev/null)
            last_date=$(g log -1 --format='%cr' 2>/dev/null)
        fi
        if remote_branch_exists; then
            local counts
            if counts=$(g rev-list --left-right --count "origin/$BRANCH...HEAD" 2>/dev/null); then
                read -r behind ahead <<< "$counts"
            fi
        fi
    fi
    [[ "$ahead" =~ ^[0-9]+$ ]] || ahead=0
    [[ "$behind" =~ ^[0-9]+$ ]] || behind=0

    local backups
    backups=$(find "$BACKUP_DIR" -maxdepth 1 -name '*.tar.gz' -type f 2>/dev/null | wc -l | tr -d ' ')
    [[ "$backups" =~ ^[0-9]+$ ]] || backups=0

    # Cron scheduling state — pure data, prints nothing, so it is safe
    # under SILENT_UI (status --json owns stdout exclusively).
    local cron_avail="false" cron_sched="false" cron_job=""
    if command -v crontab >/dev/null 2>&1; then
        cron_avail="true"
        local cron_table
        cron_table=$(cron_current_table 2>/dev/null) || cron_table=""
        if grep -qF "$CRON_BEGIN" <<< "$cron_table"; then
            cron_sched="true"
            cron_job=$(cron_block_job_line <<< "$cron_table")
        fi
    fi

    local platform="linux"
    (( IS_TERMUX )) && platform="termux"
    [[ "${OSTYPE:-}" == darwin* ]] && platform="macos"

    local last_sync="null"
    if [[ -r "$STATE_FILE" ]]; then
        last_sync="\"$(json_escape "$(cat "$STATE_FILE" 2>/dev/null)")\""
    fi

    # JSON booleans as literal strings (arithmetic evaluation would treat
    # true/false as variable names — a fatal trap under set -u).
    local j_exists="false" j_installed="false" j_repo="false"
    (( exists ))  && j_exists="true"
    (( has_git )) && j_installed="true"
    (( repo ))    && j_repo="true"

    printf '{\n'
    printf '  "version": "%s",\n' "$VERSION"
    printf '  "platform": "%s",\n' "$platform"
    printf '  "vault": {\n'
    printf '    "path": "%s",\n' "$(json_escape "$VAULT")"
    printf '    "exists": %s,\n' "$j_exists"
    printf '    "notes": %s,\n' "$notes"
    printf '    "size_bytes": %s\n' "$size_bytes"
    printf '  },\n'
    printf '  "git": {\n'
    printf '    "installed": %s,\n' "$j_installed"
    printf '    "initialized": %s,\n' "$j_repo"
    if (( repo )); then
        printf '    "branch": "%s",\n' "$(json_escape "$branch")"
        if [[ -n "$remote" ]]; then
            printf '    "remote": "%s",\n' "$(json_escape "$remote")"
        else
            printf '    "remote": null,\n'
        fi
        printf '    "changes": %s,\n' "$changes"
        if [[ -n "$last_hash" ]]; then
            printf '    "last_commit": { "hash": "%s", "subject": "%s", "date": "%s" },\n' \
                "$(json_escape "$last_hash")" \
                "$(json_escape "$last_subject")" \
                "$(json_escape "$last_date")"
        else
            printf '    "last_commit": null,\n'
        fi
        printf '    "ahead": %s,\n' "$ahead"
        printf '    "behind": %s\n' "$behind"
    else
        printf '    "branch": null,\n'
        printf '    "remote": null,\n'
        printf '    "changes": 0,\n'
        printf '    "last_commit": null,\n'
        printf '    "ahead": 0,\n'
        printf '    "behind": 0\n'
    fi
    printf '  },\n'
    printf '  "backups": { "total": %s, "retention": %s, "directory": "%s" },\n' \
        "$backups" "$KEEP_BACKUPS" "$(json_escape "$BACKUP_DIR")"
    printf '  "watchdogs": { "network_seconds": %s, "local_seconds": %s },\n' \
        "$GIT_TIMEOUT" "$LOCAL_TIMEOUT"
    printf '  "cron": {\n'
    printf '    "available": %s,\n' "$cron_avail"
    printf '    "scheduled": %s,\n' "$cron_sched"
    if [[ -n "$cron_job" ]]; then
        printf '    "job": "%s",\n' "$(json_escape "$cron_job")"
    else
        printf '    "job": null,\n'
    fi
    printf '    "log": "%s"\n' "$(json_escape "$CRON_LOG")"
    printf '  },\n'
    printf '  "config": { "file": "%s", "exists": %s, "vault_source": "%s" },\n' \
        "$(json_escape "$CONFIG_FILE")" \
        "$([[ -r "$CONFIG_FILE" ]] && printf true || printf false)" \
        "$(json_escape "$VAULT_SOURCE")"
    # The vault's own identity card (9.5.0): pure read, no filesystem writes.
    local vc_present="false" vc_remote=""
    [[ -r "$VAULT/.ob-sync/config" ]] && vc_present="true"
    if (( repo )); then
        vc_remote=$(vault_conf_get REMOTE 2>/dev/null) || vc_remote=""
    fi
    printf '  "vault_config": { "path": "%s", "present": %s, "remote": %s },\n' \
        "$(json_escape "$VAULT/.ob-sync/config")" "$vc_present" \
        "$([[ -n "$vc_remote" ]] && printf '"%s"' "$(json_escape "$vc_remote")" || printf null)"
    printf '  "last_sync": %s\n' "$last_sync"
    printf '}\n'
}

HEALTH_ROWS=()          # tab-separated: status, name, message
HEALTH_FAILED=0
HEALTH_ISSUES=0

##
# Entry point for `ob-sync health [--json]`. The check pipeline lives in
# health_run() (human output, byte-identical to the pre-9.0.0 command);
# --json mode collects one row per stage and emits the machine-readable
# document. Read-only in both modes — health never takes the lock and
# never mutates the repository (fsck --connectivity-only is a pure read).
#
#   usage:  cmd_health [--json] [-y]      (-y accepted as a no-op)
##
cmd_health() {
    local json=0
    while (( $# )); do
        case "$1" in
            --json)     json=1 ;;
            # -y is a no-op here (health never prompts) but accepted so that
            # `ob-sync health -y` keeps working like `sync -y` muscle memory.
            -y|--yes)   : ;;
            *)  error "Unknown option for health: $1"
                warn "Usage: ob-sync health [--json] [-y]"
                return 1 ;;
        esac
        shift
    done

    if (( ! json )); then
        health_run
        return $?
    fi

    cmd_health_json
    return $?
}

health_run() {
    section "Health Check"

    # Distinguish a missing binary from a broken repository: without this
    # guard, every git failure below would be misreported as corruption.
    if ! command -v git >/dev/null 2>&1; then
        error "git is not installed"
        warn "Install it with: $(install_hint)"
        return 1
    fi

    step "Checking git repository"
    if [[ -d "$VAULT/.git" ]]; then
        success "Repository exists"
    else
        error "No git repository found"
        warn "Fix: ob-sync init  (or  ob-sync repair)"
        return 1
    fi

    step "Verifying HEAD reference"
    if g rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
        success "HEAD is valid"
    elif g symbolic-ref --quiet HEAD >/dev/null 2>&1; then
        success "HEAD is valid (unborn branch — no commits yet)"
    else
        error "HEAD is corrupted"
        warn "Fix: ob-sync repair"
        return 1
    fi

    step "Checking object database"
    local issues=0
    fsck_object_db
    local fsck_rc=$?
    if (( fsck_rc == 0 )); then
        success "Object database is intact"
    elif (( fsck_rc == 2 )); then
        # Stale remote-tracking ref (git remote-remove quirk) — NOT corruption.
        # Still an issue automation should see, so it counts like a warning.
        warn "Object database is intact, but a stale remote-tracking ref needs cleanup: $FSCK_DETAIL"
        warn "Fix: git update-ref -d $FSCK_DETAIL   (or rebuild with: ob-sync repair)"
        issues=$((issues + 1))
    else
        error "Repository corruption detected"
        warn "Fix: ob-sync repair"
        return 1
    fi

    step "Checking operational state"
    if check_repo_safe; then
        success "Repository is in a safe state"
    else
        warn "Repository is not in a safe state"
        warn "Fix: ob-sync sync (auto-recovers) or ob-sync repair"
        issues=$((issues + 1))
    fi

    step "Checking remote configuration"
    if g remote get-url origin >/dev/null 2>&1; then
        success "Remote 'origin' is configured"
    else
        warn "Remote 'origin' is missing"
        issues=$((issues + 1))
    fi

    step "Checking git identity"
    if [[ -n "$(g config user.email 2>/dev/null)" ]]; then
        success "Git identity is configured"
    else
        warn "No git identity — a fallback will be applied on next commit"
        issues=$((issues + 1))
    fi

    echo
    echo "  ${C_BOLD}${C_GREEN}Statistics${C_RESET}"
    kv "Commits" "$(g rev-list --count HEAD 2>/dev/null || printf '0')"
    kv "Tracked files" "$(g ls-files 2>/dev/null | wc -l | tr -d ' ')"
    kv ".git size" "$(du -sh "$VAULT/.git" 2>/dev/null | cut -f1)"

    local avail
    avail=$(df -Ph "$HOME" 2>/dev/null | awk 'NR==2 {print $4}')
    kv "Free storage" "${avail:-unknown}"

    echo
    if (( issues == 0 )); then
        success "All checks passed"
        return 0
    fi
    warn "$issues issue(s) detected — see above"
    return 1
}

health_row() {
    local status="$1" name="$2" message="$3"
    HEALTH_ROWS+=("$(printf '%s\t%s\t%s' "$status" "$name" "$message")")
    case "$status" in
        fail) HEALTH_FAILED=$((HEALTH_FAILED + 1)) ;;
        warn) HEALTH_ISSUES=$((HEALTH_ISSUES + 1)) ;;
    esac
    return 0
}

##
# Machine-readable health check. Performs the SAME staged checks as
# health_run (the human report) and is strictly READ-ONLY. Output under
# SILENT_UI (set in main()) is ONE document:
#
#   { version, command: "health", result: "ok"|"error", branch, vault,
#     checks: [ { name, status: ok|warn|fail|info, message } ... ],
#     statistics: { commits, tracked_files, git_size_bytes,
#                   free_space_bytes },
#     error: {code, message}|null }
#
# The checks[] array always carries the SAME seven rows (git, repository,
# head, object_database, safe_state, remote, identity): stages that could
# not run because an earlier stage failed are reported as info
# "Not checked — <reason>", so dashboards can index rows positionally.
#
# Exit code mirrors the HUMAN contract exactly: 0 only when every check
# is ok; 1 when a stage failed OR any warning was raised (the human
# report's "issues" counter counts missing remote/identity and an unsafe
# state as failures for automation purposes). git_size_bytes /
# free_space_bytes are byte sizes (du/df block-rounded, 0→null when
# unknown); commits/tracked_files are null when HEAD could not be read.
##
cmd_health_json() {
    HEALTH_ROWS=()
    HEALTH_FAILED=0
    HEALTH_ISSUES=0
    HEALTH_BRANCH=""
    HEALTH_STATS_COMMITS="null"
    HEALTH_STATS_FILES="null"
    HEALTH_STATS_GIT_SIZE="null"
    HEALTH_STATS_FREE="null"
    local stage

    # ---- stage 1: git binary --------------------------------------------
    if ! command -v git >/dev/null 2>&1; then
        health_row fail git "git is not installed (install with: $(install_hint))"
        for stage in repository head object_database safe_state remote identity; do
            health_row info "$stage" "Not checked — git is not installed"
        done
        health_emit_json
        return 1
    fi
    health_row ok git "git is available"

    # ---- stage 2: repository exists --------------------------------------
    if [[ ! -d "$VAULT/.git" ]]; then
        health_row fail repository "No git repository found: $VAULT (fix: ob-sync init or ob-sync repair)"
        for stage in head object_database safe_state remote identity; do
            health_row info "$stage" "Not checked — no git repository"
        done
        health_emit_json
        return 1
    fi
    health_row ok repository "Repository exists"

    # ---- stage 3: HEAD ----------------------------------------------------
    if g rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
        health_row ok head "HEAD is valid"
    elif g symbolic-ref --quiet HEAD >/dev/null 2>&1; then
        health_row ok head "HEAD is valid (unborn branch — no commits yet)"
    else
        health_row fail head "HEAD is corrupted (fix: ob-sync repair)"
        for stage in object_database safe_state remote identity; do
            health_row info "$stage" "Not checked — HEAD is corrupted"
        done
        health_emit_json
        return 1
    fi

    # ---- stage 4: object database ------------------------------------------
    fsck_object_db
    local fsck_rc=$?
    if (( fsck_rc == 0 )); then
        health_row ok object_database "Object database is intact"
    elif (( fsck_rc == 2 )); then
        # Stale remote-tracking ref (git remote-remove quirk) — NOT corruption;
        # a warn keeps the pipeline running and the exit code mirrors the
        # human report's "issues" semantics.
        health_row warn object_database \
            "Object database is intact, but a stale remote-tracking ref needs cleanup: $FSCK_DETAIL (fix: git update-ref -d $FSCK_DETAIL, or ob-sync repair)"
    else
        health_row fail object_database "Repository corruption detected (fix: ob-sync repair)"
        for stage in safe_state remote identity; do
            health_row info "$stage" "Not checked — repository corruption detected"
        done
        health_emit_json
        return 1
    fi

    # ---- stages 5-7: warnings never stop the pipeline ----------------------
    if check_repo_safe; then
        health_row ok safe_state "Repository is in a safe state"
    else
        health_row warn safe_state "Repository is not in a safe state (fix: ob-sync sync auto-recovers, or ob-sync repair)"
    fi

    if g remote get-url origin >/dev/null 2>&1; then
        health_row ok remote "Remote 'origin' is configured"
    else
        health_row warn remote "Remote 'origin' is missing (set one with: ob-sync remote <url>)"
    fi

    if [[ -n "$(g config user.email 2>/dev/null)" ]]; then
        health_row ok identity "Git identity is configured"
    else
        health_row warn identity "No git identity — a fallback will be applied on next commit"
    fi

    # ---- statistics (same numbers the human report prints) -----------------
    HEALTH_BRANCH=$(g symbolic-ref --short HEAD 2>/dev/null) || HEALTH_BRANCH="$BRANCH"
    HEALTH_STATS_COMMITS=$(g rev-list --count HEAD 2>/dev/null || printf '0')
    HEALTH_STATS_FILES=$(g ls-files 2>/dev/null | wc -l | tr -d ' ')
    local kb
    kb=$(du -sk "$VAULT/.git" 2>/dev/null | cut -f1)
    [[ "$kb" =~ ^[0-9]+$ ]] && HEALTH_STATS_GIT_SIZE=$((kb * 1024))
    local avail_blocks
    avail_blocks=$(df -Pk "$HOME" 2>/dev/null | awk 'NR==2 {print $4}')
    [[ "$avail_blocks" =~ ^[0-9]+$ ]] && HEALTH_STATS_FREE=$((avail_blocks * 1024))

    health_emit_json
    if (( HEALTH_FAILED || HEALTH_ISSUES )); then
        return 1
    fi
    return 0
}

##
# Render the health document. The exit-code decision lives in the caller
# (cmd_health_json) so the early-exit stages can reuse it directly.
##
health_emit_json() {
    local j_result='"ok"' j_error="null"
    if (( HEALTH_FAILED )); then
        j_result='"error"'
        j_error='{ "code": "health_failed", "message": "One or more health checks failed" }'
    elif (( HEALTH_ISSUES )); then
        j_result='"error"'
        j_error=$(printf '{ "code": "health_issues", "message": "%s issue(s) detected" }' "$HEALTH_ISSUES")
    fi

    printf '{\n'
    printf '  "version": "%s",\n' "$VERSION"
    printf '  "command": "health",\n'
    printf '  "result": %s,\n' "$j_result"
    printf '  "branch": "%s",\n' "$(json_escape "${HEALTH_BRANCH:-$BRANCH}")"
    printf '  "vault": "%s",\n' "$(json_escape "$VAULT")"
    printf '  "checks": [\n'
    local i=0 sep row status name message
    for row in "${HEALTH_ROWS[@]}"; do
        IFS=$'\t' read -r status name message <<< "$row"
        if (( i == ${#HEALTH_ROWS[@]} - 1 )); then sep=""; else sep=","; fi
        printf '    { "name": "%s", "status": "%s", "message": "%s" }%s\n' \
            "$(json_escape "$name")" "$status" "$(json_escape "$message")" "$sep"
        i=$((i + 1))
    done
    printf '  ],\n'
    printf '  "statistics": { "commits": %s, "tracked_files": %s, "git_size_bytes": %s, "free_space_bytes": %s },\n' \
        "${HEALTH_STATS_COMMITS:-null}" "${HEALTH_STATS_FILES:-null}" \
        "${HEALTH_STATS_GIT_SIZE:-null}" "${HEALTH_STATS_FREE:-null}"
    printf '  "error": %s\n' "$j_error"
    printf '}\n'
    return 0
}

##
# Audit the vault for hygiene problems: untitled notes, empty notes,
# oversized files and attachments not referenced by any note.
# With --fix, orphaned attachments are moved into $ATTACH_DIR (name
# collisions are skipped, never overwritten).
##
# ── Vault organization ─────────────────────────────────────────────────────
#
#   usage:  cmd_organize [--fix] [--json]    (-y accepted as a no-op)
#
# Human mode is byte-identical to the pre-9.2.0 command. --json mode
# (SILENT_UI, set in main()) runs the same scans silently and emits ONE
# machine-readable document; with --fix it carries the moved-files
# report — the scripting counterpart of the human "Moved N orphan(s)".
#
# Routing (dispatch): scan-only organize never mutates anything and
# never takes the lock (same policy as restore --list); organize --fix
# is destructive and always serialized through the lock — with_lock
# answers a lock contention with a parseable lock_busy document (rc 2).
#
# Document shape (stable — see README "Machine-Readable Everything"):
#   { version, command: "organize", mode: "scan"|"fix",
#     result: "ok"|"error", vault, attach_dir,
#     scan: { notes, attachments, other },
#     untitled: [path...], empty_notes: [path...],
#     oversized: [ {path, size_bytes}... ], orphans: [path...],
#     moved: [ {from, to}... ], skipped: [ {file, reason}... ],
#     elapsed_seconds, error: {code,message}|null }
# Stable error codes: scan_failed, attach_dir_create_failed, lock_busy.
##

# Document state (reset before every run — also under set -u).
ORG_FIX=0
ORG_NOTES=0 ORG_ATTACHMENTS=0 ORG_OTHERS=0
ORG_UNTITLED=() ORG_EMPTY=() ORG_OVERSIZED=() ORG_ORPHANS=()
ORG_MOVED=() ORG_SKIPPED=()
ORG_ERR_CODE="" ORG_ERR_MSG=""
ORG_T0=0

organize_reset_state() {
    ORG_FIX=0
    ORG_NOTES=0; ORG_ATTACHMENTS=0; ORG_OTHERS=0
    ORG_UNTITLED=(); ORG_EMPTY=(); ORG_OVERSIZED=(); ORG_ORPHANS=()
    ORG_MOVED=(); ORG_SKIPPED=()
    ORG_ERR_CODE=""; ORG_ERR_MSG=""
    ORG_T0=$SECONDS
}

cmd_organize() {
    local fix=0 json=0
    while (( $# )); do
        case "$1" in
            --fix)    fix=1; shift ;;
            --json)   json=1; shift ;;
            # -y is a no-op (organize never prompts) but accepted so the
            # `ob-sync <cmd> -y` muscle memory keeps working.
            -y|--yes) :; shift ;;
            --)       shift
                      # organize takes no positional arguments — neither
                      # before nor after the "--" separator. The pre-9.2.1
                      # parser silently DROPPED anything after "--"
                      # (`organize -- --fix` ran an innocent scan).
                      if (( $# > 0 )); then
                          error "Unexpected argument for organize: $1"
                          warn "Usage: ob-sync organize [--fix] [--json]"
                          return 1
                      fi
                      break ;;
            -*)       error "Unknown option for organize: $1"
                      warn "Usage: ob-sync organize [--fix] [--json]"
                      return 1 ;;
            *)        error "Unexpected argument for organize: $1"
                      warn "Usage: ob-sync organize [--fix] [--json]"
                      return 1 ;;
        esac
    done

    organize_reset_state
    ORG_FIX=$fix

    organize_scan
    local scan_rc=$?

    if (( json )); then
        local rc=0
        if (( scan_rc != 0 )); then
            rc=1
        elif (( fix )); then
            organize_fix_run || rc=1
        fi
        organize_emit_json "$rc"
        return "$rc"
    fi

    organize_print_human
}

##
# Shared inventory pass — silent by design (the human printer and the
# JSON emitter render it). Rows use 0x1f (unit separator): paths are
# free text. ORG_OVERSIZED rows carry the exact byte size (file_size_of)
# for the machine document; the human printer still renders du -h.
##
organize_scan() {
    # Attachment extensions recognized during the scan.
    local -a attach_exts=(png jpg jpeg gif webp svg bmp pdf mp3 wav ogg m4a mp4 mov mkv avi zip)

    local f ext e is_attach
    local -a attach_files=()

    while IFS= read -r -d '' f; do
        f=${f#"$VAULT"/}
        if [[ "$f" == *.md ]]; then
            ORG_NOTES=$((ORG_NOTES + 1))
        else
            ext=${f##*.}
            ext=${ext,,}
            is_attach=0
            for e in "${attach_exts[@]}"; do
                [[ "$ext" == "$e" ]] && { is_attach=1; break; }
            done
            if (( is_attach )); then
                ORG_ATTACHMENTS=$((ORG_ATTACHMENTS + 1))
                attach_files+=("$f")
            else
                ORG_OTHERS=$((ORG_OTHERS + 1))
            fi
        fi
    done < <(find "$VAULT" \( -name .git -o -name .obsidian -o -name .trash \) \
                -prune -o -type f -print0 2>/dev/null)

    while IFS= read -r -d '' f; do
        ORG_UNTITLED+=("${f#"$VAULT"/}")
    done < <(find "$VAULT" -name 'Untitled*.md' -type f \
                -not -path '*/.git/*' -not -path '*/.obsidian/*' \
                -not -path '*/.trash/*' -print0 2>/dev/null)

    # Empty or near-empty notes (restored 9.2.1): the 9.2.0 refactor that
    # extracted this scan for the JSON document dropped the pass entirely —
    # every audit since then answered "No empty notes" regardless of the
    # vault. Criteria identical to the pre-9.2.0 command (v8.0.0): markdown
    # files with fewer than 10 bytes of content, with the .trash exclusion
    # the 8.3.0 fix added.
    while IFS= read -r -d '' f; do
        ORG_EMPTY+=("${f#"$VAULT"/}")
    done < <(find "$VAULT" -name '*.md' -type f -size -10c \
                -not -path '*/.git/*' -not -path '*/.obsidian/*' \
                -not -path '*/.trash/*' -print0 2>/dev/null)

    while IFS= read -r -d '' f; do
        ORG_OVERSIZED+=("$(printf '%s\x1f%s' "${f#"$VAULT"/}" "$(file_size_of "$f")")")
    done < <(find "$VAULT" -type f -size +5M \
                -not -path '*/.git/*' -not -path '*/.obsidian/*' -print0 2>/dev/null)

    # Index every attachment-like filename mentioned inside any note
    # (covers both [[wiki]] embeds and standard [markdown](links)).
    #
    # PERFORMANCE (9.2.1): the references are folded into an associative
    # array once — keyed on the lowercased name, the same case-insensitive
    # whole-name match the per-file `grep -iFx` performed — so the
    # membership check is a hash lookup instead of one grep process per
    # attachment. A vault with hundreds of attachments no longer forks
    # hundreds of greps (and burns phone battery) during an audit. Case
    # folding is ASCII (`tr`/`${var,,}`) — exactly what `grep -i` does in
    # the C locales Termux and cron shells run under.
    local -A referenced=()
    local m
    while IFS= read -r m; do
        [[ -n "$m" ]] && referenced["$m"]=1
    done < <(grep -rhoE --include='*.md' --exclude-dir=.git \
        '[A-Za-z0-9][A-Za-z0-9 ._()-]*\.(png|jpe?g|gif|webp|svg|bmp|pdf|mp3|wav|ogg|m4a|mp4|mov|mkv|avi|zip)' \
        "$VAULT" 2>/dev/null | tr '[:upper:]' '[:lower:]' | sort -u)

    local base
    for f in "${attach_files[@]}"; do
        base=${f##*/}
        if [[ -n "${referenced[${base,,}]:-}" ]]; then
            continue
        fi
        # The extractor above only recognizes ASCII-ish names — a
        # basename containing non-ASCII (Persian, CJK) or characters
        # outside its class can never match it, yet a note may reference
        # the file verbatim. Before declaring an orphan, search the raw
        # bytes: a fixed-string scan over the notes (grep -i's case
        # folding is ASCII-only anyway, so an exact match is the honest
        # check here). Bounded: only runs for files about to be flagged.
        if grep -rqF --include='*.md' --exclude-dir=.git -- "$base" "$VAULT" 2>/dev/null; then
            continue
        fi
        ORG_ORPHANS+=("$f")
    done
    return 0
}

##
# Human view — byte-identical to the pre-9.2.0 command.
##
organize_print_human() {
    section "Vault Organization"

    step "Scanning vault contents"
    kv "Notes" "$ORG_NOTES"
    kv "Attachments" "$ORG_ATTACHMENTS"
    kv "Other files" "$ORG_OTHERS"

    step "Scanning for untitled notes"
    if (( ${#ORG_UNTITLED[@]} )); then
        # Report only: renaming outside Obsidian would break backlinks.
        warn "${#ORG_UNTITLED[@]} untitled note(s) — rename inside Obsidian to keep backlinks intact"
        local f
        for f in "${ORG_UNTITLED[@]}"; do
            printf '      %s%s%s\n' "$C_DIM" "$f" "$C_RESET"
        done
    else
        success "No untitled notes"
    fi

    step "Scanning for empty notes"
    if (( ${#ORG_EMPTY[@]} )); then
        warn "${#ORG_EMPTY[@]} empty or near-empty note(s) found"
        local f
        for f in "${ORG_EMPTY[@]}"; do
            printf '      %s%s%s\n' "$C_DIM" "$f" "$C_RESET"
        done
    else
        success "No empty notes"
    fi

    step "Scanning for oversized files (> 5 MB)"
    if (( ${#ORG_OVERSIZED[@]} )); then
        warn "${#ORG_OVERSIZED[@]} large file(s) — consider excluding media from the repo"
        local f p
        for f in "${ORG_OVERSIZED[@]}"; do
            p=${f%%$'\x1f'*}
            printf '      %s%s%s\n' "$C_DIM" "$(du -h "$VAULT/$p" 2>/dev/null | cut -f1)  $p" "$C_RESET"
        done
    else
        success "No oversized files"
    fi

    step "Scanning for orphaned attachments"
    if (( ${#ORG_ORPHANS[@]} == 0 )); then
        success "No orphaned attachments"
        return 0
    fi

    warn "${#ORG_ORPHANS[@]} orphaned attachment(s) — not referenced by any note"
    local f
    for f in "${ORG_ORPHANS[@]}"; do
        printf '      %s%s%s\n' "$C_DIM" "$f" "$C_RESET"
    done

    if (( ! ORG_FIX )); then
        echo
        info "Run 'ob-sync organize --fix' to move them into: $ATTACH_DIR/"
        return 0
    fi

    organize_fix_run
}

##
# The destructive half of organize --fix. Shared by the human and JSON
# modes: every outcome is recorded (moved / skipped + reason) so the
# machine document never has to guess, while the human view prints
# exactly what it always printed — collision warnings and the summary.
# Files already living in ATTACH_DIR and failed mv() calls were silent
# in the human view before 9.2.0 and still are; the document reports
# them as skipped rows.
##
organize_fix_run() {
    step "Moving orphans into $ATTACH_DIR"
    mkdir -p "$VAULT/$ATTACH_DIR" \
        || { error "Cannot create: $VAULT/$ATTACH_DIR"
             ORG_ERR_CODE="attach_dir_create_failed"
             ORG_ERR_MSG="Cannot create: $VAULT/$ATTACH_DIR"
             return 1; }

    local f name dest
    for f in "${ORG_ORPHANS[@]}"; do
        if [[ "$f" == "$ATTACH_DIR"/* ]]; then
            # Already in place — nothing to move (human view: silent).
            ORG_SKIPPED+=("$(printf '%s\x1f%s' "$f" "already in attachments dir")")
            continue
        fi
        name=${f##*/}
        dest="$VAULT/$ATTACH_DIR/$name"
        if [[ -e "$dest" ]]; then
            warn "Skipped (name collision): $name"
            ORG_SKIPPED+=("$(printf '%s\x1f%s' "$f" "name collision")")
            continue
        fi
        if mv "$VAULT/$f" "$dest" 2>/dev/null; then
            ORG_MOVED+=("$(printf '%s\x1f%s' "$f" "$ATTACH_DIR/$name")")
        else
            ORG_SKIPPED+=("$(printf '%s\x1f%s' "$f" "move failed")")
        fi
    done

    success "Moved ${#ORG_MOVED[@]} orphan(s) into $ATTACH_DIR/"
    info "Run 'ob-sync sync' to commit the reorganization"
    return 0
}

##
# Emit the machine-readable organize document. Called only from
# cmd_organize in --json mode: SILENT_UI (set in main()) guarantees this
# document is the ONLY thing on stdout. moved/skipped are [] in scan
# mode — the shape never changes, only the mode field and which arrays
# carry data.
##
organize_emit_json() {
    local rc="$1"
    local j_result='"ok"' j_error="null" j_mode="scan"
    (( ORG_FIX )) && j_mode="fix"
    if (( rc != 0 )); then
        j_result='"error"'
        j_error="{ \"code\": \"${ORG_ERR_CODE:-organize_failed}\", \"message\": \"$(json_escape "${ORG_ERR_MSG:-organize failed}")\" }"
    fi

    printf '{\n'
    printf '  "version": "%s",\n' "$VERSION"
    printf '  "command": "organize",\n'
    printf '  "mode": "%s",\n' "$j_mode"
    printf '  "result": %s,\n' "$j_result"
    printf '  "vault": "%s",\n' "$(json_escape "$VAULT")"
    printf '  "attach_dir": "%s",\n' "$(json_escape "$ATTACH_DIR")"
    printf '  "scan": { "notes": %d, "attachments": %d, "other": %d },\n' \
        "$ORG_NOTES" "$ORG_ATTACHMENTS" "$ORG_OTHERS"

    printf '  "untitled": ['
    local i sep
    for ((i = 0; i < ${#ORG_UNTITLED[@]}; i++)); do
        (( i == 0 )) || printf ','
        printf ' "%s"' "$(json_escape "${ORG_UNTITLED[i]}")"
    done
    printf ' ],\n'

    printf '  "empty_notes": ['
    for ((i = 0; i < ${#ORG_EMPTY[@]}; i++)); do
        (( i == 0 )) || printf ','
        printf ' "%s"' "$(json_escape "${ORG_EMPTY[i]}")"
    done
    printf ' ],\n'

    printf '  "oversized": ['
    local row p sz
    for ((i = 0; i < ${#ORG_OVERSIZED[@]}; i++)); do
        row="${ORG_OVERSIZED[i]}"
        p=${row%%$'\x1f'*}; sz=${row#*$'\x1f'}
        [[ "$sz" =~ ^[0-9]+$ ]] || sz=0
        (( i == 0 )) || printf ','
        printf ' { "path": "%s", "size_bytes": %d }' "$(json_escape "$p")" "$sz"
    done
    printf ' ],\n'

    printf '  "orphans": ['
    for ((i = 0; i < ${#ORG_ORPHANS[@]}; i++)); do
        (( i == 0 )) || printf ','
        printf ' "%s"' "$(json_escape "${ORG_ORPHANS[i]}")"
    done
    printf ' ],\n'

    printf '  "moved": ['
    for ((i = 0; i < ${#ORG_MOVED[@]}; i++)); do
        row="${ORG_MOVED[i]}"
        (( i == 0 )) || printf ','
        printf ' { "from": "%s", "to": "%s" }' \
            "$(json_escape "${row%%$'\x1f'*}")" "$(json_escape "${row#*$'\x1f'}")"
    done
    printf ' ],\n'

    printf '  "skipped": ['
    for ((i = 0; i < ${#ORG_SKIPPED[@]}; i++)); do
        row="${ORG_SKIPPED[i]}"
        (( i == 0 )) || printf ','
        printf ' { "file": "%s", "reason": "%s" }' \
            "$(json_escape "${row%%$'\x1f'*}")" "$(json_escape "${row#*$'\x1f'}")"
    done
    printf ' ],\n'

    printf '  "elapsed_seconds": %d,\n' "$(( SECONDS - ORG_T0 ))"
    printf '  "error": %s\n' "$j_error"
    printf '}\n'
    return 0
}

# shellcheck disable=SC2120  # args arrive via dispatch's "$@" call
cmd_doctor() {
    local json=0
    while (( $# )); do
        case "$1" in
            --json)   json=1 ;;
            *)  error "Unknown option for doctor: $1"
                warn "Usage: ob-sync doctor [--json]"
                return 1 ;;
        esac
        shift
    done

    if (( json )); then
        cmd_doctor_json
        return $?
    fi
    doctor_run
}

doctor_run() {
    section "Diagnostics"
    load_config_overrides

    step "Detecting platform"
    if (( IS_TERMUX )); then
        success "Termux ${TERMUX_VERSION:-} (Android)"
    else
        success "Desktop (${OSTYPE:-unknown})"
    fi

    step "Checking required tools"
    local -a required=(git tar find grep)
    local -a missing=()
    local tool
    for tool in "${required[@]}"; do
        command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
    done
    # One hashing tool is enough — GNU sha256sum or BSD/macOS shasum.
    command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1 \
        || missing+=("sha256sum|shasum")
    if (( ${#missing[@]} == 0 )); then
        success "All required tools are available"
    else
        error "Missing tools: ${missing[*]}"
        warn "Install with: $(install_hint)"
        return 1
    fi

    step "Checking storage access"
    if (( IS_TERMUX )); then
        if [[ -d "$HOME/storage/shared" ]]; then
            success "Shared storage is mounted"
        else
            error "Shared storage is not available"
            warn "Run: termux-setup-storage"
            return 1
        fi
    else
        success "Native filesystem — no storage permission required"
    fi

    step "Resolving vault"
    resolve_vault || :
    kv "Resolution" "$VAULT_SOURCE"
    kv "Vault" "$VAULT"

    step "Checking vault access"
    if [[ -d "$VAULT" ]]; then
        success "Vault found"
        if [[ -w "$VAULT" ]]; then
            success "Vault is writable"
        else
            error "Vault is not writable: $VAULT"
            return 1
        fi
    else
        warn "Vault not found: $VAULT"
        warn "Initialize it with: ob-sync init"
    fi

    step "Checking backup directory"
    if mkdir -p "$BACKUP_DIR" 2>/dev/null && [[ -w "$BACKUP_DIR" ]]; then
        success "Backup directory is ready"
    else
        error "Backup directory is not writable: $BACKUP_DIR"
        return 1
    fi

    # Storage topology advisory: backups only protect against data loss
    # if they can survive the loss of the disk the vault lives on.
    if [[ -d "$VAULT" ]]; then
        step "Checking backup storage topology"
        local vault_fs backup_fs
        vault_fs=$(fs_id_of "$VAULT")
        backup_fs=$(fs_id_of "$BACKUP_DIR")
        if [[ -n "$vault_fs" && -n "$backup_fs" && "$vault_fs" == "$backup_fs" ]]; then
            warn "Backups share a filesystem with the vault ($vault_fs)"
            warn "One disk failure could destroy both — point OBS_BACKUP_DIR at another disk/mount"
        elif [[ -n "$backup_fs" ]]; then
            success "Backups live on a separate filesystem ($backup_fs)"
        else
            info "Could not determine the backup filesystem"
        fi
    fi

    step "Checking remote connectivity"
    local url remote_out="" default_branch=""
    url=$(remote_url)
    if [[ -z "$url" ]]; then
        warn "No remote repository configured yet"
        warn "Set one with: ob-sync remote <url>   (e.g. https://github.com/<user>/<vault>.git)"
    elif remote_out=$(run_with_timeout git ls-remote --symref "$url" 2>/dev/null); then
        # ONE network call answers reachability, empty-repository
        # detection AND the default branch (pre-9.2.3 an unreachable
        # remote burned the watchdog up to three times — about
        # 3 × OBS_GIT_TIMEOUT of dead waiting on a dead network).
        default_branch=$(awk '/^ref:/ { sub(/refs\/heads\//, "", $2); print $2; exit }' <<< "$remote_out")
        if [[ -n "$remote_out" ]]; then
            success "Remote is reachable"
        else
            success "Remote is reachable (empty repository — the first sync creates the branch)"
        fi
    else
        warn "Remote is unreachable — network down, private repo, or missing credentials"
        warn "For private repos, authenticate once:"
        printf '      git config --global credential.helper store\n'
        printf '      git ls-remote %s   (enter token — it will be saved)\n' "$url"
    fi

    if [[ -n "$url" && -n "$remote_out" ]]; then
        step "Checking remote default branch"
        if [[ -n "$default_branch" ]]; then
            if [[ "$default_branch" == "$BRANCH" ]]; then
                success "Remote default branch '$BRANCH' matches configuration"
            else
                warn "Remote default branch is '$default_branch', but OBS_BRANCH='$BRANCH'"
                warn "Fix: export OBS_BRANCH=$default_branch"
            fi
        fi
    fi

    step "Checking watchdogs"
    if (( HAS_TIMEOUT )); then
        success "Network watchdog active (${GIT_TIMEOUT}s timeout)"
        success "Local watchdog active (${LOCAL_TIMEOUT}s timeout)"
    else
        warn "Watchdogs disabled — 'timeout' not found"
        warn "Remote calls and local archives may hang on dead connections or mounts"
        [[ "${OSTYPE:-}" == darwin* ]] && warn "Fix: brew install coreutils"
    fi

    step "Checking free storage"
    local avail
    avail=$(df -Ph "$HOME" 2>/dev/null | awk 'NR==2 {print $4}')
    kv "Free space (\$HOME)" "${avail:-unknown}"

    echo
    success "Diagnostics complete"
    return 0
}

# ── Machine-readable diagnostics (`doctor --json`) ──────────────────────────

DOCTOR_ROWS=()      # "status<TAB>name<TAB>message" rows, in report order
DOCTOR_FAILED=0     # 1 once any row is a fail

doctor_row() {
    local status="$1" name="$2" message="$3"
    DOCTOR_ROWS+=("$(printf '%s\t%s\t%s' "$status" "$name" "$message")")
    [[ "$status" == "fail" ]] && DOCTOR_FAILED=1
    return 0
}

##
# Machine-readable doctor. Performs the SAME checks as doctor_run (the
# human report) but strictly READ-ONLY — a diagnostic must never mutate
# state, so unlike the human path it does not create the backup
# directory (a missing directory is reported instead). Output under
# SILENT_UI (set in main()) is ONE document:
#
#   { version, command: "doctor", result: "ok"|"error", platform,
#     checks: [ { name, status: ok|warn|fail|info, message } ... ],
#     error: null }
#
# result is "error" (and the exit code 1) iff any check failed — the
# same contract as the human report. Warnings keep exit code 0.
##
cmd_doctor_json() {
    load_config_overrides
    DOCTOR_ROWS=()
    DOCTOR_FAILED=0

    local platform="linux"
    (( IS_TERMUX )) && platform="termux"
    [[ "${OSTYPE:-}" == darwin* ]] && platform="macos"

    # Platform
    if (( IS_TERMUX )); then
        doctor_row ok platform "Termux ${TERMUX_VERSION:-} (Android)"
    else
        doctor_row ok platform "Desktop (${OSTYPE:-unknown})"
    fi

    # Required tools
    local -a missing=()
    local tool
    for tool in git tar find grep; do
        command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
    done
    command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1 \
        || missing+=("sha256sum|shasum")
    if (( ${#missing[@]} == 0 )); then
        doctor_row ok tools "All required tools are available"
    else
        doctor_row fail tools "Missing tools: ${missing[*]}"
    fi

    # Storage access (a Termux-only concept)
    if (( IS_TERMUX )); then
        if [[ -d "$HOME/storage/shared" ]]; then
            doctor_row ok storage "Shared storage is mounted"
        else
            doctor_row fail storage "Shared storage is not available (run: termux-setup-storage)"
        fi
    else
        doctor_row ok storage "Native filesystem — no storage permission required"
    fi

    # Vault
    resolve_vault || :
    local vault_exists="false"
    if [[ -d "$VAULT" ]]; then
        vault_exists="true"
        if [[ -w "$VAULT" ]]; then
            doctor_row ok vault "Vault found and writable (source: $VAULT_SOURCE)"
        else
            doctor_row fail vault "Vault is not writable: $VAULT"
        fi
    else
        doctor_row warn vault "Vault not found: $VAULT (initialize with: ob-sync init)"
    fi

    # Backup directory — read-only: report a missing directory instead
    # of creating it.
    if [[ -d "$BACKUP_DIR" ]]; then
        if [[ -w "$BACKUP_DIR" ]]; then
            doctor_row ok backup_dir "Backup directory is ready ($BACKUP_DIR)"
        else
            doctor_row fail backup_dir "Backup directory is not writable: $BACKUP_DIR"
        fi
    else
        doctor_row warn backup_dir "Backup directory does not exist yet — created on the first backup ($BACKUP_DIR)"
    fi

    # Storage topology (backups must survive the loss of the vault disk)
    if [[ "$vault_exists" == "true" ]]; then
        local vault_fs backup_fs
        vault_fs=$(fs_id_of "$VAULT")
        backup_fs=$(fs_id_of "$BACKUP_DIR")
        if [[ -n "$vault_fs" && -n "$backup_fs" && "$vault_fs" == "$backup_fs" ]]; then
            doctor_row warn backup_topology \
                "Backups share a filesystem with the vault ($vault_fs) — one disk failure could destroy both; fix: point OBS_BACKUP_DIR at another disk/mount"
        elif [[ -n "$backup_fs" ]]; then
            doctor_row ok backup_topology "Backups live on a separate filesystem ($backup_fs)"
        else
            doctor_row info backup_topology "Could not determine the backup filesystem"
        fi
    else
        doctor_row info backup_topology "Not checked — vault is missing"
    fi

    # Remote reachability (network I/O under the watchdog, as the human
    # report does)
    local url remote_out="" default_branch=""
    url=$(remote_url)
    local j_remote="null" j_branch="null"
    if [[ -z "$url" ]]; then
        doctor_row warn remote "No remote repository configured yet (set one with: ob-sync remote <url>)"
        doctor_row info remote_branch "Not checked — no remote configured"
    elif remote_out=$(run_with_timeout git ls-remote --symref "$url" 2>/dev/null); then
        # ONE network call answers reachability, empty-repository
        # detection AND the default branch (see the human twin above).
        default_branch=$(awk '/^ref:/ { sub(/refs\/heads\//, "", $2); print $2; exit }' <<< "$remote_out")
        if [[ -n "$remote_out" ]]; then
            doctor_row ok remote "Remote is reachable"
        else
            doctor_row ok remote "Remote is reachable (empty repository — the first sync creates the branch)"
        fi
        j_remote="\"$(json_escape "$url")\""
    else
        doctor_row warn remote "Remote is unreachable — network down, private repo, or missing credentials"
        j_remote="\"$(json_escape "$url")\""
    fi

    # Remote default branch — keyed on the remote actually ANSWERING
    # (j_remote also carries the URL on the unreachable path).
    if [[ -n "$url" && -n "$remote_out" ]]; then
        if [[ -n "$default_branch" ]]; then
            j_branch="\"$(json_escape "$default_branch")\""
            if [[ "$default_branch" == "$BRANCH" ]]; then
                doctor_row ok remote_branch "Remote default branch '$BRANCH' matches configuration"
            else
                doctor_row warn remote_branch \
                    "Remote default branch is '$default_branch', but OBS_BRANCH='$BRANCH' (fix: export OBS_BRANCH=$default_branch)"
            fi
        else
            doctor_row info remote_branch "Could not determine the remote default branch"
        fi
    fi

    # Watchdogs
    if (( HAS_TIMEOUT )); then
        doctor_row ok watchdogs "Network watchdog active (${GIT_TIMEOUT}s) · local watchdog active (${LOCAL_TIMEOUT}s)"
    else
        doctor_row warn watchdogs "Watchdogs disabled — 'timeout' not found (remote calls and local archives may hang)"
    fi

    # Free storage
    local avail
    avail=$(df -Ph "$HOME" 2>/dev/null | awk 'NR==2 {print $4}')
    doctor_row info free_space "Free space (\$HOME): ${avail:-unknown}"

    # ---- render ----------------------------------------------------------
    local j_result='"ok"' j_error="null"
    if (( DOCTOR_FAILED )); then
        j_result='"error"'
        j_error='{ "code": "diagnostics_failed", "message": "One or more diagnostic checks failed" }'
    fi

    printf '{\n'
    printf '  "version": "%s",\n' "$VERSION"
    printf '  "command": "doctor",\n'
    printf '  "result": %s,\n' "$j_result"
    printf '  "platform": "%s",\n' "$platform"
    printf '  "remote": %s,\n' "$j_remote"
    printf '  "default_branch": %s,\n' "$j_branch"
    printf '  "checks": [\n'
    local i=0 sep row status name message
    for row in "${DOCTOR_ROWS[@]}"; do
        IFS=$'\t' read -r status name message <<< "$row"
        if (( i == ${#DOCTOR_ROWS[@]} - 1 )); then sep=""; else sep=","; fi
        printf '    { "name": "%s", "status": "%s", "message": "%s" }%s\n' \
            "$(json_escape "$name")" "$status" "$(json_escape "$message")" "$sep"
        i=$((i + 1))
    done
    printf '  ],\n'
    printf '  "error": %s\n' "$j_error"
    printf '}\n'

    (( DOCTOR_FAILED )) && return 1
    return 0
}

cmd_init() {
    section "First-Time Setup"
    load_config_overrides

    step "Checking environment"
    command -v git >/dev/null 2>&1 \
        || { error "git is not installed"; warn "Install it with: $(install_hint)"; return 1; }

    # Storage permission is a Termux-only concept.
    if (( IS_TERMUX )) && [[ ! -d "$HOME/storage/shared" ]]; then
        warn "Termux storage permission is missing"
        command -v termux-setup-storage >/dev/null 2>&1 || {
            error "termux-setup-storage not found — is this really Termux?"
            return 1
        }
        local answer=""
        if (( ! ASSUME_YES )) && [[ -t 0 ]]; then
            read -r -p "  Run termux-setup-storage now? [Y/n]: " answer || :
        fi
        if [[ ! "$answer" =~ ^[Nn]$ ]]; then
            termux-setup-storage || { error "Storage setup failed"; return 1; }
        else
            error "Storage permission is required — cancelled"
            return 1
        fi
    fi

    step "Confirming vault location"
    info "Vault: $VAULT"
    local reply=""
    if (( ! ASSUME_YES )) && [[ -t 0 ]]; then
        read -r -p "  Use this vault? [Y/n]: " reply || :
        if [[ "$reply" =~ ^[Nn]$ ]]; then
            read -r -p "  Enter vault path: " reply || :
            if [[ -d "$reply" ]]; then
                VAULT=$(cd "$reply" && pwd -P)
                info "Vault: $VAULT"
                # The operator re-pointed init at a DIFFERENT vault: the
                # session's REMOTE/BRANCH may still describe the previous
                # one (seeded from the config file, which belongs to the
                # pinned vault). Carrying them over would link this vault
                # to another vault's repository — re-derive from THIS
                # vault's own origin; the config file is re-consulted by
                # the binder only when this vault is the pinned one.
                if [[ -z "${OBS_REMOTE:-}" ]]; then
                    REMOTE=""
                    [[ -z "${OBS_BRANCH:-}" ]] && BRANCH="main"
                    bind_session_remote
                fi
            else
                error "No such directory: $reply"
                return 1
            fi
        fi
    fi
    # Pin only an existing vault; fresh clones live under the scanned roots,
    # so auto-detection covers them and -y runs never pin a dead default.
    if [[ -d "$VAULT" ]] && config_set VAULT "$VAULT"; then
        success "Vault saved to $CONFIG_FILE"
    elif [[ ! -d "$VAULT" ]]; then
        warn "Vault not present yet — config not pinned (auto-detection will cover standard clones)"
    fi

    # The remote is the one thing ob-sync cannot guess. Prompt for it when
    # neither the environment, the config file, nor an existing 'origin'
    # provides one, then persist it for every future shell (cron included).
    step "Confirming remote repository"
    local have_origin=0
    g remote get-url origin >/dev/null 2>&1 && have_origin=1
    if [[ -z "$REMOTE" ]] && (( ! have_origin )); then
        if (( ASSUME_YES )) || [[ ! -t 0 ]]; then
            error "No remote repository configured"
            warn "Fix: ob-sync remote <url>   (or export OBS_REMOTE and re-run)"
            return 1
        fi
        printf '  Where should the vault sync to?\n'
        printf '  %sExample:%s https://github.com/<user>/<vault>.git\n' "$C_DIM" "$C_RESET"
        local url_input=""
        read -r -p "  Remote URL: " url_input || :
        url_input="${url_input//[[:space:]]/}"
        if [[ -z "$url_input" ]]; then
            error "A remote URL is required — set it later with: ob-sync remote <url>"
            return 1
        fi
        REMOTE="$url_input"
    fi
    if [[ -n "$REMOTE" ]] && config_set REMOTE "$REMOTE"; then
        success "Remote saved to $CONFIG_FILE"
    elif [[ -z "$REMOTE" ]]; then
        info "Remote left as configured in the vault's 'origin'"
    fi

    # HTTPS without a credential helper re-prompts for username/password
    # on every sync (Termux ships git without one). Offer the built-in
    # store helper once, here, before the first network operation.
    ensure_credential_helper

    if [[ -d "$VAULT/.git" ]]; then
        info "Vault already has a git repository — applying configuration only"
    elif [[ -d "$VAULT" ]]; then
        # The vault exists (typically created by the Obsidian app) but has
        # no history: initialize git and link it to the remote WITHOUT
        # touching any working file.
        step "Linking existing vault to remote"
        git -C "$VAULT" init -q 2>/dev/null || { error "git init failed"; return 1; }
        git -C "$VAULT" symbolic-ref HEAD "refs/heads/$BRANCH" \
            || { error "Failed to set branch '$BRANCH'"; return 1; }

        g remote add origin "$REMOTE" 2>/dev/null \
            || g remote set-url origin "$REMOTE" 2>/dev/null \
            || { error "Failed to configure remote"; return 1; }

        info "Fetching remote history"
        if net_quiet fetch --quiet origin && remote_branch_exists; then
            # Point the branch at the remote head; local edits simply show
            # up as pending changes for the next sync.
            if g reset --mixed "origin/$BRANCH" >/dev/null 2>&1; then
                # Materialize remote files that are missing locally —
                # additive only, existing files are never overwritten.
                # Without this, the first sync would commit their deletion.
                local absent
                absent=$(g ls-files --deleted 2>/dev/null | wc -l | tr -d ' ')
                if (( absent > 0 )); then
                    # NOTE: no `xargs -r` — it is GNU-only. The guard above
                    # already guarantees non-empty input.
                    g ls-files --deleted -z 2>/dev/null \
                        | xargs -0 git -C "$VAULT" checkout -- 2>/dev/null || :
                    info "Restored $absent file(s) that existed only on the remote"
                fi
                success "Linked existing files to origin/$BRANCH"
            else
                warn "Could not align with remote history — next sync starts fresh"
            fi
        else
            info "Remote branch not found — this vault will become the source of truth"
        fi
    else
        step "Cloning vault from remote"
        local detected="" adopted=0
        mkdir -p "$(dirname "$VAULT")" \
            || { error "Cannot create vault parent directory"; return 1; }

        if ! run_with_timeout git clone --quiet --single-branch --branch "$BRANCH" \
                "$REMOTE" "$VAULT" 2>/dev/null; then
            warn "Clone of branch '$BRANCH' failed — trying the default branch"
            rm -rf -- "$VAULT"
            if ! run_with_timeout git clone --quiet "$REMOTE" "$VAULT" 2>/dev/null; then
                rm -rf -- "$VAULT"
                error "Clone failed — check URL, network and credentials"
                return 1
            fi
            detected=$(git -C "$VAULT" branch --show-current 2>/dev/null)
            if [[ -n "$detected" && "$detected" != "$BRANCH" && -z "${OBS_BRANCH:-}" ]]; then
                info "Adopting remote default branch: $detected"
                BRANCH="$detected"
                adopted=1
            fi
        fi
        success "Vault cloned"
        # Pin the fresh clone so cron and non-login shells resolve exactly
        # this directory even when it lives outside the scanned roots.
        if config_set VAULT "$VAULT"; then
            success "Vault saved to $CONFIG_FILE"
        fi
        if (( adopted )) && config_set BRANCH "$BRANCH"; then
            info "Branch '$BRANCH' saved to $CONFIG_FILE"
        fi
    fi

    step "Applying git configuration for shared storage"
    configure_repo
    ensure_identity
    success "Configuration applied"

    # The identity card is the 9.5.0 answer to "clone and go": the vault's
    # own remote/branch live inside the vault and travel to every clone.
    step "Saving the vault identity"
    ALLOW_VAULT_CONF=1
    vault_conf_write

    step "Installing recommended .gitignore"
    if [[ -f "$VAULT/.gitignore" ]]; then
        info ".gitignore already exists — left untouched"
    else
        cat > "$VAULT/.gitignore" <<'EOF' || { error "Failed to write .gitignore"; return 1; }
# Obsidian — volatile local state, keep out of version control
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/

# ob-sync repair staging artifacts
.git-staged-*
.git-old-*
.git-original-*

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~
EOF
        success "Created .gitignore"
    fi

    echo
    success "Setup complete"
    kv "Vault" "$VAULT"
    kv "Remote" "$REMOTE"
    kv "Branch" "$BRANCH"
    kv "Identity" "$VAULT/.ob-sync/config ${C_DIM}(committed with the vault)${C_RESET}"
    echo
    info "Next step: ob-sync sync"
    log "Initialization complete"
    return 0
}

##
# Entry point for `ob-sync log [--json] [n]`. The human view lives in
# log_run() (output byte-identical to the pre-9.1.0 command); --json mode
# collects one row per log line and emits a machine-readable document.
# Read-only in both modes — log never takes the lock.
#
#   usage:  cmd_log [--json] [n]     (n defaults to 20; -y is a no-op)
##
cmd_log() {
    local json=0
    local -a pos=()
    while (( $# )); do
        case "$1" in
            --json) json=1; shift ;;
            # -y is a no-op here (log never prompts) but accepted so that
            # `ob-sync log -y` keeps working like `verify -y` muscle memory.
            -y|--yes) :; shift ;;
            --)      shift; pos+=("$@"); break ;;
            -*)      error "Unknown option for log: $1"
                     warn "Usage: ob-sync log [--json] [n]"
                     return 1 ;;
            *)       pos+=("$1"); shift ;;
        esac
    done

    local lines="${pos[0]:-20}"
    [[ "$lines" =~ ^[0-9]+$ ]] || lines=20

    # A reader must not materialize its own subject: if the activity log
    # does not exist yet, drop LOG_FILE so the UI helpers below cannot
    # create it as a side effect (info() demotes to the log file under
    # SILENT_UI, and `>>` creates the file — a fresh machine would
    # otherwise answer with an INFO row inside a brand-new file).
    [[ -n "$LOG_FILE" && ! -f "$LOG_FILE" ]] && LOG_FILE=""

    if (( ! json )); then
        log_run "$lines"
        return $?
    fi

    LOG_REQUESTED=$lines
    LOG_ROWS=()
    LOG_COUNT=0

    log_run "$lines"
    local rc=$?
    log_emit_json "$rc"
    return "$rc"
}

##
# Human log view — byte-identical to the pre-9.1.0 command. In --json
# mode (SILENT_UI) entries are captured into LOG_ROWS instead of printed.
##
log_run() {
    # The section banner is pure human chrome — and worse, in --json mode
    # section() is DEMOTED to the log file, so a banner logged here would
    # become the newest entry in the very document this command emits.
    # Human mode keeps the banner; machine mode logs nothing extra.
    (( SILENT_UI )) || section "Recent Activity"

    local lines="$1"

    if [[ -z "$LOG_FILE" || ! -f "$LOG_FILE" ]]; then
        info "No log file available (logging may be disabled)"
        return 0
    fi

    if (( SILENT_UI )); then
        # Read-permission probe: process substitution swallows tail's exit
        # code, so an unreadable file would otherwise look like an empty
        # log (count 0) instead of the parseable failure the contract
        # promises. error() still reaches stderr; stdout stays pure.
        if [[ ! -r "$LOG_FILE" ]]; then
            error "Cannot read log file"
            return 1
        fi
        # log() writes "[timestamp] [source] message"; the source is a
        # bash function name plus %-14s space padding — it can never
        # contain a ']', so [^]]* pins the split at the FIRST bracket
        # close and a message containing '] ' cannot mangle the fields.
        local log_re='^\[([0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2})\] \[([^]]*)\] (.*)$'
        local raw ts src msg
        while IFS= read -r raw; do
            [[ -z "$raw" ]] && continue
            LOG_COUNT=$((LOG_COUNT + 1))
            if [[ "$raw" =~ $log_re ]]; then
                ts="${BASH_REMATCH[1]}"
                src="${BASH_REMATCH[2]}"
                # Trim the %-14s padding (no extglob needed).
                while [[ "$src" == *' ' ]]; do src=${src%" "}; done
                msg="${BASH_REMATCH[3]}"
                LOG_ROWS+=("$(printf '%s\x1f%s\x1f%s' "$ts" "$src" "$msg")")
            else
                # A torn/partial line (crash mid-write) must never abort
                # the document — keep it verbatim with null metadata.
                LOG_ROWS+=("$(printf '\x1f\x1f%s' "$raw")")
            fi
        done < <(tail -n "$lines" "$LOG_FILE" 2>/dev/null)
        return 0
    fi

    tail -n "$lines" "$LOG_FILE" 2>/dev/null || { error "Cannot read log file"; return 1; }
    return 0
}

##
# Emit the machine-readable activity document. Called only from cmd_log
# in --json mode: SILENT_UI (set in main()) guarantees this document is
# the ONLY thing on stdout.
#
# Shape (stable — see README "Machine-Readable Everything"):
#   { version, command: "log", log_file: string|null, requested,
#     count, entries: [ { timestamp: string|null, source: string|null,
#     message } ], error: {code,message}|null }
# A missing or disabled log file is VALID data (log_file null, count 0,
# rc 0 — mirrors the human "No log file available"); rc 1 with code
# log_unreadable only when an existing file cannot be read.
##
log_emit_json() {
    local rc="$1"
    local j_error="null" j_file="null"
    if (( rc != 0 )); then
        j_error="{ \"code\": \"log_unreadable\", \"message\": \"Cannot read log file\" }"
    fi
    [[ -n "${LOG_FILE:-}" && -f "$LOG_FILE" ]] && j_file="\"$(json_escape "$LOG_FILE")\""

    printf '{\n'
    printf '  "version": "%s",\n' "$VERSION"
    printf '  "command": "log",\n'
    printf '  "log_file": %s,\n' "$j_file"
    printf '  "requested": %d,\n' "$LOG_REQUESTED"
    printf '  "count": %d,\n' "$LOG_COUNT"
    printf '  "entries": [\n'
    local i sep row ts src msg
    for ((i = 0; i < ${#LOG_ROWS[@]}; i++)); do
        row="${LOG_ROWS[i]}"
        ts=${row%%$'\x1f'*}; row=${row#*$'\x1f'}
        src=${row%%$'\x1f'*}; msg=${row#*$'\x1f'}
        if (( i == ${#LOG_ROWS[@]} - 1 )); then sep=""; else sep=","; fi
        if [[ -z "$ts" && -z "$src" ]]; then
            # A torn/partial line — the stored row has empty metadata by
            # construction, and the contract promises null, not "".
            printf '    { "timestamp": null, "source": null, "message": "%s" }%s\n' \
                "$(json_escape "$msg")" "$sep"
        else
            printf '    { "timestamp": "%s", "source": "%s", "message": "%s" }%s\n' \
                "$(json_escape "$ts")" "$(json_escape "$src")" "$(json_escape "$msg")" "$sep"
        fi
    done
    printf '  ],\n'
    printf '  "error": %s\n' "$j_error"
    printf '}\n'
    return 0
}

##
# Show the effective remote URL, or set it (persisting it to the config
# file and updating the vault's 'origin' when a vault is present).
##
cmd_remote() {
    section "Remote Configuration"
    load_config_overrides

    local url="${1:-}"
    if [[ -z "$url" ]]; then
        local current
        current=$(remote_url)
        kv "Configured" "${current:-none}"
        if command -v git >/dev/null 2>&1 && [[ -d "$VAULT/.git" ]]; then
            kv "Origin" "$(g remote get-url origin 2>/dev/null || printf 'not set')"
        fi
        if [[ -r "$VAULT/.ob-sync/config" ]]; then
            local vid
            vid=$(vault_conf_get REMOTE 2>/dev/null || printf 'unset')
            kv "Vault identity" ".ob-sync/config → $vid"
        fi
        if [[ -z "$current" ]]; then
            echo
            info "Set one with: ob-sync remote <url>"
            printf '  %sExample:%s https://github.com/<user>/<vault>.git\n' "$C_DIM" "$C_RESET"
        fi
        return 0
    fi

    REMOTE="$url"
    if config_set REMOTE "$url"; then
        success "Remote saved to $CONFIG_FILE"
    else
        error "Cannot write config file: $CONFIG_FILE"
        return 1
    fi

    if [[ -d "$VAULT/.git" ]]; then
        if g remote get-url origin >/dev/null 2>&1; then
            g remote set-url origin "$url" \
                || { error "Failed to update 'origin' in the vault"; return 1; }
        else
            g remote add origin "$url" \
                || { error "Failed to add 'origin' to the vault"; return 1; }
        fi
        success "Vault 'origin' updated"
    fi

    # Keep the vault's identity card in lockstep with origin — it is the
    # copy that travels to every other device.
    vault_conf_write

    info "Next: ob-sync init links the vault, then ob-sync sync"
    return 0
}


##
# ── Scheduled syncs (cron management) ──────────────────────────────────────
#
#   ob-sync cron                              show scheduling status (default)
#   ob-sync cron install <schedule> [HH:MM]   install or replace the schedule
#   ob-sync cron show                         print the managed crontab block
#   ob-sync cron uninstall [-y]               remove the scheduled sync
#
# The job lives in a marker-delimited block inside the user's crontab, so
# `install` can update an existing schedule in place (idempotent) and
# `uninstall` removes exactly the block ob-sync owns — surrounding user
# entries are never touched. The block pins the absolute ob-sync path and
# the current PATH, because a cron environment inherits neither.
##

CRON_BEGIN="# BEGIN ob-sync scheduled sync (managed by: ob-sync cron install)"
CRON_END="# END ob-sync"
CRON_LOG="${OBS_CRON_LOG:-$HOME/ob-sync-cron.log}"

cron_usage() {
    cat <<'EOF'

  USAGE
    ob-sync cron                              Show scheduling status (default)
    ob-sync cron install <schedule> [HH:MM]   Install or update the scheduled sync
    ob-sync cron show                         Print the managed crontab block
    ob-sync cron uninstall [-y]               Remove the scheduled sync

  SCHEDULE
    Presets:  15min | 30min | hourly | daily [HH:MM]
    Or a raw 5-field cron expression: "*/15 9-18 * * 1-5"
EOF
}

# Preset name → 5-field expression. Unknown names return 1.
cron_preset_expr() {
    case "$1" in
        15min|every-15m)             printf '%s' '*/15 * * * *' ;;
        30min|every-30m|half-hourly) printf '%s' '*/30 * * * *' ;;
        hourly|every-hour)           printf '%s' '0 * * * *' ;;
        daily)                       printf '%s' '0 3 * * *' ;;
        *)                           return 1 ;;
    esac
}

# Validate one comma-separated cron field item: number, 3-letter name,
# range, step, or any combination cron accepts.
cron_field_item_ok() {
    [[ "$1" =~ ^(\*|[0-9]{1,4}|[A-Za-z]{3})(-([0-9]{1,4}|[A-Za-z]{3}))?(/[0-9]{1,4})?$ ]]
}

# Validate a complete 5-field cron expression.
cron_expr_valid() {
    local expr="$1" field part
    local -a fields parts
    read -r -a fields <<< "$expr" || return 1
    (( ${#fields[@]} == 5 )) || return 1
    for field in "${fields[@]}"; do
        IFS=',' read -r -a parts <<< "$field" || return 1
        for part in "${parts[@]}"; do
            cron_field_item_ok "$part" || return 1
        done
    done
    return 0
}

cron_hhmm_ok() {
    [[ "$1" =~ ^([01]?[0-9]|2[0-3]):([0-5][0-9])$ ]]
}

##
# Absolute path of the ob-sync executable for the crontab line. The
# installed command is preferred (it survives repository relocation);
# the fallback is this script's own resolved location.
##
cron_self_path() {
    local p
    if p=$(command -v ob-sync 2>/dev/null) && [[ -x "$p" ]]; then
        printf '%s\n' "$p"
        return 0
    fi
    local src="${BASH_SOURCE[0]}"
    if [[ "$src" != /* ]]; then
        src="$PWD/$src"
    fi
    if p=$(readlink -f "$src" 2>/dev/null) && [[ -n "$p" ]]; then
        src="$p"
    fi
    [[ -x "$src" ]] || return 1
    printf '%s\n' "$src"
}

# Read the current crontab (empty output when none exists).
cron_current_table() {
    command -v crontab >/dev/null 2>&1 || return 1
    crontab -l 2>/dev/null || :
    return 0
}

# Drop the managed block from a crontab table (stdin → stdout).
cron_strip_block() {
    awk -v b="$CRON_BEGIN" -v e="$CRON_END" '
        $0 == b { skip = 1; next }
        $0 == e { skip = 0; next }
        !skip   { print }
    '
}

cron_no_crontab_hint() {
    if (( IS_TERMUX )); then
        warn "Termux: pkg install cronie termux-services, then: sv-enable crond"
    else
        warn "No crontab command found — install cron (cronie / vixie-cron) or use a systemd timer"
    fi
}

# Extract the managed sync job line from a crontab table (stdin → stdout).
# Shared by the human `cron status` view and the machine-readable
# status --json document, so both always agree on what is installed.
cron_block_job_line() {
    awk -v b="$CRON_BEGIN" -v e="$CRON_END" '
        $0 == b { inblk = 1; next }
        $0 == e { inblk = 0 }
        inblk && / sync >> / { print; exit }
    '
}

cron_status() {
    if ! command -v crontab >/dev/null 2>&1; then
        kv "Crontab" "not available"
        cron_no_crontab_hint
        return 0
    fi

    local table
    table=$(cron_current_table) || table=""

    if ! grep -qF "$CRON_BEGIN" <<< "$table"; then
        kv "Scheduled" "no"
        echo
        info "Install a schedule with: ob-sync cron install <schedule>"
        printf '  %sPresets:%s 15min · 30min · hourly · daily [HH:MM] — or a raw 5-field expression\n' "$C_DIM" "$C_RESET"
        printf '  %sExample:%s ob-sync cron install hourly\n' "$C_DIM" "$C_RESET"
        return 0
    fi

    kv "Scheduled" "yes"
    local job
    job=$(cron_block_job_line <<< "$table")
    kv "Job" "${job:-malformed block — reinstall with: cron install}"
    if [[ -f "$CRON_LOG" ]]; then
        kv "Cron log" "$CRON_LOG ($(du -h "$CRON_LOG" 2>/dev/null | cut -f1))"
    else
        kv "Cron log" "$CRON_LOG (no output yet)"
    fi
    echo
    info "Remove with: ob-sync cron uninstall"
    return 0
}

cron_show() {
    if ! command -v crontab >/dev/null 2>&1; then
        error "crontab is not available on this system"
        cron_no_crontab_hint
        return 1
    fi
    local table
    table=$(cron_current_table) || table=""
    if ! grep -qF "$CRON_BEGIN" <<< "$table"; then
        info "No scheduled ob-sync job installed"
        info "Install one with: ob-sync cron install <schedule>"
        return 0
    fi
    awk -v b="$CRON_BEGIN" -v e="$CRON_END" '
        $0 == b { inblk = 1 }
        inblk   { print }
        $0 == e { inblk = 0 }
    ' <<< "$table"
    return 0
}

cron_install() {
    if ! command -v crontab >/dev/null 2>&1; then
        error "crontab is not available on this system"
        cron_no_crontab_hint
        return 1
    fi

    local -a pos=()
    while (( $# > 0 )); do
        case "$1" in
            # Accepted for symmetry with other commands; install prompts for
            # nothing, so there is nothing to auto-confirm.
            -y|--yes) ASSUME_YES=1; shift ;;
            *)        pos+=("$1"); shift ;;
        esac
    done

    if (( ${#pos[@]} > 2 )); then
        error "Too many arguments for cron install"
        cron_usage
        return 1
    fi

    local preset="${pos[0]:-}" at="${pos[1]:-}"
    if [[ -z "$preset" ]]; then
        error "cron install needs a schedule"
        cron_usage
        return 1
    fi

    # "daily@09:30" — merge the single-token form into preset + time.
    if [[ "$preset" == daily@* ]]; then
        at="${preset#daily@}"
        preset="daily"
    fi

    local expr
    if expr=$(cron_preset_expr "$preset"); then
        if [[ -n "$at" ]]; then
            if [[ "$preset" != "daily" ]]; then
                error "A time is only accepted with the 'daily' preset"
                return 1
            fi
            cron_hhmm_ok "$at" || {
                error "Invalid time: $at (expected HH:MM, e.g. 09:30)"
                return 1
            }
            expr="$((10#${at#*:})) $((10#${at%%:*})) * * *"
        elif [[ "$preset" == "daily" ]]; then
            info "Default daily time is 03:00 — change with: ob-sync cron install daily HH:MM"
        fi
    else
        if [[ -n "$at" ]]; then
            error "Unexpected extra argument: $at"
            cron_usage
            return 1
        fi
        cron_expr_valid "$preset" || {
            error "Invalid cron expression: $preset"
            warn "Expected a 5-field expression (e.g. '*/15 * * * *') or a preset:"
            warn "  15min · 30min · hourly · daily [HH:MM]"
            return 1
        }
        expr="$preset"
    fi

    # cronie truncates a line at the first UNESCAPED % and a newline
    # would install a rogue second job — none of these can appear in a
    # legitimate 5-field schedule, so refuse them outright.
    case "$expr" in
        *$'\n'*|*%*|*\\*)
            error "Invalid cron expression: newline, % or backslash are not allowed"
            warn "A % would truncate the job line; a newline would install a second job"
            return 1 ;;
    esac

    local self
    self=$(cron_self_path) || {
        error "Cannot locate the ob-sync executable for the crontab line"
        return 1
    }

    step "Building the managed crontab block"
    local table stripped tmp
    table=$(cron_current_table) || table=""
    stripped=$(cron_strip_block <<< "$table")

    # cronie truncates a command at the first unescaped `%` (quotes do
    # NOT protect it) and feeds the remainder to the command as stdin —
    # a `%` in a path would silently break the scheduled sync. A newline
    # would split the crontab into a rogue extra job: refuse that.
    local job_self="$self" job_log="$CRON_LOG"
    if [[ "$job_self" == *$'\n'* || "$job_log" == *$'\n'* ]]; then
        error "Cannot schedule: executable or log path contains a newline"
        return 1
    fi
    if [[ "$job_self" == *\\* || "$job_log" == *\\* ]]; then
        # A backslash directly before the escaped % (e.g. a log path
        # ending in "\%Y") would produce \\% — cronie then truncates at
        # the % anyway and the job breaks silently. Fail closed.
        error "Cannot schedule: executable or log path contains a backslash"
        warn "A backslash before % would defeat the escaping and silently break the job"
        return 1
    fi
    job_self=${job_self//%/\\%}
    job_log=${job_log//%/\\%}

    tmp=$(mktemp) || { error "Cannot create a temporary file"; return 1; }
    temp_register "$tmp"
    {
        [[ -n "$stripped" ]] && printf '%s\n' "$stripped"
        printf '%s\n' "$CRON_BEGIN"
        # NOTE: cron applies env assignments positionally — this PATH=
        # line also governs user jobs appended BELOW the managed block.
        # Documented caveat; moving it into the job line would change the
        # block format existing installs and the test-suite assert.
        printf 'PATH=%s\n' "$PATH"
        printf '%s "%s" sync >> "%s" 2>&1\n' "$expr" "$job_self" "$job_log"
        printf '%s\n' "$CRON_END"
    } > "$tmp"

    step "Installing crontab"
    if ! crontab "$tmp"; then
        error "crontab refused the new table — nothing was changed"
        return 1
    fi

    success "Scheduled sync installed"
    kv "Schedule" "$expr"
    kv "Command" "$self sync"
    kv "Cron log" "$CRON_LOG"
    echo
    info "Verify with: ob-sync cron status   ·   Remove with: ob-sync cron uninstall"

    # Guard rails: warn about the two failure modes that make a scheduled
    # sync useless before it ever fires.
    if [[ -z "$REMOTE" ]] && [[ -z "$(config_get REMOTE || :)" ]]; then
        warn "No remote configured yet — the scheduled sync will fail until 'ob-sync init' sets one"
    fi
    if [[ ! -d "${VAULT:-}" ]]; then
        warn "Vault not resolved on this machine — run 'ob-sync init' (cron resolves it from the config file)"
    fi
    return 0
}

cron_uninstall() {
    local -a pos=()
    while (( $# > 0 )); do
        case "$1" in
            -y|--yes) ASSUME_YES=1; shift ;;
            *)        error "Unknown uninstall option: $1"; return 1 ;;
        esac
    done

    if ! command -v crontab >/dev/null 2>&1; then
        error "crontab is not available on this system"
        cron_no_crontab_hint
        return 1
    fi

    local table
    table=$(cron_current_table) || table=""

    if ! grep -qF "$CRON_BEGIN" <<< "$table"; then
        info "No scheduled ob-sync job found — nothing to remove"
        return 0
    fi

    # Fail-closed consent: uninstalling harms no data, but silently
    # switching off someone's automation from a script is never OK.
    if (( ! ASSUME_YES )); then
        if [[ -t 0 ]]; then
            local reply=""
            read -r -p "  Remove the scheduled sync? [y/N]: " reply || :
            if [[ ! "$reply" =~ ^[Yy]$ ]]; then
                info "Cancelled — the scheduled sync is untouched"
                return 1
            fi
        else
            error "Refusing to remove the scheduled sync without consent (use: ob-sync cron uninstall -y)"
            return 1
        fi
    fi

    local stripped tmp
    stripped=$(cron_strip_block <<< "$table")
    tmp=$(mktemp) || { error "Cannot create a temporary file"; return 1; }
    temp_register "$tmp"
    [[ -n "$stripped" ]] && printf '%s\n' "$stripped" > "$tmp"

    if [[ ! -s "$tmp" ]]; then
        # The managed block was the only content — drop the crontab entirely.
        crontab -r 2>/dev/null || :
    elif ! crontab "$tmp"; then
        error "crontab refused the update — nothing was changed"
        return 1
    fi

    success "Scheduled sync removed"
    return 0
}

##
# Entry point. Runs without setup(): scheduling is system configuration
# and must work even before `init` has ever been used on this machine.
##
cmd_cron() {
    section "Scheduled Sync (cron)"
    load_config_overrides

    local sub="${1:-status}"
    if (( $# > 0 )); then shift; fi

    case "$sub" in
        status)           cron_status ;;
        show)             cron_show ;;
        install)          cron_install "$@" ;;
        uninstall|remove) cron_uninstall "$@" ;;
        help|-h|--help)   cron_usage; return 0 ;;
        *)
            error "Unknown cron subcommand: $sub"
            cron_usage
            return 1
            ;;
    esac
}


##
# Open the per-machine config file in the user's editor. Creates a
# commented starter template on first use so the file is never empty and
# never mysterious. Editing needs a real terminal — scripted sessions get
# the file path plus a hint instead.
##
cmd_edit_conf() {
    section "Configuration File"

    if [[ ! -f "$CONFIG_FILE" ]]; then
        if [[ "$CONFIG_FILE" == */* ]]; then
            mkdir -p "${CONFIG_FILE%/*}" || {
                error "Cannot create the config directory: ${CONFIG_FILE%/*}"
                return 1
            }
        fi
        {
            printf '# ob-sync configuration — KEY=VALUE, one per line\n'
            printf '# These values are used by every shell, including cron jobs.\n'
            printf '#\n'
            printf '# VAULT=/path/to/your/vault\n'
            printf '# REMOTE=https://github.com/you/vault.git\n'
            printf '# BRANCH=main\n'
        } > "$CONFIG_FILE" || {
            error "Cannot write: $CONFIG_FILE"
            return 1
        }
        info "Created a starter config"
    fi

    if [[ ! -t 0 ]]; then
        error "edit-conf needs an interactive terminal"
        kv "File" "$CONFIG_FILE"
        info "Open it manually, or use: EDITOR=nano ob-sync edit-conf"
        return 1
    fi

    local ed="${EDITOR:-${VISUAL:-vi}}"
    local -a edcmd=()
    read -r -a edcmd <<< "$ed" || :
    if (( ${#edcmd[@]} == 0 )); then
        error "EDITOR is empty — set it, e.g.: export EDITOR=nano"
        return 1
    fi
    command -v "${edcmd[0]}" >/dev/null 2>&1 || {
        error "Editor not found: ${edcmd[0]}"
        warn "Set EDITOR, e.g.: export EDITOR=nano"
        return 1
    }

    kv "File" "$CONFIG_FILE"
    kv "Editor" "$ed"
    "${edcmd[@]}" "$CONFIG_FILE" || {
        error "Editor exited with an error"
        return 1
    }
    success "Config closed — changes apply on the next ob-sync run"
    return 0
}


##
# Read-only overview of pending working-tree changes: per-file status with
# human labels plus a compact diff summary. Never mutates anything — safe
# to run at any time, even while another operation holds the lock.
##
cmd_diff() {
    section "Pending Changes"

    local -a lines=()
    local line
    while IFS= read -r line; do
        [[ -n "$line" ]] && lines+=("$line")
    done < <(g status --porcelain 2>/dev/null)

    if (( ${#lines[@]} == 0 )); then
        success "Working tree is clean — nothing pending"
        return 0
    fi
    success "${#lines[@]} changed file(s)"

    local xy x y path desc color
    for line in "${lines[@]}"; do
        xy=${line:0:2}
        path=${line:3}
        x=${xy:0:1}
        y=${xy:1:1}
        color="$C_YELLOW"
        desc=""
        if [[ "$x" == "U" || "$y" == "U" || "$xy" == "AA" || "$xy" == "DD" ]]; then
            desc="CONFLICT"; color="$C_BRIGHT_RED"
        elif [[ "$x" == "?" ]]; then
            desc="untracked"; color="$C_BRIGHT_YELLOW"
        elif [[ "$x" == "!" ]]; then
            desc="ignored"; color="$C_DIM"
        else
            [[ "$x" != " " ]] && desc="staged"
            [[ "$y" != " " ]] && desc="${desc:+$desc + }modified"
        fi
        printf '  %s%-3s%s %s  %s(%s)%s\n' \
            "$color" "$xy" "$C_RESET" "$path" "$C_DIM" "${desc:-changed}" "$C_RESET"
    done

    # Compact stat for tracked changes (an unborn repository has no HEAD).
    if g rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
        local stat
        stat=$(g diff HEAD --stat 2>/dev/null | head -n 15)
        if [[ -n "$stat" ]]; then
            echo
            printf '  %s%s%s\n' "$C_BOLD" "Diff summary" "$C_RESET"
            while IFS= read -r line; do
                printf '  %s%s%s\n' "$C_DIM" "$line" "$C_RESET"
            done <<< "$stat"
        fi
    fi
    return 0
}

##
# Read-only view of the vault's commit history with relative dates.
# Explains the unborn-branch case instead of failing on fresh repositories.
# @param $1  number of commits to show (default 10, capped at 100)
##
# ── Vault history ──────────────────────────────────────────────────────────
#
#   usage:  cmd_history [--json] [n]   (n defaults to 10, capped at 100)
#
# Human mode is byte-identical to the pre-9.2.0 command. --json mode
# (SILENT_UI, set in main()) captures one row per commit and emits a
# machine-readable document. Read-only in both modes — history never
# takes the lock.
##
cmd_history() {
    local json=0
    local -a pos=()
    while (( $# )); do
        case "$1" in
            --json) json=1; shift ;;
            # -y is a no-op here (history never prompts) but accepted so
            # that the `ob-sync <cmd> -y` muscle memory keeps working.
            -y|--yes) :; shift ;;
            --)      shift; pos+=("$@"); break ;;
            -*)      error "Unknown option for history: $1"
                     warn "Usage: ob-sync history [--json] [n]"
                     return 1 ;;
            *)       pos+=("$1"); shift ;;
        esac
    done

    local n="${pos[0]:-10}"
    [[ "$n" =~ ^[0-9]+$ ]] || n=10
    (( n > 100 )) && n=100

    if (( ! json )); then
        history_run "$n"
        return $?
    fi

    HISTORY_REQUESTED=$n
    HISTORY_ROWS=()
    HISTORY_COUNT=0

    history_run "$n"
    local rc=$?
    history_emit_json "$rc"
    return "$rc"
}

##
# Human history view — byte-identical to the pre-9.2.0 command. In --json
# mode (SILENT_UI) commits are captured into HISTORY_ROWS instead of
# printed; the section banner is skipped for the same reason as in log:
# section() is demoted to the log file under SILENT_UI, so a banner here
# would become the newest entry in the very document being emitted.
##
history_run() {
    (( SILENT_UI )) || section "Vault History"

    local n="$1"

    if ! g rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
        if g symbolic-ref --quiet HEAD >/dev/null 2>&1; then
            info "No commits yet — the first sync creates history"
            # An unborn but well-formed HEAD is VALID empty data for a
            # machine consumer (mirrors the human message), not an error.
            return 0
        fi
        error "Repository history is unreadable"
        warn "Fix: ob-sync repair"
        return 1
    fi

    # g log's exit status decides "unreadable repository" — a process
    # substitution hides it, so the listing goes through a temp file and
    # the rc is checked (pre-9.2.3 a corrupted object store silently
    # reported an EMPTY history with rc 0, violating the
    # history_unreadable contract).
    local log_tmp log_rc=0
    log_tmp=$(mktemp) || { error "Cannot create a temporary file"; return 1; }
    temp_register "$log_tmp"
    local hash when author subject
    if (( SILENT_UI )); then
        # Machine mode: full hash (unambiguous) + ISO 8601 strict date
        # (stable and sortable) + author — a contract, not a display.
        # Fields are delimited with 0x01, which git emits only as our
        # separator — a tab inside an author name (legal in a git ident)
        # would otherwise shift attribution. `git log --pretty=format:`
        # emits NO trailing newline, so the final read returns non-zero
        # with the variables still populated — the plain `while read`
        # form silently DROPPED the newest commit (pre-9.2.0 bug).
        # `|| [[ -n $hash ]]` keeps that line.
        g log --pretty=format:'%H%x01%cI%x01%an%x01%s' -n "$n" > "$log_tmp" 2>/dev/null || log_rc=$?
        while IFS=$'\x01' read -r hash when author subject || [[ -n "$hash" ]]; do
            [[ -n "$hash" ]] || continue
            HISTORY_COUNT=$((HISTORY_COUNT + 1))
            # 0x1f (unit separator) — subject lines are free text and can
            # contain anything except control characters.
            HISTORY_ROWS+=("$(printf '%s\x1f%s\x1f%s\x1f%s' "$hash" "$when" "$author" "$subject")")
        done < "$log_tmp"
    else
        # Human mode — byte-identical to the pre-9.2.0 output (short
        # hash, relative date), minus the dropped-newest-commit bug.
        g log --pretty=format:'%h%x09%cr%x09%s' -n "$n" > "$log_tmp" 2>/dev/null || log_rc=$?
        while IFS=$'\t' read -r hash when subject || [[ -n "$hash" ]]; do
            [[ -n "$hash" ]] || continue
            printf '  %s%s%s  %s(%s)%s  %s\n' \
                "$C_BRIGHT_CYAN" "$hash" "$C_RESET" \
                "$C_DIM" "$when" "$C_RESET" \
                "$subject"
        done < "$log_tmp"
    fi
    if (( log_rc != 0 )); then
        error "Repository history is unreadable"
        warn "Fix: ob-sync repair"
        return 1
    fi
    return 0
}

##
# Emit the machine-readable history document. Called only from
# cmd_history in --json mode: SILENT_UI (set in main()) guarantees this
# document is the ONLY thing on stdout.
#
# Shape (stable — see README "Machine-Readable Everything"):
#   { version, command: "history", requested, count,
#     commits: [ { hash: <full sha>, date: <ISO 8601 strict>,
#                  author, subject } ], error: {code,message}|null }
# The full hash keeps the document unambiguous (jq users can shorten it);
# the date is ISO 8601 strict — a stable, sortable contract, unlike the
# relative "%cr" strings the human view shows. An unborn repository (no
# commits yet) is valid empty data (count 0, rc 0); rc 1 with code
# history_unreadable only when the repository itself cannot be read.
##
history_emit_json() {
    local rc="$1"
    local j_error="null"
    if (( rc != 0 )); then
        j_error="{ \"code\": \"history_unreadable\", \"message\": \"Repository history is unreadable\" }"
    fi

    printf '{\n'
    printf '  "version": "%s",\n' "$VERSION"
    printf '  "command": "history",\n'
    printf '  "requested": %d,\n' "$HISTORY_REQUESTED"
    printf '  "count": %d,\n' "$HISTORY_COUNT"
    printf '  "commits": [\n'
    local i sep row hash date author subject
    for ((i = 0; i < ${#HISTORY_ROWS[@]}; i++)); do
        row="${HISTORY_ROWS[i]}"
        hash=${row%%$'\x1f'*};  row=${row#*$'\x1f'}
        date=${row%%$'\x1f'*};  row=${row#*$'\x1f'}
        author=${row%%$'\x1f'*}; subject=${row#*$'\x1f'}
        if (( i == ${#HISTORY_ROWS[@]} - 1 )); then sep=""; else sep=","; fi
        printf '    { "hash": "%s", "date": "%s", "author": "%s", "subject": "%s" }%s\n' \
            "$(json_escape "$hash")" "$(json_escape "$date")" \
            "$(json_escape "$author")" "$(json_escape "$subject")" "$sep"
    done
    printf '  ],\n'
    printf '  "error": %s\n' "$j_error"
    printf '}\n'
    return 0
}

##
# Read-only dump of the effective configuration: what ob-sync will use on
# the next run and where every value came from. The debugging aid for
# "why is it syncing THAT vault / pushing to THAT remote".
##
cmd_config() {
    section "Effective Configuration"
    load_config_overrides

    kv "Version" "$VERSION"
    if (( IS_TERMUX )); then
        kv "Platform" "Termux ${TERMUX_VERSION:-} (Android)"
    else
        kv "Platform" "${OSTYPE:-unknown}"
    fi

    echo
    echo "  ${C_BOLD}${C_CYAN}Vault${C_RESET}"
    kv "Path" "$VAULT"
    kv "Resolution source" "$VAULT_SOURCE"
    kv "Config file" "$([[ -r "$CONFIG_FILE" ]] && printf '%s (present)' "$CONFIG_FILE" || printf '%s (absent)' "$CONFIG_FILE")"

    echo
    echo "  ${C_BOLD}${C_CYAN}Git${C_RESET}"
    local eff_remote=""
    eff_remote=$(remote_url 2>/dev/null)
    kv "Remote (effective)" "${eff_remote:-not set}"
    if command -v git >/dev/null 2>&1 && [[ -d "$VAULT/.git" ]]; then
        kv "Origin" "$(g remote get-url origin 2>/dev/null || printf 'not set')"
    fi
    kv "Branch" "$BRANCH"
    kv "Network watchdog" "$(
        if (( GIT_TIMEOUT == 0 )); then printf 'disabled (OBS_GIT_TIMEOUT=0)'
        elif (( HAS_TIMEOUT )); then printf 'active (%ss)' "$GIT_TIMEOUT"
        else printf "inactive ('timeout' not found)"
        fi)"
    kv "Local watchdog" "$(
        if (( LOCAL_TIMEOUT == 0 )); then printf 'disabled (OBS_LOCAL_TIMEOUT=0)'
        elif (( HAS_TIMEOUT )); then printf 'active (%ss)' "$LOCAL_TIMEOUT"
        else printf "inactive ('timeout' not found)"
        fi)"

    echo
    echo "  ${C_BOLD}${C_CYAN}Backups & behaviour${C_RESET}"
    kv "Backup directory" "$BACKUP_DIR"
    kv "Retention" "$KEEP_BACKUPS backup(s)"
    kv "Pre-sync backup" "$( [[ "$SKIP_BACKUP" == "1" ]] && printf 'disabled (OBS_SKIP_BACKUP=1)' || printf 'enabled' )"
    kv "Attach dir" "$ATTACH_DIR"
    kv "Log file" "${LOG_FILE:-disabled}"
    # Read the whole table first: `crontab -l | grep -q` dies of SIGPIPE
    # on large crontabs (grep exits early, the producer gets rc 141) and
    # the check would falsely report "not installed".
    local cron_table=""
    if command -v crontab >/dev/null 2>&1; then
        cron_table=$(crontab -l 2>/dev/null) || cron_table=""
    fi
    if [[ "$cron_table" == *"$CRON_BEGIN"* ]]; then
        kv "Scheduled sync" "installed (details: ob-sync cron status)"
    else
        kv "Scheduled sync" "not installed"
    fi

    # Show the raw config file (it only holds non-secret KEY=VALUE lines).
    if [[ -r "$CONFIG_FILE" ]]; then
        local cfg_line
        echo
        echo "  ${C_BOLD}${C_CYAN}Config file contents${C_RESET}"
        while IFS= read -r cfg_line; do
            [[ -n "$cfg_line" ]] && printf '    %s\n' "$cfg_line"
        done < "$CONFIG_FILE"
    fi
    return 0
}


# ═════════════════════════════════════════════════════════════════════════════
#  13. INTERACTIVE MENU (mobile-friendly)
# ═════════════════════════════════════════════════════════════════════════════

##
# Session vault switcher for the interactive menu.
#
# The config file pins exactly one vault on purpose — cron, scripts and
# Tasker shortcuts must always hit the same target. The side effect was
# a menu locked to that vault forever, even with several vaults and a
# separate remote each. This picker runs at menu launch and on option
# 19): it lists the pinned vault plus every auto-discovered one, keeps
# the pinned vault preselected, and — when the user picks a different
# vault — re-wires the session to THAT vault's own 'origin' and branch,
# so two vaults with two remotes can never cross-sync.
#
# Deliberately session-only: the config file is never rewritten here,
# so scheduled syncs keep their pinned vault. Re-pin with init (18).
#
# @param $1 "force" — show the list even with a single vault (used by
#            the explicit menu item; the startup call skips silently)
##

##
# 9.5.2 — switch the session to an already-resolved absolute path.
# Shared tail of every switch path (numbered picker, manual entry): the
# non-vault confirmation, the not-a-repo warning, the identity-card
# reconciliation and the remote report all live here, in one place.
# The config file is never rewritten — session-only, cron keeps its pin.
# @return 0 when the session vault changed, 1 when it did not
##
session_switch_to() {
    local picked="$1"
    if [[ "$picked" == "$VAULT" ]]; then
        info "Already active: $VAULT"
        return 1
    fi
    if [[ ! -d "$picked/.obsidian" ]]; then
        warn "No .obsidian inside: $picked — it may not be an Obsidian vault"
        local ans=""
        read -r -p "  Use it anyway? [y/N] " ans || return 1
        case "$ans" in
            y|Y) : ;;
            *)   info "Keeping: $VAULT"; return 1 ;;
        esac
    fi
    if [[ ! -e "$picked/.git" ]]; then
        warn "Not a git repository yet — run 18) Init or 7) Repair inside it before syncing"
    fi

    # Re-bind the session to this vault's own git metadata. The config
    # REMOTE/BRANCH belong to the pinned vault and must NOT leak across
    # vaults — two vaults with two separate remotes would otherwise
    # cross-sync (repair would clone the foreign repo, quick would push
    # into it). bind_session_remote resolves THIS vault's origin and only
    # falls back to the config file when this vault is the pinned one.
    VAULT="$picked"
    VAULT_SOURCE="menu (this session)"
    bind_session_remote
    # The freshly picked vault may carry its own identity card
    # (.ob-sync/config): align origin with it right away, so the remote
    # report below and every command dispatched from this menu session
    # see the vault's OWN remote — never another vault's.
    ALLOW_VAULT_CONF=1
    vault_conf_reconcile

    success "Vault switched for this session: $VAULT"
    local eff_remote
    eff_remote=$(remote_url 2>/dev/null) || eff_remote=""
    if [[ -z "$eff_remote" ]]; then
        warn "This vault has no remote yet — sync/quick/repair will refuse until one is connected"
        warn "Connect it with: ob-sync remote <url>   (or 18) Init)"
    else
        info "Remote: $eff_remote"
    fi
    warn "Session-only — cron keeps the pinned vault. Re-pin with 18) Init."
    return 0
}

##
# 9.5.2 — validate a path typed by the user and switch to it (the front
# door of every manual-entry prompt). ~ is expanded; the directory must
# exist and is canonicalized before session_switch_to takes over.
# @return 0 when the session vault changed, 1 when it did not
##
try_user_path() {
    local p="${1-}"
    p="${p/#\~/$HOME}"
    if [[ ! -d "$p" ]]; then
        error "No such directory: $p — keeping: $VAULT"
        return 1
    fi
    session_switch_to "$(cd "$p" 2>/dev/null && pwd -P)"
}

pick_vault_menu() {
    [[ -t 0 ]] || return 0
    local force=0
    [[ "${1:-}" == "force" ]] && force=1

    local -a cands=()
    local -A seen=()
    local cfg cur="" c picked tag reply="" default i

    # The pinned vault leads the list and stays the default choice.
    cfg=$(config_get VAULT) || :
    if [[ -n "$cfg" && -d "$cfg" ]]; then
        cands+=("$cfg")
        seen["$cfg"]=1
        cur="$cfg"
    fi
    while IFS= read -r c; do
        [[ -n "$c" ]] || continue
        [[ -n "${seen[$c]:-}" ]] && continue
        seen["$c"]=1
        cands+=("$c")
    done < <(discover_vaults)

    if (( ${#cands[@]} == 0 )); then
        (( force )) || return 0
        warn "No vault found — set one up with 18) Init, or type a full vault path now."
        read -r -p "  Full path (empty = keep $VAULT): " reply || :
        [[ -z "$reply" ]] && return 0
        try_user_path "$reply" || :
        return 0
    fi
    if (( ${#cands[@]} == 1 )); then
        (( force )) || return 0
        info "Only one vault known: ${cands[0]}"
        read -r -p "  Press Enter to keep it, or type a full vault path: " reply || :
        [[ -z "$reply" ]] && return 0
        try_user_path "$reply" || :
        return 0
    fi

    warn "Multiple vaults available — pick one for this session:"
    default=1
    for i in "${!cands[@]}"; do
        c="${cands[$i]}"
        tag=""
        if [[ "$c" == "$cur" ]]; then
            tag="  ${C_DIM}(last used — press Enter to keep it)${C_RESET}"
            default=$((i + 1))
        fi
        printf '    %s%d)%s %s%s\n' "$C_CYAN" "$((i + 1))" "$C_RESET" "$c" "$tag"
    done
    printf '\n'
    read -r -p "  Select vault [${default}] (number or full path): " reply || :
    reply="${reply:-$default}"

    picked=""
    if [[ "$reply" =~ ^[0-9]+$ ]] && (( reply >= 1 && reply <= ${#cands[@]} )); then
        picked="${cands[reply - 1]}"
    elif [[ -n "$reply" ]]; then
        # 9.5.2: a typed path is validated honestly — ~ works, and a
        # wrong path is named instead of a generic "invalid selection".
        reply="${reply/#\~/$HOME}"
        if [[ ! -d "$reply" ]]; then
            error "No such directory: $reply — keeping: $VAULT"
            return 0
        fi
        picked=$(cd "$reply" 2>/dev/null && pwd -P) || picked=""
    fi
    if [[ -z "$picked" ]]; then
        error "Invalid selection — keeping: $VAULT"
        return 0
    fi
    # Validation, identity-card reconciliation and the session-only
    # warnings all live in session_switch_to now (shared with the
    # manual-entry prompts above).
    session_switch_to "$picked" || :
    return 0
}


##
# Draw the menu screen with a live status summary.
##
show_menu() {
    # Clear the screen; fall back to clear(1) if the escape codes fail.
    printf '\033[2J\033[H' 2>/dev/null || clear 2>/dev/null || :

    local branch="-" changes="0"
    if command -v git >/dev/null 2>&1 && [[ -d "$VAULT/.git" ]]; then
        branch=$(g branch --show-current 2>/dev/null) || branch="-"
        [[ -n "$branch" ]] || branch="-"
        changes=$(g status --porcelain 2>/dev/null | wc -l | tr -d ' ')
        [[ -n "$changes" ]] || changes="0"
    fi

    echo
    printf '  %s%s──────────────────────────────────────────%s\n' "$C_BRIGHT_CYAN" "$C_BOLD" "$C_RESET"
    printf '  %s%s    OBSIDIAN SYNC TOOL  ·  v%s%s\n' "$C_BRIGHT_CYAN" "$C_BOLD" "$VERSION" "$C_RESET"
    printf '  %s%s──────────────────────────────────────────%s\n' "$C_BRIGHT_CYAN" "$C_BOLD" "$C_RESET"
    echo
    printf '  %sVault:%s   %s\n' "$C_CYAN" "$C_RESET" "$VAULT"
    printf '  %sBranch:%s  %s\n' "$C_CYAN" "$C_RESET" "$branch"
    printf '  %sChanges:%s %s\n' "$C_CYAN" "$C_RESET" "$changes"
    if [[ -f "$STATE_FILE" ]]; then
        printf '  %sLast:%s    %s\n' "$C_CYAN" "$C_RESET" "$(cat "$STATE_FILE" 2>/dev/null || printf '-')"
    fi
    echo
    printf '  %sMENU%s\n' "$C_BOLD" "$C_RESET"
    printf '  %s------------------------------------------%s\n' "$C_DIM" "$C_RESET"
    echo
    printf '  %s1)%s Sync      %sbackup + rebase + push%s\n'       "$C_BRIGHT_GREEN"   "$C_RESET" "$C_DIM" "$C_RESET"
    printf '  %s2)%s Pull      %sintegrate remote changes%s\n'     "$C_BRIGHT_CYAN"    "$C_RESET" "$C_DIM" "$C_RESET"
    printf '  %s3)%s Push      %spublish local changes%s\n'        "$C_BRIGHT_BLUE"    "$C_RESET" "$C_DIM" "$C_RESET"
    printf '  %s4)%s Backup    %screate a verified backup%s\n'     "$C_BRIGHT_MAGENTA" "$C_RESET" "$C_DIM" "$C_RESET"
    printf '  %s5)%s Restore   %sroll back from a backup%s\n'      "$C_BRIGHT_YELLOW"  "$C_RESET" "$C_DIM" "$C_RESET"
    printf '  %s6)%s Verify    %scheck backup integrity%s\n'       "$C_BRIGHT_WHITE"   "$C_RESET" "$C_DIM" "$C_RESET"
    printf '  %s7)%s Repair    %srebuild git metadata%s\n'         "$C_BRIGHT_RED"     "$C_RESET" "$C_DIM" "$C_RESET"
    printf '  %s8)%s Organize  %saudit notes & attachments%s\n'    "$C_BRIGHT_CYAN"    "$C_RESET" "$C_DIM" "$C_RESET"
    printf '  %s9)%s Status    %svault overview%s\n'               "$C_BRIGHT_GREEN"   "$C_RESET" "$C_DIM" "$C_RESET"
    printf '  %s10)%s Health   %sgit integrity check%s\n'          "$C_BRIGHT_BLUE"    "$C_RESET" "$C_DIM" "$C_RESET"
    printf '  %s11)%s Doctor   %sdiagnose environment%s\n'         "$C_BRIGHT_MAGENTA" "$C_RESET" "$C_DIM" "$C_RESET"
    printf '  %s12)%s Quick    %sbackup + sync, one shot%s\n'      "$C_BRIGHT_CYAN"    "$C_RESET" "$C_DIM" "$C_RESET"
    printf '  %s13)%s Diff      %spending changes%s\n'          "$C_BRIGHT_YELLOW"  "$C_RESET" "$C_DIM" "$C_RESET"
    printf '  %s14)%s Config    %seffective settings%s\n'        "$C_BRIGHT_WHITE"   "$C_RESET" "$C_DIM" "$C_RESET"
    printf '  %s15)%s Remote    %sshow or set the remote%s\n'    "$C_BRIGHT_GREEN"   "$C_RESET" "$C_DIM" "$C_RESET"
    printf '  %s16)%s Cron      %sschedule automatic syncs%s\n'  "$C_BRIGHT_MAGENTA" "$C_RESET" "$C_DIM" "$C_RESET"
    printf '  %s17)%s EditConf  %sedit the config file%s\n'      "$C_BRIGHT_YELLOW"  "$C_RESET" "$C_DIM" "$C_RESET"
    printf '  %s18)%s Init      %snew vault / first-time setup%s\n' "$C_BRIGHT_CYAN"    "$C_RESET" "$C_DIM" "$C_RESET"
    printf '  %s19)%s Switch    %spick another vault (session)%s\n' "$C_BRIGHT_YELLOW"  "$C_RESET" "$C_DIM" "$C_RESET"
    printf '  %s0)%s Exit     %squit the tool%s\n'                 "$C_BRIGHT_RED"     "$C_RESET" "$C_DIM" "$C_RESET"
    echo
    printf '  %s------------------------------------------%s\n' "$C_DIM" "$C_RESET"
    echo
}

##
# Main menu loop. Every action goes through the shared dispatcher, so
# validation and locking behave exactly like CLI mode. The lock is
# acquired and released around each individual operation.
##
main_menu() {
    # Session vault switcher (multi-vault support) — runs before the
    # first screen so the menu always targets the vault the user meant.
    pick_vault_menu
    while true; do
        show_menu
        local choice=""
        read -r -p "  Select an option [0-19]: " choice || { echo; exit 0; }

        case "$choice" in
            1)  dispatch sync ;;
            2)  dispatch pull ;;
            3)  dispatch push ;;
            4)  dispatch backup ;;
            5)  dispatch restore ;;
            6)  dispatch verify ;;
            7)  dispatch repair ;;
            8)  dispatch organize ;;
            9)  dispatch status ;;
            10) dispatch health ;;
            11) dispatch doctor ;;
            12) dispatch quick ;;
            13) dispatch diff ;;
            14) dispatch config ;;
            15) dispatch remote ;;
            16) dispatch cron ;;
            17) dispatch edit-conf ;;
            18) dispatch init ;;
            19) pick_vault_menu force ;;
            0)  echo; success "Goodbye!"; echo; exit 0 ;;
            *)  error "Invalid choice: $choice"; sleep 1; continue ;;
        esac

        echo
        read -r -p "  Press Enter to return to the menu..." _ || exit 0
    done
}


# ═════════════════════════════════════════════════════════════════════════════
#  14. HELP & VERSION
# ═════════════════════════════════════════════════════════════════════════════

cmd_help() {
    cat <<EOF
  ob-sync ${VERSION} — Obsidian Git Sync for Termux, Linux & macOS

  USAGE
    ob-sync                     Interactive menu (default on a terminal)
    ob-sync [options] <command> [args]

  COMMANDS
    sync                  Full sync: check → backup → commit → fetch → rebase → push
                          (add --json for a machine-readable result document)
    pull                  Commit local changes, then integrate remote updates
                          (add --json for a machine-readable result document)
    push                  Commit local changes, then push to the remote
                          (add --json for a machine-readable result document)
    quick                 Verified backup + full sync in one step
                          (add --json for a machine-readable result document)
    backup                Create and verify a full vault backup
                          (add --json for a machine-readable result document)
    restore [target]      Restore from a backup ('latest', name, or path);
                          add --list to preview contents, --dry-run to
                          rehearse the restore, --list --json for a
                          machine-readable preview/inventory, or
                          --json <target> -y for a machine-readable
                          restore result (scripted DR drills)
    verify [--json]       Verify the integrity of every stored backup
                          (--json for a machine-readable report)
    repair                Rebuild git metadata from remote (files preserved)
    organize [--fix]      Audit empty notes, big files & orphaned attachments
                          (add --json for a machine-readable report;
                          --fix --json reports every moved/skipped file)
    diff                  Show pending working-tree changes (read-only)
    history [n]           Show the last n vault commits (default: 10)
                          (add --json for a machine-readable document)
    config                Show the effective configuration and its sources
    status [--json]       Show vault, git and backup overview (--json for scripts)
    health [--json]       Deep repository integrity check
                          (--json for a machine-readable report)
    doctor [--json]       Diagnose platform, tools, storage, remote and
                          watchdog (--json for a machine-readable report)
    init                  First-time setup: clone or adopt an existing vault
    remote [url]          Show the remote URL, or set and persist a new one
                          (origin and the vault's .ob-sync/config stay in sync)
    cron [sub]            Scheduled syncs: status (default), install <sched>
                          [HH:MM], show, uninstall
    edit-conf             Edit the config file in \$EDITOR (starter created)
    update                Check the latest GitHub release and self-update the
                          installed tool (runs automatically on interactive
                          launch; offline prints a notice and continues)
    menu                  Launch the interactive menu
    log [n]               Show the last n log entries (default: 20)
                          (add --json for a machine-readable document)
    help                  Show this help
    version               Show version information

  OPTIONS
    -y, --yes             Assume "yes" for all interactive prompts
                          (valid before or after the command)
    -n, --no-color        Disable colored output (or set NO_COLOR=1)
    -h, --help            Show this help
    -v, --version         Show version information

  ENVIRONMENT
    OBS_VAULT             Vault path override (highest precedence)
    OBS_CONFIG            Config file (default: ~/.config/ob-sync/config);
                          stores VAULT, REMOTE and BRANCH written by init/remote;
                          vault resolution: OBS_VAULT > config file >
                          auto-detection (dir containing .obsidian/) > default
    OBS_REMOTE            Remote repository URL (wins over config/origin;
                          unset = asked by 'init', settable via 'remote <url>')
    OBS_BRANCH            Tracked branch (default: main)
    OBS_BACKUP_DIR        Backup directory (default: ~/obsidian-backups)
    OBS_KEEP_BACKUPS      Backups to retain (default: 10; 0 = keep all)
    OBS_LOG               Log file path (default: ~/ob-sync.log; empty = off)
    OBS_GIT_TIMEOUT       Network git timeout in seconds (default: 120; 0 = none)
    OBS_LOCAL_TIMEOUT     Local watchdog (tar/hashing/fsck) in seconds
                          (default: 600; 0 = none)
    OBS_NET_LOW_SPEED     HTTPS stall guard in bytes/s (default: 512; 0 = off)
    OBS_NET_LOW_TIME      Seconds below the speed limit before aborting
                          (default: 60)
    OBS_CRON_LOG          Output file for scheduled sync runs
                          (default: ~/ob-sync-cron.log)
    OBS_SKIP_BACKUP       Set to 1 to skip the pre-sync safety backup
    OBS_ATTACH_DIR        Destination folder for 'organize --fix' (default: Attachments)
    OB_DISCOVER_ROOTS     Colon-separated override of the folders the vault
                          switcher scans (default: ~/Documents ~/Obsidian
                          ~/vaults + the mountpoints /media, /run/media/<user>
                          and /mnt)

  VAULT IDENTITY
    <vault>/.ob-sync/config   The vault's own identity card (REMOTE, BRANCH).
                          Written by init/remote, committed with the vault,
                          and traveling to every clone — a new device is
                          ready to run without re-asking for the remote.
                          A lost 'origin' is restored from it, and on
                          disagreement the file (the copy that traveled
                          with the vault) wins over a stale local origin.
                          Device settings (pinned path, backups) stay in
                          OBS_CONFIG and never travel; credentials never
                          belong in this file.

  EXAMPLES
    ob-sync               Open the interactive menu
    ob-sync sync          Full sync from a script or cron job
    ob-sync remote https://github.com/you/vault.git    Point ob-sync at your repo
    ob-sync cron install hourly    Sync automatically, every hour
    ob-sync cron install daily 09:30    Or a raw 5-field cron expression
    ob-sync edit-conf              Tweak vault, remote & branch by hand
    ob-sync -y repair     Repair without the confirmation prompt
    ob-sync restore latest    Roll the vault back to the newest backup
    ob-sync restore --list latest    Preview a backup's contents first
    ob-sync restore --list --json    Machine-readable backup inventory
    ob-sync restore --json latest -y    Scripted restore: result as JSON
    ob-sync log --json    Machine-readable activity entries for automation
    ob-sync history --json    Machine-readable commit history for tooling
    ob-sync organize --json    Machine-readable vault audit (scan only)
    ob-sync organize --fix --json    Scripted cleanup with a moved-files report
    ob-sync sync --json    Machine-readable result — same shape for
                           pull/push/quick --json
    ob-sync backup --json    Machine-readable backup result (name, size,
                             sidecar state)
    ob-sync doctor --json    Machine-readable diagnostics for dashboards
    ob-sync verify --json    Machine-readable backup audit (per-archive rows)
    ob-sync health --json    Machine-readable repository integrity report
    ob-sync restore --dry-run <file>    Rehearse a restore, change nothing
    ob-sync status --json    Machine-readable status for scripts & dashboards
    ob-sync organize --fix    Move unreferenced attachments into Attachments/
    OBS_SKIP_BACKUP=1 ob-sync sync    Fast sync without the safety backup

  EXIT CODES
    0   success          1   operation failed          2   another instance running
EOF
}

cmd_version() {
    printf 'ob-sync %s — Obsidian Git Sync for Termux, Linux & macOS\n' "$VERSION"
    printf 'Author: Soroush Chegini · MIT License\n'
}


# ═════════════════════════════════════════════════════════════════════════
#  14b. SELF-UPDATE (9.6.0)
# ═════════════════════════════════════════════════════════════════════════

# The installed tool refreshes itself from the latest GitHub release.
# Design notes:
#   · ONE source of truth: the release asset itself
#     (releases/latest/download/ob-sync — no API, no rate limits).
#   · The download is validated (shebang, bash syntax, embedded VERSION)
#     before anything on disk is touched; the swap is an atomic
#     same-filesystem mv, so even a mid-update kill leaves either the
#     old or the new tool — never a broken one.
#   · Offline is a normal state, not an error: curl exit 6/7/28 (DNS,
#     refused, timeout) prints a bilingual notice and the run continues.
#   · A copy inside a git checkout is NEVER overwritten (that would
#     dirty the tree); it gets an advisory instead. ~/.local/bin style
#     installs are replaced in place.
#   · Automation stays silent and offline: the check only runs when
#     stdout is a TTY (or OB_FORCE_UPDATE_CHECK=1 / the explicit
#     `update` command). --json output is never polluted.
#   · Knobs: OB_NO_SELFUPDATE=1 kills the feature (CI/tests),
#     OB_UPDATE_URL overrides the release URL (tests use file://),
#     OB_UPDATE_CONNECT_TIMEOUT (default 3) and OB_UPDATE_MAX_TIME
#     (default 25) bound the curl calls.
ob_self_update_check() {
    # Once per process — the explicit `update` command re-enters through
    # dispatch() and must not download twice.
    [[ "${OB_SELFUPDATE_DONE:-0}" == "1" ]] && return 0
    OB_SELFUPDATE_DONE=1

    [[ "${OB_NO_SELFUPDATE:-0}" == "1" ]] && return 0

    local cmd="${1:-}" force=0
    case "$cmd" in update|self-update) force=1 ;; esac
    if (( ! force )); then
        # Cron, pipes and the suites stay silent AND offline; tests can
        # force the interactive path with OB_FORCE_UPDATE_CHECK=1.
        [[ "${OB_FORCE_UPDATE_CHECK:-0}" == "1" || -t 1 ]] || return 0
    fi
    # A --json run is a machine document — update chatter must never
    # touch its stdout, so such runs skip the check entirely.
    [[ " $* " == *" --json "* ]] && return 0

    command -v curl >/dev/null 2>&1 || {
        (( force )) && printf '[ob-sync] self-update needs curl — skipping\n' >&2
        return 0
    }

    local tmp
    tmp=$(mktemp "${TMPDIR:-/tmp}/ob-sync.update.XXXXXX") 2>/dev/null || return 0

    local rc=0
    curl -fsSL --connect-timeout "${OB_UPDATE_CONNECT_TIMEOUT:-3}" \
         --max-time "${OB_UPDATE_MAX_TIME:-25}" \
         -o "$tmp" \
         "${OB_UPDATE_URL:-https://github.com/CheginiSoroush/obsidian-sync-scripts/releases/latest/download/ob-sync}" || rc=$?

    if (( rc )); then
        rm -f "$tmp"
        case "$rc" in
            6|7|28)
                printf '[ob-sync] اینترنت خاموشه — network unreachable; running the current version (update check skipped)\n' >&2 ;;
            *)
                printf '[ob-sync] update check failed (curl rc=%s) — running the current version\n' "$rc" >&2 ;;
        esac
        return 0
    fi

    # Only a genuinely runnable ob-sync may replace the running one:
    # shebang, full bash syntax, embedded VERSION constant.
    local newver=""
    if [[ "$(head -n 1 "$tmp")" == '#!'* ]] \
       && bash -n "$tmp" 2>/dev/null \
       && newver=$(grep -m1 '^readonly VERSION=' "$tmp" 2>/dev/null | sed 's/^readonly VERSION="\([^"]*\)".*/\1/') \
       && [[ -n "$newver" ]]; then
        :
    else
        rm -f "$tmp"
        printf '[ob-sync] update check: the downloaded release is not a valid ob-sync script — keeping the current version\n' >&2
        return 0
    fi

    # Strictly-newer gate: never downgrade, never "update" to the same
    # version (a dev build carrying a higher VERSION wins either way).
    local oldest
    oldest=$(printf '%s\n%s\n' "$VERSION" "$newver" | sort -V | head -n 1)
    if [[ "$oldest" != "$VERSION" || "$VERSION" == "$newver" ]]; then
        rm -f "$tmp"
        { (( force )) || [[ -t 1 ]]; } \
            && printf '[ob-sync] v%s — up to date\n' "$VERSION" >&2
        return 0
    fi

    local target dir staged
    target=$(readlink -f -- "$0" 2>/dev/null) || target=$0
    [[ -n "$target" ]] || target=$0
    dir=$(dirname -- "$target")

    # Never dirty a git checkout — the file belongs to the repository,
    # the repository belongs to git pull / the apply scripts.
    if command -v git >/dev/null 2>&1 \
       && git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        rm -f "$tmp"
        printf '[ob-sync] v%s is available — this copy belongs to a git checkout; update the repository (git pull) instead\n' "$newver" >&2
        return 0
    fi

    if [[ ! -w "$dir" || ! -w "$target" ]]; then
        rm -f "$tmp"
        printf '[ob-sync] v%s is available — %s is not writable; update manually:\n' "$newver" "$target" >&2
        printf '  curl -fsSL -o %q https://github.com/CheginiSoroush/obsidian-sync-scripts/releases/latest/download/ob-sync && chmod +x %q\n' "$target" "$target" >&2
        return 0
    fi

    # Stage on the SAME filesystem, then one atomic mv: a kill at any
    # instant leaves either the old or the new tool, never a truncated
    # one. The staged file is validated above, so mv is the only
    # remaining way this can fail — and it fails loud, keeping the old
    # version.
    staged=$(mktemp "$dir/.ob-sync.new.XXXXXX") 2>/dev/null || {
        rm -f "$tmp"
        printf '[ob-sync] update check: cannot stage the new version in %s — keeping the current one\n' "$dir" >&2
        return 0
    }
    if ! cat -- "$tmp" > "$staged" || ! chmod 755 "$staged" || ! mv -f -- "$staged" "$target"; then
        rm -f "$staged" "$tmp"
        printf '[ob-sync] update check: install failed — keeping the current version\n' >&2
        return 0
    fi
    rm -f "$tmp"

    if (( force )); then
        printf '[ob-sync] updated v%s → v%s — done\n' "$VERSION" "$newver" >&2
        return 0
    fi
    # Launch path: hand control to the freshly installed code instead of
    # running the rest of this process on an outdated copy.
    printf '[ob-sync] updated v%s → v%s — restarting\n' "$VERSION" "$newver" >&2
    export OB_NO_SELFUPDATE=1
    exec "$target" "$@"
}


# ═════════════════════════════════════════════════════════════════════════════
#  15. DISPATCHER & ENTRY POINT
# ═════════════════════════════════════════════════════════════════════════════

require_git() {
    if command -v git >/dev/null 2>&1; then
        return 0
    fi
    error "git is not installed"
    warn "Install it with: $(install_hint)"
    return 1
}

require_vault() {
    [[ -d "$VAULT" ]] \
        || { error "Vault not found: $VAULT"; warn "Initialize with: ob-sync init"; return 1; }
    return 0
}

##
# Environment sanity pass: verify required tools and resolve the vault to
# an absolute physical path (a relative OBS_VAULT would make git -C
# depend on the current working directory — a real footgun).
##
setup() {
    local -a missing=()
    local dep
    local -a deps=(git tar find grep sort cut tr wc tail head mktemp du xargs dirname date awk sed)
    for dep in "${deps[@]}"; do
        command -v "$dep" >/dev/null 2>&1 || missing+=("$dep")
    done
    # One hashing tool is enough — GNU sha256sum or BSD/macOS shasum.
    command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1 \
        || missing+=("sha256sum|shasum")
    if (( ${#missing[@]} > 0 )); then
        error "Missing required commands: ${missing[*]}"
        warn "Install with: $(install_hint)"
        return 1
    fi

    # Config-file fallbacks (environment always wins) — keeps cron and
    # non-login shells consistent with interactive ones.
    load_config_overrides

    resolve_vault || return 1

    local resolved
    if resolved=$(cd "$VAULT" 2>/dev/null && pwd -P); then
        VAULT="$resolved"
    fi
    return 0
}

##
# Route a command to its implementation. Shared by the CLI and the menu,
# so validation and locking behave identically everywhere.
#
# Information commands (status/health) guard themselves and degrade
# gracefully; mutating commands are validated here and serialized through
# the lock.
##
dispatch() {
    local cmd="${1:-}"
    (( $# )) && shift

    case "$cmd" in
        # Read-only commands — no lock required.
        help)         cmd_help ;;
        version)      cmd_version ;;
        doctor)       cmd_doctor "$@" ;;
        verify)       cmd_verify "$@" ;;
        log)          cmd_log "$@" ;;
        status)       cmd_status "$@" ;;
        health)       cmd_health "$@" ;;
        menu)         main_menu ;;
        config)       cmd_config ;;
        cron)         cmd_cron "$@" ;;
        edit-conf)    cmd_edit_conf ;;
        update|self-update) ob_self_update_check update ;;
        diff)         require_git && require_vault && cmd_diff ;;
        history)      require_git && require_vault && cmd_history "$@" ;;

        # Mutating commands — serialized through the lock. The data
        # operations (sync/pull/push/quick) validate their own environment
        # (inside their wrappers) so --json always answers with a document.
        sync)         with_lock cmd_sync "$@" ;;
        pull)         with_lock cmd_pull "$@" ;;
        push)         with_lock cmd_push "$@" ;;
        quick)        with_lock cmd_quick "$@" ;;
        backup)       with_lock cmd_backup "$@" ;;
        restore)
            # Read-only preview flows (--list / --dry-run) need no lock;
            # anything else is a destructive apply — serialized, whether
            # or not --json was passed (9.1.0: apply-mode --json used to
            # slip past this routing and bypass the PID lock). The scan
            # stops at a "--" separator — everything after it is a
            # POSITIONAL target, so `restore -- --list` (a backup
            # literally named "--list") routes to the locked apply flow
            # instead of the lock-free preview (9.2.1).
            local r_locked=1 r_arg
            for r_arg in "$@"; do
                [[ "$r_arg" == "--" ]] && break
                case "$r_arg" in
                    --list|--dry-run) r_locked=0 ;;
                esac
            done
            if (( r_locked )); then with_lock cmd_restore "$@"
                           else       cmd_restore "$@" ; fi ;;
        repair)       require_git && require_vault && with_lock cmd_repair "$@" ;;
        organize)
            require_vault || return 1
            # Scan-only organize (no --fix) is a pure read — same policy
            # as restore --list: it neither mutates the vault nor needs
            # the lock, so a report can be produced even while a sync
            # holds it. organize --fix is destructive and always
            # serialized through the lock. A "--fix" after a "--"
            # separator is a positional (and organize accepts none), so
            # the scan stops at "--" (9.2.1).
            local o_fix=0 o_arg
            for o_arg in "$@"; do
                [[ "$o_arg" == "--" ]] && break
                [[ "$o_arg" == "--fix" ]] && o_fix=1
            done
            if (( o_fix )); then with_lock cmd_organize "$@"
                         else       cmd_organize "$@" ; fi ;;
        init)         require_git && with_lock cmd_init ;;
        remote)       with_lock cmd_remote "$@" ;;

        *)            error "Unknown command: $cmd"; echo; cmd_help; return 1 ;;
    esac
}

main() {
    # ---- global options (must precede the command) ---------------------
    while (( $# > 0 )); do
        case "$1" in
            -n|--no-color) export NO_COLOR=1; shift ;;
            -y|--yes)      ASSUME_YES=1;      shift ;;
            -h|--help)     shift; init_colors; cmd_help;    return 0 ;;
            -v|--version)  shift; init_colors; cmd_version; return 0 ;;
            --)            shift; break ;;
            -*)            init_colors; error "Unknown option: $1"; echo; cmd_help; return 1 ;;
            *)             break ;;
        esac
    done

    init_colors
    # Self-update on launch (9.6.0): an interactive run refreshes the
    # installed tool from the latest release BEFORE it starts working;
    # an offline machine gets a bilingual notice and continues with what
    # it has. Runs once per process (sentinel inside) — the explicit
    # `update` command re-enters through dispatch() without a second
    # download, and the help/version short-circuits above stay instant.
    ob_self_update_check "$@"
    # `log` reads the activity log itself: creating (init_log) or
    # stamping (the invoked row below) it here would answer a fresh
    # machine with ob-sync's own self-row instead of the documented
    # null document — and a >1MiB log would be rotated to .1 BEFORE the
    # reader ever saw it (one junk row instead of the real entries).
    [[ "${1:-}" == "log" ]] || init_log

    # Global signal handlers. on_exit is a no-op unless this instance
    # actually owns the lock or registered temporaries.
    trap on_exit EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    # No arguments: launch the interactive menu when attached to a
    # terminal, or run a full sync when invoked non-interactively
    # (cron, Tasker, SSH one-shots).
    if (( $# == 0 )); then
        if [[ -t 0 && -t 1 ]]; then
            setup || return 1
            main_menu
            return 0
        fi
        set -- sync
    fi

    local cmd="$1"
    shift

    # See the init_log note above: `log` must observe the file, not
    # write to it first.
    [[ "$cmd" == "log" ]] || log "invoked: $cmd ${*:-}"

    # The machine-readable modes (status/restore/doctor/backup/verify/health
    # and the four data operations with --json) must emit ONLY the JSON
    # document on stdout: suppress the user-facing info/warn lines (vault
    # auto-detection, stale-lock notices, ...) and the progress UI that
    # setup() and helpers would otherwise print there.
    case "$cmd" in
        sync|pull|push|quick|status|restore|doctor|backup|verify|health|log|history|organize)
            [[ " $* " == *" --json "* ]] && SILENT_UI=1 ;;
    esac

    # help/version/doctor report on a broken environment instead of
    # failing inside it. cron manages the system crontab and edit-conf
    # only opens a file — neither needs a resolved vault — so they skip
    # the sanity pass too.
    case "$cmd" in
        help|version|doctor|cron|edit-conf|update|self-update) ;;
        *) setup || return 1 ;;
    esac

    dispatch "$cmd" "$@"
}

main "$@"
