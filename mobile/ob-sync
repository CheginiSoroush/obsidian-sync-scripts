#!/bin/bash

# ═══════════════════════════════════════════
# اسکریپت Sync Obsidian برای موبایل (Termux)
# ═══════════════════════════════════════════

VAULT="$HOME/storage/shared/Documents/Soroush"

# رنگ‌ها
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# بررسی Vault
if [ ! -d "$VAULT" ]; then
    echo -e "${RED}❌ Vault پیدا نشد: $VAULT${NC}"
    echo "محتویات Documents:"
    ls ~/storage/shared/Documents/
    exit 1
fi

# راهنما
show_help() {
    echo -e "${BLUE}📖 راهنمای ob-sync:${NC}"
    echo ""
    echo "  ob-sync          - Sync کامل (Pull + Push)"
    echo "  ob-sync pull     - فقط دریافت از GitHub"
    echo "  ob-sync push     - فقط ارسال به GitHub"
    echo "  ob-sync status   - نمایش وضعیت"
    echo "  ob-sync help     - نمایش این راهنما"
    echo ""
    echo -e "${YELLOW}⚠️ نکته: همیشه قبل از نوشتن pull بزنید!${NC}"
}

# Pull ایمن
safe_pull() {
    cd "$VAULT"
    
    echo -e "${BLUE}🔄 بررسی تغییرات...${NC}"
    
    # ذخیره تغییرات local اگر وجود دارد
    if [ -n "$(git status --porcelain)" ]; then
        echo -e "${YELLOW}📝 ذخیره تغییرات local...${NC}"
        git add .
        git commit -m "📱 Mobile auto-save: $(date)"
    fi
    
    # Pull با Rebase
    echo -e "${BLUE}📥 Pull از GitHub...${NC}"
    if git pull --rebase origin main; then
        echo -e "${GREEN}✅ Pull موفقیت‌آمیز بود${NC}"
    else
        echo -e "${RED}❌ Conflict رخ داد!${NC}"
        echo -e "${YELLOW}برای حل conflict:${NC}"
        echo "1. فایل‌های conflict دار را ویرایش کنید"
        echo "2. علامت‌های <<<<<<<, =======, >>>>>>> را حذف کنید"
        echo "3. دوباره ob-sync push را اجرا کنید"
        return 1
    fi
}

# Push ایمن
safe_push() {
    cd "$VAULT"
    
    # Commit اگر تغییرات هست
    if [ -n "$(git status --porcelain)" ]; then
        echo -e "${YELLOW}📝 Commit تغییرات...${NC}"
        git add .
        git commit -m "📱 Mobile sync: $(date)"
    fi
    
    # Push
    echo -e "${BLUE}📤 Push به GitHub...${NC}"
    if git push origin main; then
        echo -e "${GREEN}✅ Push موفقیت‌آمیز بود${NC}"
    else
        echo -e "${RED}❌ Push ناموفق!${NC}"
        echo -e "${YELLOW}برای رفع: ob-sync pull${NC}"
        return 1
    fi
}

# نمایش وضعیت
show_status() {
    cd "$VAULT"
    echo -e "${BLUE}📊 وضعیت Vault:${NC}"
    echo "مسیر: $VAULT"
    echo "Branch: $(git branch --show-current)"
    echo "فایل‌های تغییر کرده: $(git status --porcelain | wc -l)"
    echo "آخرین Commit: $(git log -1 --oneline)"
    echo ""
    echo -e "${BLUE}🔗 Remote:${NC}"
    git remote -v
}

# Sync کامل
sync_all() {
    safe_pull
    if [ $? -eq 0 ]; then
        safe_push
    fi
}

# ═══════════════════════════════════════════
# اجرای اصلی
# ═══════════════════════════════════════════

case "$1" in
    ""|"sync")
        sync_all
        ;;
    "pull")
        safe_pull
        ;;
    "push")
        safe_push
        ;;
    "status")
        show_status
        ;;
    "help"|"--help"|"-h")
        show_help
        ;;
    *)
        echo -e "${RED}❌ دستور ناشناخته: $1${NC}"
        show_help
        exit 1
        ;;
esac
