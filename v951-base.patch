+##
+# Normalize a raw value read from a KEY=VALUE line. Hand-edited files are
+# a fact of life: Windows/Android editors leave CRLF endings behind, users
+# copy values wrapped in quotes out of tutorials, and stray outer spaces
+# sneak in. One layer of matched wrapping quotes, trailing CRs and outer
+# whitespace are stripped — what survives is the value ob-sync actually
+# uses (config_set never writes any of these, so nothing legitimate is
+# lost). Field-reported 9.5.0: a CRLF-edited identity card corrupted
+# 'origin' with an invisible CR and every fetch died on a phantom URL.
+##
+conf_value_clean() {
+    local val="$1"
+    val=${val%$'\r'}
+    # trim outer whitespace (the standard non-greedy trim idiom)
+    val=${val#"${val%%[![:space:]]*}"}
+    val=${val%"${val##*[![:space:]]}"}
+    if [[ ${#val} -ge 2 ]]; then
+        local q=${val:0:1}
+        if [[ ( "$q" == '"' || "$q" == "'" ) && "${val: -1}" == "$q" ]]; then
+            val=${val:1:${#val}-2}
+        fi
+    fi
+    printf '%s\n' "$val"
+}
+
 ##
 # Read a KEY=VALUE pair from the config file.
+# The file must be a REGULAR file — a directory (a mkdir typo) or a FIFO
+# would otherwise fail noisily or block on open (read error spam, 9.5.0).
 # @param $1 key
 # @stdout value when present; @return 1 when file or key is absent
 ##
 config_get() {
-    [[ -r "$CONFIG_FILE" ]] || return 1
+    [[ -r "$CONFIG_FILE" && -f "$CONFIG_FILE" ]] || return 1
     local key="$1" line
     while IFS= read -r line; do
         case "$line" in
             ''|'#'*) continue ;;
-            "$key="*) printf '%s\n' "${line#"$key="}"; return 0 ;;
+            "$key="*) conf_value_clean "${line#"$key="}"; return 0 ;;
         esac
     done < "$CONFIG_FILE"
     return 1
@@ -748,12 +775,12 @@ vault_conf_path() {
 vault_conf_get() {
     local f
     f=$(vault_conf_path)
-    [[ -r "$f" ]] || return 1
+    [[ -r "$f" && -f "$f" ]] || return 1
     local key="$1" line
     while IFS= read -r line; do
         case "$line" in
             ''|'#'*) continue ;;
-            "$key="*) printf '%s\n' "${line#"$key="}"; return 0 ;;
+            "$key="*) conf_value_clean "${line#"$key="}"; return 0 ;;
