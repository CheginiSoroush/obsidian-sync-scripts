@@ -1957,6 +1984,19 @@ clean_repair_artifacts() {
 ##
 ensure_safe() {
     clean_repair_artifacts
+    if [[ ! -d "$VAULT/.git" ]]; then
+        # A vault with no .git is not an "unsafe repository" — there is no
+        # repository here at all. Diagnose it honestly (the generic
+        # not-in-a-safe-state message misled users into thinking their
+        # data was the problem) and point at the two real roads back:
